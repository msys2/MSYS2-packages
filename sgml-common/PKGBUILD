# $Id$
# Maintainer: J. Peter Mugaas <jpmugaas@suddenlink.net>
# shamelessly stolen from Archlinux
pkgname='sgml-common'
pkgver=0.6.3
pkgrel=3
pkgdesc='Tools for maintaining centralized SGML catalogs.'
arch=('any')
url='https://www.docbook.org/xml/'
msys2_references=(
  "anitya: 227355"
)
license=('spdx:GPL-2.0-or-later')
install='sgml-common.install'
depends=('sh')
makedepends=('autotools')
source=("https://ftp.osuosl.org/pub/blfs/conglomeration/sgml-common/sgml-common-${pkgver}.tgz"
        'sgml-common-0.6.3-manpage-1.patch')
noextract=("sgml-common-${pkgver}.tgz")
sha256sums=('7dc418c1d361123ffc5e45d61f1b97257940a8eb35d0bfbbc493381cc5b1f959'
            '50d93af704a0869faf8fedf5d23b1a9f90fff6499f4c11cf4addb5e460b7b58b')

prepare() {
  # work around an issue with symbolic links in the tarball.
  bsdtar zxvf $srcdir/sgml-common-${pkgver}.tgz || true
  cd "${srcdir}"/${pkgname}-${pkgver}
  # The symbolic links themselves were simply linking files from /usr/share/automake to the dist folder.
  cp /usr/share/automake-1.18/install-sh .
  cp /usr/share/automake-1.18/mkinstalldirs .
  cp /usr/share/automake-1.18/missing .
  cp /usr/share/automake-1.18/INSTALL .
  cp /usr/share/automake-1.18/COPYING .
  patch -Np1 -i ../sgml-common-0.6.3-manpage-1.patch

  WANT_AUTOCONF=latest autoreconf -vfi
}

build() {
  cd "${srcdir}"/${pkgname}-${pkgver}
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}
package(){
  cd "${srcdir}"/${pkgname}-${pkgver}
  make DESTDIR="$pkgdir" docdir=/usr/share/doc install
}
