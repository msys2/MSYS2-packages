From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aswin-mcw <aswin.kalies@multicorewareinc.com>
Date: Wed, 9 Sep 2026 13:15:11 +0530
Subject: [PATCH 082/109] ci: repoint remaining actions to public
 upstreams

(cherry picked from commit b52a1a7634141b9becf39836d86f78f1dfb62820)
---
 .github/arm64/README.md      |  7 +++----
 .github/workflows/build.yaml | 12 ++++--------
 .github/workflows/cygwin.yml |  3 +--
 3 files changed, 8 insertions(+), 14 deletions(-)

diff --git a/.github/arm64/README.md b/.github/arm64/README.md
index f901723ef..bb23c70a4 100644
--- a/.github/arm64/README.md
+++ b/.github/arm64/README.md
@@ -30,10 +30,9 @@ Actions):
    `arm64_runner` workflow_dispatch input with a self-hosted label.
 
 Notes:
-- `toolchain.yml` and `cygwin.yml` use the public **`msys2/setup-msys2@v2`**
-  action (the old `qcom-eng-691` fork existed only for an internal enterprise
-  policy that does not apply here). `build.yaml` (the x86_64 path) still
-  references the `qcom-eng-691` forks and can be repointed the same way when needed.
+- All workflows use the public upstream actions (`msys2/setup-msys2`,
+  `msys2/msys2-tests`, `cygwin/cygwin-install-action`); the old internal forks
+  existed only for an enterprise-actions policy that does not apply on this account.
 - The old `msys2-woarm64-build` driver is no longer cloned — the only pieces the
   build used from it (the pthread-header hack scripts) are vendored under
   `.github/arm64/scripts/`.
diff --git a/.github/workflows/build.yaml b/.github/workflows/build.yaml
index adf632f76..3b2de7352 100644
--- a/.github/workflows/build.yaml
+++ b/.github/workflows/build.yaml
@@ -14,8 +14,7 @@ jobs:
         uses: actions/checkout@v7
 
       - name: setup-msys2
-        # org fork of msys2/setup-msys2 (enterprise policy blocks external actions)
-        uses: qcom-eng-691/setup-msys2@v2
+        uses: msys2/setup-msys2@v2
         with:
           msystem: MSYS
           update: true
@@ -56,8 +55,7 @@ jobs:
       matrix: ${{ steps.matrix.outputs.matrix }}
     steps:
       - id: matrix
-        # org fork of msys2/msys2-tests (enterprise policy blocks external actions)
-        uses: qcom-eng-691/msys2-tests/gha-matrix-gen@main
+        uses: msys2/msys2-tests/gha-matrix-gen@main
 
   msys2-tests:
     needs: [build, generate-msys2-tests-matrix]
@@ -74,8 +72,7 @@ jobs:
       FC: ${{ matrix.fc }}
     steps:
       - id: msys2
-        # org fork of msys2/setup-msys2 (enterprise policy blocks external actions)
-        uses: qcom-eng-691/setup-msys2@v2
+        uses: msys2/setup-msys2@v2
         with:
           msystem: ${{ matrix.msystem }}
           update: true
@@ -105,5 +102,4 @@ jobs:
         run: uname -a
 
       - name: Run tests
-        # org fork of msys2/msys2-tests (enterprise policy blocks external actions)
-        uses: qcom-eng-691/msys2-tests@main
+        uses: msys2/msys2-tests@main
diff --git a/.github/workflows/cygwin.yml b/.github/workflows/cygwin.yml
index fb4949112..4094398b7 100644
--- a/.github/workflows/cygwin.yml
+++ b/.github/workflows/cygwin.yml
@@ -129,8 +129,7 @@ jobs:
 
     # install cygwin and build tools
     - name: Install Cygwin
-      # org fork of cygwin/cygwin-install-action (enterprise policy blocks external actions)
-      uses: qcom-eng-691/cygwin-install-action@master
+      uses: cygwin/cygwin-install-action@master
       with:
         platform: ${{ matrix.pkgarch }}
         packages: >-
