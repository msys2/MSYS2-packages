From: =?UTF-8?q?Radek=20Barto=C5=88?= <radek.barton@microsoft.com>
Date: Mon, 4 Nov 2024 14:47:51 +0100
Subject: [PATCH 12/29] Allow some warnings when building libgcc (#36)

(cherry picked from commit 58d3901b57dac57b500b16e232ee33e93fd4c836)
---
 libgcc/config/aarch64/t-aarch64 | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libgcc/config/aarch64/t-aarch64 b/libgcc/config/aarch64/t-aarch64
index e1391651466..51f8603a73f 100644
--- a/libgcc/config/aarch64/t-aarch64
+++ b/libgcc/config/aarch64/t-aarch64
@@ -34,4 +34,5 @@ LIB2ADDEH += \
 	$(srcdir)/config/aarch64/__arm_sc_memset_scalar.S
 
 SHLIB_MAPFILES += $(srcdir)/config/aarch64/libgcc-sme.ver
-LIBGCC2_CFLAGS += $(WERROR) -Wno-prio-ctor-dtor
+LIBGCC2_CFLAGS += $(WERROR) -Wno-prio-ctor-dtor -Wno-error=attributes -Wno-error=unused-parameter \
+	-Wno-error=missing-prototypes -Wno-error=unused-function
