  woarm64-0022-0101-Cygwin-enable-libgccjit-not-just-for-MingW.patc.patch
  woarm64-0023-0102-Cygwin-testsuite-fixes-for-libgccjit.patch.patch
  woarm64-0024-Add-aarch64-pc-cygwin-target.patch
  woarm64-0025-Add-support-for-shared-attribute-41.patch
  woarm64-0026-mingw-use-mingw_pe_seh_emit_stackalloc-in-seh_patter.patch
  woarm64-0027-aarch64-build-aarch64-abi-ms.o-for-the-cygwin-target.patch
  woarm64-0028-libgcc-do-not-build-soft-fp-for-aarch64-pc-cygwin.patch
  woarm64-0029-aarch64-mingw-emit-d-form-register-names-for-.seh_sa.patch
  0012-Handle-spaces-in-path-for-default-manifest.patch
