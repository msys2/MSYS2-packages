# Maintainer: Windows on ARM Experiments

_realname=gcc
_target=aarch64-pc-cygwin
pkgname="cross-msysarm64-${_realname}"
pkgver=17.0.0
pkgrel=1
pkgdesc="Cross GCC stage2 for aarch64-pc-cygwin (with full runtime)"
arch=('i686' 'x86_64')
url="https://gcc.gnu.org"
license=('GPL' 'LGPL' 'FDL')
depends=("zlib" "mpc" "isl" "libzstd")
makedepends=(
  "gcc"
  "lndir"
  "gmp-devel"
  "mpc-devel"
  "zlib-devel"
  "isl-devel"
  "autotools"
  "gperf"
  "libzstd-devel"
  "cross-msysarm64-binutils"
  "cross-msysarm64-gcc-stage1"      # stage1 compiler
  "cross-msysarm64-runtime-stage1"  # ordering only: build() reads libmsys-2.0.a
                                    # and newlib libc.a/libm.a straight out of
                                    # ../msys2-runtime-aarch64/src, so that
                                    # package has to be built first.  Without
                                    # this CI ordered gcc before it and failed
                                    # with "stage-1 runtime artifact missing".
  "cross-msysarm64-runtime-devel"   # real msys2-runtime headers + libcygwin.a
  "cross-msysarm64-w32api-headers"
  "cross-msysarm64-windows-default-manifest"  # default-manifest.o.  The target
                                    # link spec references it, so every
                                    # configure-target-* link test needs it:
                                    #   ld: cannot find default-manifest.o
  "cross-msysarm64-w32api-runtime"  # Win32 import libs (libkernel32/user32/
                                    # advapi32/shell32/ntdll.a).  The target
                                    # libs configure link-tests against them, so
                                    # without this configure-target-libatomic
                                    # fails with "C compiler cannot create
                                    # executables".
  "git"
)
options=('!strip' 'staticlibs' '!emptydirs' '!buildflags')
_upstream_commit=001f9af67f1adad05abcf9b3e83ecee163fa0f13
source=(
  # Upstream GCC, pinned to the commit our AArch64 series is based on.
  # Our changes are the woarm64-*.patch series below, generated from
  # gcc-woarm64 aarch64-on-latest with  git format-patch 001f9af67f1..HEAD
  "${_realname}::git+https://gcc.gnu.org/git/gcc.git#commit=${_upstream_commit}"
  woarm64-0001-aarch64-Bypass-some-warnings-in-MinGW.patch
  woarm64-0002-aarch64-Add-stdcall-and-cdecl-attributes.patch
  woarm64-0003-aarch64-Add-SEH-stack-unwinding-and-C-exceptions.patch
  woarm64-0004-Support-SEH-for-fragmented-functions.patch
  woarm64-0005-Fix-unwiding-code-for-a-floating-point-register-pair.patch
  woarm64-0006-Fix-unwiding-codes-when-stack-probing-is-applied.patch
  woarm64-0007-Rebase-woarm64-aarch64-pe-target-prototype.patch
