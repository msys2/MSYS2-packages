# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

pkgname=ncdu
pkgver=1.24.1
pkgrel=1
pkgdesc='Disk usage analyzer with an ncurses interface.'
arch=('i686' 'x86_64')
url='https://github.com/BratishkaErik/ncdu'
msys2_repository_url='https://github.com/BratishkaErik/ncdu'
msys2_changelog_url='https://github.com/BratishkaErik/ncdu/releases'
msys2_references=(
  'anitya: 6045'
)
license=('spdx:MIT')
depends=('ncurses')
makedepends=(
  'gcc'
  'ncurses-devel'
  'pkgconf'
)
source=("https://github.com/BratishkaErik/${pkgname}/releases/download/v${pkgver}/${pkgname}-${pkgver}-src.tar.gz")
sha256sums=('23f7f5b2139a5529ffa01c078f623f4077379b334328129c91530ec5089ac420')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
