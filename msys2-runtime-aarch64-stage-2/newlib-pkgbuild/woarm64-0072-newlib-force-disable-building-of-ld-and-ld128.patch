From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aswin-mcw <aswin.kalies@multicorewareinc.com>
Date: Wed, 9 Sep 2026 13:14:56 +0530
Subject: [PATCH 072/109] newlib : force disable building of ld and ld128

(cherry picked from commit eea5778d9e0a4e359dbc7760dc426c7cd96d2010)
---
 newlib/libm/ld/Makefile.inc    | 2 +-
 newlib/libm/ld128/Makefile.inc | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/newlib/libm/ld/Makefile.inc b/newlib/libm/ld/Makefile.inc
index fef3db4a6..bcdbc30cc 100644
--- a/newlib/libm/ld/Makefile.inc
+++ b/newlib/libm/ld/Makefile.inc
@@ -47,7 +47,7 @@
 
 libm_a_CFLAGS_%C% = -fbuiltin -fno-math-errno
 
-if HAVE_LONG_DOUBLE
+if FALSE
 libm_a_SOURCES += $(%C%_lsrc)
 endif # HAVE_LONG_DOUBLE
 
diff --git a/newlib/libm/ld128/Makefile.inc b/newlib/libm/ld128/Makefile.inc
index 3a04b99a1..9b85bfb94 100644
--- a/newlib/libm/ld128/Makefile.inc
+++ b/newlib/libm/ld128/Makefile.inc
@@ -6,7 +6,7 @@
 
 libm_a_CFLAGS_%C% = -fbuiltin -fno-math-errno
 
-if HAVE_LONG_DOUBLE
+if FALSE
 libm_a_SOURCES += $(%C%_lsrc)
 endif # HAVE_LONG_DOUBLE
 
