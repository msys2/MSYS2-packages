From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aswin-mcw <aswin.kalies@multicorewareinc.com>
Date: Wed, 9 Sep 2026 13:13:53 +0530
Subject: [PATCH 019/109] Cygwin: define OUTPUT_FORMAT and SEARCH_DIR for
 AArch64

(cherry picked from commit 8fd7ed387339d58f9b4465e967cb1a6a7a8cd80e)
---
 winsup/cygwin/cygwin.sc.in | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/winsup/cygwin/cygwin.sc.in b/winsup/cygwin/cygwin.sc.in
index 63fa629de..d5191f012 100644
--- a/winsup/cygwin/cygwin.sc.in
+++ b/winsup/cygwin/cygwin.sc.in
@@ -1,5 +1,7 @@
 #ifdef __x86_64__
 OUTPUT_FORMAT(pei-x86-64)
+#elif __aarch64__
+OUTPUT_FORMAT(pei-aarch64-little)
 # ifdef __MSYS__
 SEARCH_DIR("/usr/x86_64-pc-msys/lib/w32api"); SEARCH_DIR("=/usr/lib/w32api");
 # else
@@ -8,6 +10,7 @@ SEARCH_DIR("/usr/x86_64-pc-cygwin/lib/w32api"); SEARCH_DIR("=/usr/lib/w32api");
 #else
 #error unimplemented for this target
 #endif
+SEARCH_DIR("=/usr/lib/w32api")
 #define __CONCAT1(a,b)	a##b
 #define __CONCAT(a,b) __CONCAT1(a,b)
 #define _SYM(x)	__CONCAT(__USER_LABEL_PREFIX__, x)
