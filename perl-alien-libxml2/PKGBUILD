# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Alien-Libxml2'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.20
pkgrel=2
pkgdesc="Install the C libxml2 library on your system"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Alien-Libxml2"
msys2_references=(
  'purl: pkg:cpan/PLICEASE/Alien-Libxml2'
)
groups=('perl-modules')
depends=('libxml2' 'perl-alien-build>=2.37')
makedepends=('perl-html-parser' 'perl-sort-versions' 'perl-test2-suite' 'perl-uri' 'libxml2-devel'
             'perl-alien-build-plugin-download-gitlab' 'pkgconf')
provides=("perl-Alien-Libxml2=${pkgver}")
conflicts=('perl-Alien-Libxml2')
replaces=('perl-Alien-Libxml2')
options=(!emptydirs)
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('56aae7b339bbeb02f77c5801f57a821be5791b51f43bf7f9062bb3bfa444c328')

prepare() {
  cd ${srcdir}/${_perlname}-${pkgver}
}

build() {
  cd ${srcdir}/${_perlname}-${pkgver}

  # install module in vendor directories.
  perl Makefile.PL -- INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${srcdir}/${_perlname}-${pkgver}

  make install DESTDIR=${pkgdir}
  # Remove .packlist and perllocal.pod files.
  find "$pkgdir" -name '.packlist' -delete
  find "$pkgdir" -name 'perllocal.pod' -delete
}
