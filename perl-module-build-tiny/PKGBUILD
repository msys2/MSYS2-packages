# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Module-Build-Tiny'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.053
pkgrel=2
pkgdesc="A tiny replacement for Module::Build"
arch=('any')
url="https://metacpan.org/dist/Module-Build-Tiny"
msys2_references=(
  'purl: pkg:cpan/LEONT/Module-Build-Tiny'
)
groups=('perl-modules')
license=('spdx:GPL-1.0-or-later' 'spdx:Artistic-1.0-Perl')
depends=('perl' 'perl-extutils-config' 'perl-extutils-helpers' 'perl-extutils-installpaths')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/L/LE/LEONT/${_perlname}-${pkgver}.tar.gz")
sha256sums=('3726d622da6f655e88fdf89e4fd597709c44970b47de65082003e8d86b5e193a')

build() {
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""                 \
      PERL_AUTOINSTALL=--skipdeps                            \
      PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'"     \
      PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
      MODULEBUILDRC=/dev/null

    cd "${srcdir}/${_perlname}-${pkgver}"
    /usr/bin/perl Build.PL
    ./Build
  )
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""
    ./Build test
  )
}

package() {
  cd ${_perlname}-${pkgver}
  ( export PERL_AUTOINSTALL=--skipdeps                       \
      PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'"     \
      PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'"
    ./Build install
  )
  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}
