# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Digest-HMAC'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.05
pkgrel=2
pkgdesc="Perl Module: Keyed-Hashing for Message Authentication."
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Digest-HMAC"
msys2_references=(
  'purl: pkg:cpan/ARODLAND/Digest-HMAC'
)
groups=('perl-modules')
depends=('perl>=5.10.0') # 'perl-digest-sha1' in perl core now
options=(!emptydirs)
provides=(
  'Digest-HMAC'
  "perl-Digest-HMAC=${pkgver}"
)
conflicts=('perl-Digest-HMAC')
replaces=(
  'Digest-HMAC'
  'perl-Digest-HMAC'
)
source=("https://cpan.metacpan.org/authors/id/A/AR/ARODLAND/${_perlname}-${pkgver}.tar.gz")
sha256sums=('215cb59cba610745cfb2d4b3f8ef756d590e57e3ad7986a992e87c4969fcdc7a')

build() {
  cd ${srcdir}/${_perlname}-${pkgver}
  # install module in vendor directories.
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${srcdir}/${_perlname}-${pkgver}
  make test
}

package() {
  cd ${srcdir}/${_perlname}-${pkgver}
  make install DESTDIR=${pkgdir}
}
