pkgbase=bash
pkgname=('bash' 'bash-devel' 'bash-testsuite')
_basever=5.3
_patchlevel=015 #prepare for some patches
pkgver=${_basever}.${_patchlevel}
pkgrel=1
pkgdesc="The GNU Bourne Again shell"
arch=('i686' 'x86_64' 'aarch64')
license=('spdx:GPL-3.0-or-later')
url="https://www.gnu.org/software/bash/bash.html"
msys2_repository_url="https://cgit.git.savannah.gnu.org/cgit/bash.git"
msys2_references=(
  "cpe: cpe:/a:gnu:bash"
)
validpgpkeys=('7C0135FB088AAF6C66C650B9BB5869F064EA74AB') # Chet Ramey
makedepends=('gettext-devel' 'libreadline-devel>=7.0' 'ncurses-devel' 'autotools' 'gcc')
source=(https://mirrors.kernel.org/gnu/bash/bash-${_basever}.tar.gz{,.sig}
        0001-bash-4.4-cygwin.patch
        0002-bash-4.3-msysize.patch
        0005-bash-4.3-msys2-fix-lineendings.patch
        0006-bash-4.3-add-pwd-W-option.patch
        0007-fix-static-build.patch)
if [ $_patchlevel -gt 000 ]; then
  for (( p=1; p<=$((10#${_patchlevel})); p++ )); do
    source=(${source[@]} https://mirrors.kernel.org/gnu/bash/bash-${_basever}-patches/bash${_basever//./}-$(printf "%03d" $p){,.sig})
  done
fi
noextract=(${pkgbase}-${_basever}.tar.gz)
validpgpkeys=('7C0135FB088AAF6C66C650B9BB5869F064EA74AB') # Chet Ramey

prepare() {
  [[ -d ${pkgbase}-${_basever} ]] && rm -rf ${pkgbase}-${_basever}
  tar -xzvf ${srcdir}/${pkgbase}-${_basever}.tar.gz || true
  cd ${srcdir}/${pkgname}-${_basever}

  for (( p=1; p<=$((10#${_patchlevel})); p++ )); do
    msg "applying patch bash${_basever//./}-$(printf "%03d" $p)"
    patch -p0 -i $srcdir/bash${_basever//./}-$(printf "%03d" $p)
  done

  patch -p1 -i ${srcdir}/0001-bash-4.4-cygwin.patch
  patch -p1 -i ${srcdir}/0002-bash-4.3-msysize.patch
  patch -p1 -i ${srcdir}/0005-bash-4.3-msys2-fix-lineendings.patch
  patch -p1 -i ${srcdir}/0006-bash-4.3-add-pwd-W-option.patch
  patch -p1 -i ${srcdir}/0007-fix-static-build.patch

  # environ is a DATA symbol exported by msys-2.0.dll.  A bare
  #   extern char **environ;
  # makes ld fall back to auto-import, and on AArch64 that pseudo-relocation is
  # never applied: bash.exe ends up with 8 __fu*_environ thunks writing to a
  # LOCAL copy.  bash keeps the C library environment in sync with
  #   environ = export_env;      (variables.c)
  # so with a broken auto-import the runtime never sees the new environment --
  # "export TZ=..." has no effect on printf %()T in the same process, while a
  # spawned child still works (export_env goes to execve directly).  That is
  # the run-printf failure.  dllimport routes the assignment through
  # __imp_environ, i.e. the DLL's real variable.
  # support/printenv.c needs it for the same reason: it is one of the four
  # testsuite helpers, and with auto-import it reads a bogus address, prints
  # nothing and exits 1 -- silently costing the appendop, func, nameref and
  # varenv groups, with no error anywhere pointing at printenv.
  for _f in shell.c variables.c support/printenv.c; do
    sed -i "s/^extern char \*\*environ;/__declspec(dllimport) extern char **environ;/" "${_f}"
  done
  if ! grep -q "dllimport) extern char " variables.c ||
     ! grep -q "dllimport) extern char " support/printenv.c; then
    echo "FATAL: environ dllimport patch did not apply" >&2
    return 1
  fi
  echo "environ declared dllimport in shell.c and variables.c"

  # Same defect, different symbol: support/xcase.c redeclares
  #   extern int optind;
  # which overrides the correct __declspec(dllimport) declaration that
  # <unistd.h> already provides.  optind is a DATA symbol in msys-2.0.dll, so
  # the bare extern forces auto-import and on AArch64 the pseudo-relocation is
  # never applied.  xcase then reads a garbage optind, "av += optind" walks off
  # argv and "av[0][0]" segfaults -- unconditionally, with or without flags.
  # That is the run-coproc segfault ("coproc xcase -n -u"), which also cost the
  # two Bad-file-descriptor lines that followed it.
  sed -i "s/^extern int optind;/__declspec(dllimport) extern int optind;/" support/xcase.c
  if ! grep -q "dllimport) extern int optind" support/xcase.c; then
    echo "FATAL: optind dllimport patch did not apply" >&2
    return 1
  fi
  echo "optind declared dllimport in support/xcase.c"

  autoconf
}

build() {
  cd ${srcdir}/${pkgname}-$_basever

  export MSYSTEM=CYGWIN

  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    # Cross-build for aarch64-pc-cygwin.
    # Uses the seed readline/ncurses/libintl/libiconv staged under the toolchain
    # sysroot at /usr/aarch64-pc-cygwin/usr.
    #   - GCC-15 too new for bash sources: -std=gnu89 (build + target).
    #   - bash_cv_* : cross defaults for these AC_TRY_RUN probes are wrong.
    #   - CFLAGS_FOR_BUILD -fcommon: build-host helpers (mkbuiltins etc.) need it
    #     under GCC-15's default -fno-common.
    ./configure --build=${CHOST} \
      --host=aarch64-pc-cygwin \
      --prefix=/usr \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --enable-static-link \
      --enable-readline \
      --without-libintl-prefix \
      --without-libiconv-prefix \
      --with-installed-readline \
      --without-bash-malloc \
      --with-curses \
      bash_cv_dev_stdin=present \
      bash_cv_dev_fd=standard \
      bash_cv_wexitstatus_offset=8 \
      bash_cv_termcap_lib=libncurses \
      CFLAGS="-O1 -std=gnu89 -I/usr/aarch64-pc-cygwin/usr/include -I/usr/aarch64-pc-cygwin/usr/include/ncursesw" \
      CFLAGS_FOR_BUILD="-fcommon -std=gnu89" \
      LDFLAGS="${LDFLAGS} -L/usr/aarch64-pc-cygwin/usr/lib"

    expr ${pkgrel} > .build || :

    # CC_FOR_BUILD must stay the BUILD compiler here: `all` builds genuine build
    # tools (mksyntax, mksignames, bashversion, buildversion) that have to run on
    # this x64 host. Overriding it globally cross-builds those too and the build
    # dies trying to execute an ARM64 mksyntax.
    make CPPFLAGS=-DWORDEXP_OPTION \
         HISTORY_LDFLAGS= \
         READLINE_LDFLAGS= \
         CC_FOR_BUILD=gcc \
         LOCAL_LDFLAGS='-Wl,--export-all,--out-implib,lib$(@:.exe=.dll.a)'
    rm -f recho.exe zecho.exe printenv.exe xcase.exe

    make CPPFLAGS=-DWORDEXP_OPTION \
         HISTORY_LDFLAGS= \
         READLINE_LDFLAGS= \
         CC_FOR_BUILD="${CC:-aarch64-pc-cygwin-gcc}" \
         CFLAGS_FOR_BUILD="-O1 -std=gnu89 -I/usr/aarch64-pc-cygwin/usr/include" \
         LDFLAGS_FOR_BUILD="-L/usr/aarch64-pc-cygwin/usr/lib -Wl,--disable-high-entropy-va" \
         recho.exe zecho.exe printenv.exe xcase.exe

    # Gate: each helper must be an ARM64 PE. `file` is the discriminator -- mere
    # existence proves nothing, since the x64 `all` pass creates the same names.
    for h in recho zecho printenv xcase; do
      [ -f "$h.exe" ] || { echo "ERROR: testsuite helper $h.exe was not built"; exit 1; }
      case "$(file "$h.exe")" in
        *ARM64*|*Aarch64*|*aarch64*) echo "HELPER_ARM64_OK:$h" ;;
        *) echo "ERROR: $h.exe is not an ARM64 PE: $(file "$h.exe")"; exit 1 ;;
      esac
      # HIGH_ENTROPY_VA (0x20) must be OFF.  It lets the loader place
      # allocations anywhere in the 128TB space, including inside the 8GiB the
      # cygheap must reserve at 0x800000000; fork in the child then fails with
      #   child_copy: cygheap read copy failed, 0x0..
      # bash.exe gets -Wl,--disable-high-entropy-va from LDFLAGS in the cross
      # config, but these helpers are a SEPARATE make invocation that only sees
      # LDFLAGS_FOR_BUILD, so the flag has to be set there too.  Checked here
      # because the symptom appears only much later, as scattered testsuite
      # failures in whichever groups happen to use the helpers.
      _dc=$(aarch64-pc-cygwin-objdump -p "$h.exe" 2>/dev/null               | awk '/DllCharacteristics/{print $2; exit}')
      if [ -n "${_dc}" ] && [ $(( 0x${_dc} & 0x20 )) -ne 0 ]; then
        echo "ERROR: $h.exe has HIGH_ENTROPY_VA set (DllCharacteristics=0x${_dc})."
        echo "       fork will fail in the testsuite; add"
        echo "       -Wl,--disable-high-entropy-va to LDFLAGS_FOR_BUILD."
        exit 1
      fi
      echo "HELPER_NO_HIGH_ENTROPY_OK:$h"
    done
    return
  fi

  ./configure --build=${CHOST} \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-static-link \
    --enable-readline \
    --without-libintl-prefix \
    --without-libiconv-prefix \
    --with-installed-readline \
    --without-bash-malloc \
    --with-curses \
    bash_cv_dev_stdin=present \
    bash_cv_dev_fd=standard \
    bash_cv_termcap_lib=libncurses

  # Prepopulate the release level.
  expr ${pkgrel} > .build || :

  # CFLAGS+=" -D_STATIC_BUILD"
  make CPPFLAGS=-DWORDEXP_OPTION \
       HISTORY_LDFLAGS= \
       READLINE_LDFLAGS= \
       LOCAL_LDFLAGS='-Wl,--export-all,--out-implib,lib$(@:.exe=.dll.a)'
}

check() {
  # target binaries can't run on the x64 (emulated) cross host
  [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]] && return 0
  cd ${srcdir}/${pkgname}-$_basever
  make check
}

package_bash() {
  provides=('sh')

  cd ${srcdir}/${pkgname}-$_basever
  make DESTDIR=${pkgdir} \
       HISTORY_LDFLAGS= \
       READLINE_LDFLAGS= \
       install

  cp -fp ${pkgdir}/usr/bin/{ba,}sh.exe

  cd ${pkgdir}/usr/share/man/man1 > /dev/null
  echo '.so man1/bash.1' > sh.1
  echo '.so man1/bash_builtins.1.gz' > alias.1

  gzip alias.1
  for f in bg bind break builtin caller case cd command compgen complete \
    continue declare dirs disown do done elif else enable esac eval exec \
    exit export fc fg fi for function getopts hash help history if in jobs \
    let local logout popd pushd read readonly return select set shift shopt \
    source suspend then time times trap type typeset ulimit umask unalias \
    unset until wait while [ ; do
    cp -fp alias.1.gz $f.1.gz
  done
}

package_bash-testsuite() {
 pkgdesc="Bash's own test suite (bash/tests/run-all) plus its target-built helpers"
 options=('!strip')
 cd ${srcdir}/${pkgbase}-$_basever
 install -d ${pkgdir}/usr/share/bash/tests
 cp -a tests/. ${pkgdir}/usr/share/bash/tests/
 for h in recho zecho printenv xcase; do
   [ -f "$h.exe" ] || { echo "ERROR: $h.exe missing -- build() should have made it"; exit 1; }
   install -m755 "$h.exe" ${pkgdir}/usr/share/bash/tests/
 done
}

package_bash-devel() {
 pkgdesc="Bash headers and libraries"
 groups=('development')
 options=('staticlibs')
 backup=()

 mkdir -p ${pkgdir}/usr/{include,lib,bin}
 cd ${srcdir}/bash-$_basever
 cp -f libbash.dll.a ${pkgdir}/usr/lib/

 mkdir -p  ${pkgdir}/usr/include/bash
 for f in [^y]*.h builtins/*.h include/*.h lib/{glob,tilde}/*.h
 do
   /usr/bin/install ${f} ${pkgdir}/usr/include/bash
 done
}

