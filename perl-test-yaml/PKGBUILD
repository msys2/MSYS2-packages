# Maintainer: Peter Budai <peterbudai@hotmail.com>

_perlname='Test-YAML'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.07
pkgrel=3
pkgdesc="Testing Module for YAML Implementations"
arch=('any')
url="https://metacpan.org/dist/Test-YAML"
msys2_references=(
  "purl: pkg:cpan/TINITA/Test-YAML"
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl' 'perl-Test-Base')
options=('!emptydirs')
groups=('perl-modules')
source=("https://www.cpan.org/authors/id/T/TI/TINITA/${_perlname}-${pkgver}.tar.gz")
sha256sums=('1f300d034f46298cb92960912cc04bac33fb27f05b8852d8f051e110b9cd995f')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL installdirs=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
