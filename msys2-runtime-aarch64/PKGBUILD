_target=aarch64-pc-cygwin
_build=x86_64-pc-msys

# Derive the gcc version dir from the compiler: it changes between gcc
# releases (15.0.1 -> 17) and a stale hardcoded path silently breaks the
# -nostdinc include set and the crt*.o copies.
GCC_BASE="$(dirname "$(aarch64-pc-cygwin-gcc -print-libgcc-file-name)")"
prepare() {

  # The AArch64 port, as a patch series on top of upstream msys2-runtime.
  # (Previously these were commits on runtime-upstream-9-sep-nomsys.)
  # Each patch keeps its original commit message and subject.
  for _p in "${srcdir}"/woarm64-*.patch; do
    msg2 "Applying $(basename "${_p}")"
    ( cd "${srcdir}/${_realname}" && git apply --whitespace=fix "${_p}" ) || return 1
  done
  # -------------------------------------------------------------------------
  # BOOTSTRAP STUBS
  # We only stub things that ARE what we're building (circular deps).
  # Everything else must come from real dependency packages.
  #
  # Compare with Cygwin's build-cygwin.sh stage1:
  #   - Headers already installed by install-cygwin-headers.sh
  #   - Win32 libs already installed by build-mingw-crt.sh --enable-w32api
  #   - GCC stage1 already built → libgcc.a, crtbegin/end.o available
  #   - Only crt0.o and libcygwin.a are stubbed (they ARE the build output)
  # -------------------------------------------------------------------------

  echo "" > /tmp/empty.c

  # --- Stub: crt0.o ---
  # Circular dep: crt0.o is produced by msys2-runtime, needed to link anything.
  # We provide a minimal stub that satisfies the linker during bootstrap.
  # The -c flag means compile-only (no link), so no circular dep here.
  cat > /tmp/crt0_stub.c << 'CEOF'
/* Bootstrap stub for crt0.o — replaced after msys2-runtime is built */
void __main(void) {}
void _start(void) {}
void mainCRTStartup(void) {}
void wmainCRTStartup(void) {}
CEOF
  /usr/bin/aarch64-pc-cygwin-gcc -c /tmp/crt0_stub.c \
    -o /usr/aarch64-pc-cygwin/lib/crt0.o
  echo "crt0.o stub installed"

  # --- default-manifest.o: NOT stubbed ---
  # The old stub wrote an EMPTY object into the live sysroot and never into
  # ${pkgdir}, so it shipped in no package -- every non-shared link against the
  # published toolchain then failed with "ld: cannot find default-manifest.o",
  # while in-tree builds stayed green because this line pre-placed the file and
  # masked the gap. Being empty it also embedded no manifest resource.
  #
  # The real object now comes from cross-msysarm64-windows-default-manifest, and
  # this prepare() runs after that package is built, so re-stubbing would clobber
  # it. Unlike crt0.o and libcygwin.a below, it is not a circular dependency of
  # this package and never belonged in this list.

  # --- Stub: libcygwin.a ---
  # Circular dep: libcygwin.a IS what we're building.
  # Empty stub to allow linking during stage1 bootstrap.
  /usr/bin/aarch64-pc-cygwin-gcc -c /tmp/empty.c -o /tmp/empty.o
  /usr/bin/aarch64-pc-cygwin-ar rcs \
    /usr/aarch64-pc-cygwin/lib/libcygwin.a /tmp/empty.o
  echo "libcygwin.a empty stub installed"

  # --- Real: crtbegin.o / crtend.o ---
  # These come from libgcc (cross-msysarm64-gcc-stage1), NOT stubs.
  cp ${GCC_BASE}/crtbegin.o \
    /usr/aarch64-pc-cygwin/lib/crtbegin.o
  cp ${GCC_BASE}/crtend.o \
    /usr/aarch64-pc-cygwin/lib/crtend.o
  echo "crtbegin.o / crtend.o from libgcc installed"

  # --- Real: libgcc.a ---
  # From cross-msysarm64-gcc-stage1. Copy to sysroot/lib for linker discovery.
  cp ${GCC_BASE}/libgcc.a \
    /usr/aarch64-pc-cygwin/lib/libgcc.a
  echo "libgcc.a from gcc-stage1 installed"

  # devices.cc: the old #pragma GCC optimize("O0") hack was removed.
  # At the build's -O1 it compiles cleanly (the ldp_fusion SIGSEGV is -O2-only);
  # the per-object make rule below adds -mno-early-ldp-fusion so it also stays
  # safe if the tree is ever moved to -O2.

  # mkdir -p ${srcdir}/${_realname}/winsup/cygwin/aarch64
  # cp ${startdir}/winsup/cygwin/aarch64/fastcwd.cc \
  #    ${srcdir}/${_realname}/winsup/cygwin/aarch64/fastcwd.cc
  # echo "aarch64/fastcwd.cc injected from startdir"

  # --- Real: Win32 import libs ---
  # These come from cross-msysarm64-crt (--enable-w32api build).
  # They should already be in /usr/aarch64-pc-cygwin/lib/w32api/ with symlinks.
  # Just verify here — do NOT stub these, stubs will break the link.
  # echo "--- Verifying Win32 import libs from cross-msysarm64-crt ---"
  # _ok=1
  # for lib in kernel32 user32 advapi32 shell32 ntdll; do
  #   if [ -f /usr/aarch64-pc-cygwin/lib/lib${lib}.a ]; then
  #     echo "  lib${lib}.a OK"
  #   else
  #     echo "  ERROR: lib${lib}.a MISSING — cross-msysarm64-crt not installed correctly"
  #     _ok=0
  #   fi
  # done
  # if [ $_ok -ne 1 ]; then
  #   echo "FATAL: Missing Win32 import libs. Install cross-msysarm64-crt first."
  #   exit 1
  # fi

  # --- libstdc++ header shadow removal ---
  # libstdc++ wrappers for C headers shadow newlib headers in the sysroot.
  # Remove them so winsup sees newlib's versions, not glibc-oriented wrappers.
  for f in fenv.h stdlib.h alloca.h unistd.h; do
    _wrapper="${GCC_BASE}/include/c++/${f}"
    if [ -f "${_wrapper}" ] && [ ! -f "${_wrapper}.bak" ]; then
      mv "${_wrapper}" "${_wrapper}.bak"
      echo "Moved shadowing header: ${f}"
    fi
  done

  # --- Headers: newlib + cygwin ---
  # These should already be in sysroot from cross-msysarm64-runtime-devel.
  # Refresh them from source to ensure they're the aarch64-patched versions.
  echo "--- Installing headers from source ---"

  # newlib first (base layer)
  # cp -rf ${srcdir}/${_realname}/newlib/libc/include/. \
  #   /usr/aarch64-pc-cygwin/sys-include/
  cp -rf ${srcdir}/${_realname}/newlib/libc/include/. \
    /usr/aarch64-pc-cygwin/include/

  # cygwin headers second (override layer)
  # cp -rf ${srcdir}/${_realname}/winsup/cygwin/include/. \
  #   /usr/aarch64-pc-cygwin/sys-include/
  cp -rf ${srcdir}/${_realname}/winsup/cygwin/include/. \
    /usr/aarch64-pc-cygwin/include/

  # --- Verify aarch64-specific patches are present ---
  echo "--- Header patch verification ---"
  grep -c "__aarch64__" \
    /usr/aarch64-pc-cygwin/sys-include/cygwin/signal.h && \
    echo "signal.h aarch64 patch OK" || \
    echo "ERROR: signal.h missing aarch64 — check mcw/aarch64-winsup-sync branch"

  grep -c "aarch64" \
    ${srcdir}/${_realname}/winsup/cygwin/local_includes/register.h && \
    echo "register.h aarch64 patch OK" || \
    echo "ERROR: register.h missing aarch64 — check source branch"

  # --- Run autogen from TOP-LEVEL ---

  cd ${srcdir}/${_realname}/winsup
  ./autogen.sh || autoreconf -fvi || true
}

build() {
  unset CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
  export CONFIG_SITE=/dev/null
  export CCACHE_DISABLE=1

  export PATH="/opt/bin:/usr/local/bin:/usr/bin:/bin"

  export CC=aarch64-pc-cygwin-gcc
  export CXX=aarch64-pc-cygwin-g++
  export AS=aarch64-pc-cygwin-as
  export LD=aarch64-pc-cygwin-ld
  export AR=aarch64-pc-cygwin-ar
  export RANLIB=aarch64-pc-cygwin-ranlib
  export STRIP=aarch64-pc-cygwin-strip
  export OBJCOPY=aarch64-pc-cygwin-objcopy
  export OBJDUMP=aarch64-pc-cygwin-objdump
  export NM=aarch64-pc-cygwin-nm
  export DLLTOOL=aarch64-pc-cygwin-dlltool
  export WINDRES=aarch64-pc-cygwin-windres
  export WINDMC=aarch64-pc-cygwin-windmc

  which aarch64-w64-mingw32-g++ || \
    echo "WARNING: mingw aarch64 g++ not found"

  # NOTE: the old "strip long-double libm files" step here was
  # a `find newlib/libm -name Makefile.am | sed -d ...` loop. It was DEAD CODE:
  # this newlib uses non-recursive automake, so there are NO Makefile.am files
  # under newlib/libm/ (a single top-level newlib/Makefile.am includes the
  # per-dir Makefile.inc fragments) — the loop body never ran and changed nothing.
  # The real 64-bit-long-double handling for aarch64 is already upstream:
  #   * newlib/libm/Makefile.inc only `include`s libm/ld80 or libm/ld128 for the
  #     i386 / x86_64 / riscv machine dirs, NOT aarch64 — so the extended-precision
  #     *l sources are never compiled for aarch64-pc-cygwin, and
  #   * the *l entry points come from newlib/libm/common/*l.c, which alias to the
  #     double routines under _LDBL_EQ_DBL (aarch64-pc-cygwin has long double == double).
  # autogen below regenerates newlib/Makefile.in from those .inc fragments, so the
  # exclusion is driven by configure, not by a post-clone sed.


  # Run autogen specifically for winsup
  cd ${srcdir}/${_realname}/winsup
  ./autogen.sh || autoreconf -fvi || true

  mkdir -p ${srcdir}/runtime-build
  cd ${srcdir}/runtime-build
  export CFLAGS="\
  -nostdinc \
  -D_MB_CAPABLE=1 \
  -isystem ${GCC_BASE}/include \
  -isystem ${GCC_BASE}/include-fixed \
  -isystem ${HOME}/headers/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include/w32api \
  -O1 -pipe -Wno-error"

  export CXXFLAGS="\
  -nostdinc \
  -nostdinc++ \
  -D_MB_CAPABLE=1 \
  -isystem ${GCC_BASE}/include \
  -isystem ${GCC_BASE}/include-fixed \
  -isystem ${GCC_BASE}/include/c++ \
  -isystem ${GCC_BASE}/include/c++/aarch64-pc-cygwin \
  -isystem ${GCC_BASE}/include/c++/backward \
  -isystem ${HOME}/headers/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include \
  -isystem /usr/aarch64-pc-cygwin/include/w32api \
  -O1 -pipe -Wno-error -std=gnu++17"
  export ac_cv_lib_sframe_sframe_decode=no
  export ac_cv_lib_zstd_ZSTD_isError=no
  CXXFLAGS_FOR_TARGET="-Wno-error -Wno-narrowing" \
  # winsup links the DLL against $(newlib_build)/lib{m,c,g}.a AND references
  # object files directly, e.g. libssp.a depends on
  #   $(wildcard $(newlib_build)/libc/ssp/*.o)
  # so copy the whole newlib BUILD tree, not just the archives.  It must be the
  # build tree, not the sysroot: cross-msysarm64-runtime overwrites the sysroot
  # libc.a with the DLL IMPORT library (t-msys_2_0_dll_*.o thunks), and linking
  # the DLL against its own import stubs fails with thousands of __imp_ refs.
  # NB: this package's newlib sub-recipe directory is newlib_pkgbuild (underscore),
  # unlike cross-msysarm64 stage-2 where it is newlib-pkgbuild.  build_msys.sh here
  # uses the underscore form too; the hyphen was a copy-paste from the stage-2
  # recipe and made this check fail with "newlib build tree not found".
  _nlbuild="${startdir}/newlib_pkgbuild/src/runtime-build/${_target}/newlib"
  if [ ! -d "${_nlbuild}" ]; then
    echo "FATAL: newlib build tree not found at ${_nlbuild}" >&2; return 1
  fi
  if aarch64-pc-cygwin-ar t "${_nlbuild}/libc.a" 2>/dev/null | grep -q "t-msys_2_0_dll"; then
    echo "FATAL: ${_nlbuild}/libc.a is an import library, not static newlib" >&2; return 1
  fi
  mkdir -p "${srcdir}/newlib"
  cp -a "${_nlbuild}/." "${srcdir}/newlib/"
  echo "staged newlib build tree: $(ls "${srcdir}"/newlib/*.a | wc -l) archives, $(ls "${srcdir}"/newlib/libc/ssp/*.o 2>/dev/null | wc -l) ssp objects"

  ${srcdir}/${_realname}/winsup/configure \
    --prefix=/usr \
    --build=${_build} \
    --host=${_target} \
    --target=${_target} \
    --with-cross-bootstrap \
    --disable-doc \
    --disable-dumper \
    --disable-cygserver \
    --disable-utils \
    --without-mingw-progs \
    CC="${CC}" \
    CXX="${CXX}" \
    AR="${AR}" \
    RANLIB="${RANLIB}" \
    NM="${NM}" \
    OBJCOPY="${OBJCOPY}" \
    OBJDUMP="${OBJDUMP}" \
    DLLTOOL="${DLLTOOL}" \
    WINDRES="${WINDRES}" \
    AS="${AS}" \
    LD="${LD}" \
    MINGW_CXX=aarch64-w64-mingw32-g++ \
    MINGW_CC=aarch64-w64-mingw32-gcc \
    CFLAGS="${CFLAGS}" \
    CXXFLAGS="${CXXFLAGS}"

sed -i '/-mno-use-libstdc-wrappers/d' cygwin/Makefile
cat >> cygwin/Makefile << 'EOF'

# GCC-15 AArch64 per-file workarounds — keep the build's -O1; NO -O0 drops.
# Root causes:
#  devices.o           : SIGSEGV in RTL pass ldp_fusion at -O2 (harmless no-op at -O1)
#                        -> -mno-early-ldp-fusion
#  fhandler/netdrive.o : GCC-15 -Wmisleading-indentation whole-file scan hangs forever
#                        (optimizer is fine) -> -Wno-misleading-indentation (keeps -O1 -Wall -Werror)
#  libc/minires-os-if.o: GCC-15 cc1 INTEGRATED-preprocessor segfault on the deep macro-dense
#                        <iphlpapi.h> -> ole2.h -> rpcndr.h header chain. The same TU compiles
#                        clean when preprocessed to a .i and fed with -fpreprocessed, and clean
#                        with a SEPARATE cpp pass, so the bug is in cc1's lex-while-parse path,
#                        NOT the optimizer (crashes at -O0 too), GC, --enable-checking, or stack
#                        size. Fix = run a separate cpp pass for this one C TU. Restores the
#                        Windows DNS resolver backend on AArch64.
devices.o: CXXFLAGS += -mno-early-ldp-fusion
fhandler/netdrive.o: CXXFLAGS += -Wno-misleading-indentation
libc/minires-os-if.o: CFLAGS += -no-integrated-cpp
EOF
# (w32api/ mirror no longer needed: cross-msysarm64-w32api-headers now installs
# the Win32 headers under include/w32api/ via --enable-w32api.)
# crt mingw import libs: prefer the ones already in the INSTALLED cross sysroot
# (cross-msysarm64-w32api-runtime, or a prior pacman -U, put them there). Only fall
# back to copying from the mingw sysroot /opt/aarch64-w64-mingw32/lib/ when a lib is
# missing — so a packaged build no longer depends unconditionally on /opt. (This is
# stage-1/bootstrap.)
for _l in libadvapi32.a libkernel32.a libntdll.a libshell32.a libuser32.a; do
  if [ -f /usr/aarch64-pc-cygwin/lib/${_l} ]; then
    :  # already provided by cross-msysarm64-w32api-runtime — nothing to do
  elif [ -f /opt/aarch64-w64-mingw32/lib/${_l} ]; then
    cp -f /opt/aarch64-w64-mingw32/lib/${_l} /usr/aarch64-pc-cygwin/lib/
    echo "WARNING: ${_l} copied from /opt (legacy fallback) — install cross-msysarm64-w32api-runtime"
  else
    echo "FATAL: ${_l} not in cross sysroot NOR /opt — install cross-msysarm64-w32api-runtime (or mingw-w64-cross-mingwarm64-crt)"
    exit 1
  fi
done
cd ${srcdir}/runtime-build/
cd cygwin
make child_info_magic.h shared_info_magic.h globals.h localtime.patched.c stamp-h1 config.h
cd ../
cd cygserver  
make -j$(nproc) OBJEXT=o
cd ../
sed -i '/^\$(LIBSERVER):/,/libcygserver\.a/c\
LIBSERVER = '"${srcdir}"'/runtime-build/cygserver/libcygserver.a
' cygwin/Makefile
sed -i '/-mno-use-libstdc-wrappers/d' cygwin/Makefile
cd cygwin 

aarch64-pc-cygwin-g++ -DHAVE_CONFIG_H \
-I. \
-I${srcdir}/${_realname}/winsup/cygwin \
-U_FORTIFY_SOURCE \
-I${srcdir}/${_realname}/winsup/cygwin/local_includes \
-I${srcdir}/winsup/cygwin \
-isystem ${srcdir}/${_realname}/winsup/cygwin/include \
-isystem ${srcdir}/newlib/targ-include \
-isystem ${srcdir}/${_realname}/newlib/libc/include \
-fno-rtti -fno-exceptions -fno-use-cxa-atexit \
-fno-threadsafe-statics \
-nostdinc -nostdinc++ \
-D_MB_CAPABLE=1 \
-isystem ${GCC_BASE}/include \
-isystem ${GCC_BASE}/include-fixed \
-isystem ${GCC_BASE}/include/c++ \
  -isystem ${GCC_BASE}/include/c++/aarch64-pc-cygwin \
-isystem ${GCC_BASE}/include/c++/backward \
-isystem ${HOME}/headers/aarch64-pc-cygwin/include \
-isystem /usr/aarch64-pc-cygwin/include \
-isystem /usr/aarch64-pc-cygwin/include/w32api \
-fno-merge-constants \
-O1 -Wno-misleading-indentation \
-MT msys2_path_conv.o -MD -MP -MF /tmp/msys2_path_conv.Tpo \
-c -o msys2_path_conv.o \
${srcdir}/${_realname}/winsup/cygwin/msys2_path_conv.cc

touch msys2_path_conv.o
  # 🔍 MB_CAPABLE CHECK STARTS HERE
  echo "Checking _MB_CAPABLE..."

  cat > mb_check.c << 'EOF'
#ifndef _MB_CAPABLE
#error "_MB_CAPABLE is NOT defined"
#endif
int main() { return 0; }
EOF

  # Compile only: the gate asks a preprocessor question, and linking would need
  # -lmsys-2.0 (injected by the driver's LIB_SPEC) -- which is this build's own
  # output, not yet in the sysroot.
  ${CC} ${CFLAGS} -c mb_check.c -o mb_check.o || {
    echo "❌ MB_CAPABLE check failed"
    exit 1
  }

  echo "✅ MB_CAPABLE is defined"
  # 🔍 MB_CAPABLE CHECK ENDS HERE  

  echo "Current directory: $(pwd)"
  MAKEFILE="cygwin/Makefile"

  echo "Makefile clean patch applied"
  make -j$(nproc) OBJEXT=o
}

# -----------------------------------------------------------------------------
# Stage-1 runtime is INTENTIONALLY bootstrap-only.
#
# It exists solely to break the GCC <-> runtime circular dependency: it produces
# a first msys-2.0.dll + libmsys-2.0.a + newlib libs + the real crt0.o using the
# stage-1 (bootstrap) compiler, so that stage-2 GCC has something to link against.
# Those outputs are consumed DIRECTLY from src/ by cross-msysarm64-gcc's prepare()
# (which now hard-verifies the crt0 is real, not the stub). The shippable runtime
# is the one rebuilt with stage-2 GCC and packaged by msys2-runtime-aarch64-stage-2,
# whose package() is the real, strict one (rejects a stub crt0, ships newlib libs).
#
# Therefore package_*() here stays disabled on purpose: enabling it would create a
# second, stage-1-compiler-built runtime package that must NOT be installed over
# the stage-2 one, and would require wiring an extra build+install step into the
# orchestrator (build-msys2-woarm64-all.sh). That is deferred.
#
