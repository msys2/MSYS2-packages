# Maintainer: Windows on ARM Experiments
_realname=msys2-runtime
pkgbase=${_realname}
# Collision-free cross pkgname: NEVER the host names
# msys2-runtime / msys2-runtime-devel, which would let `pacman -U` clobber the
# host x86_64 MSYS2 runtime on the build box. This is the stage-1 bootstrap
# newlib; distinct from stage-2's cross-msysarm64-newlib so both can coexist.
pkgname=cross-msysarm64-newlib-stage1
pkgver=3.6.7
pkgrel=9
pkgdesc="Cygwin POSIX emulation engine for aarch64-pc-cygwin"
arch=('x86_64')
options=('!strip' '!buildflags')
url="https://cygwin.com"
license=('GPL')
makedepends=(
  "cross-msysarm64-gcc-stage1"        # provides: aarch64-pc-cygwin-gcc, libgcc.a, crtbegin/end.o
  "cross-msysarm64-binutils"          # provides: aarch64-pc-cygwin-ld, ar, etc.
  "cross-msysarm64-w32api-headers"    # provides: sysroot/include/w32api/*.h
  "cross-msysarm64-runtime-devel"     # provides: sysroot/include/ (newlib + cygwin headers)
  "mingw-w64-cross-mingwarm64-gcc"    # provides: aarch64-w64-mingw32-g++ for mingw helper
  "mingw-w64-cross-mingwarm64-crt"    # provides: /opt/aarch64-w64-mingw32/lib/
  "mingw-w64-cross-mingwarm64-zlib"   # provides: /opt/aarch64-w64-mingw32/lib/libz.a
  "cocom"                             # provides: osfmk tool for mach interface generation
  "git"
  "autotools"
)
_upstream_commit=da84778cbc92590c1996c02c68c5a3d3c49e00af
