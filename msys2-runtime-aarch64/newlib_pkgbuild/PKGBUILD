_target=aarch64-pc-cygwin
_build=x86_64-pc-msys

prepare() {

  # The AArch64 port, as a patch series on top of upstream msys2-runtime.
  # (Previously these were commits on runtime-upstream-9-sep-nomsys.)
  # Each patch keeps its original commit message and subject.
  for _p in "${srcdir}"/woarm64-*.patch; do
    msg2 "Applying $(basename "${_p}")"
    ( cd "${srcdir}/${_realname}" && git apply --whitespace=fix "${_p}" ) || return 1
  done
  # -------------------------------------------------------------------------
  # BOOTSTRAP STUBS
  # We only stub things that ARE what we're building (circular deps).
  # Everything else must come from real dependency packages.
  #
  # Compare with Cygwin's build-cygwin.sh stage1:
  #   - Headers already installed by install-cygwin-headers.sh
  #   - Win32 libs already installed by build-mingw-crt.sh --enable-w32api
  #   - GCC stage1 already built → libgcc.a, crtbegin/end.o available
  #   - Only crt0.o and libcygwin.a are stubbed (they ARE the build output)
  # -------------------------------------------------------------------------

  echo "" > /tmp/empty.c

  # --- Stub: crt0.o ---
  # Circular dep: crt0.o is produced by msys2-runtime, needed to link anything.
  # We provide a minimal stub that satisfies the linker during bootstrap.
  # The -c flag means compile-only (no link), so no circular dep here.
  cat > /tmp/crt0_stub.c << 'CEOF'
/* Bootstrap stub for crt0.o — replaced after msys2-runtime is built */
void __main(void) {}
void _start(void) {}
void mainCRTStartup(void) {}
void wmainCRTStartup(void) {}
CEOF
  /usr/bin/aarch64-pc-cygwin-gcc -c /tmp/crt0_stub.c \
    -o /usr/aarch64-pc-cygwin/lib/crt0.o
  echo "crt0.o stub installed"

  # --- default-manifest.o: NOT stubbed ---
  # The old stub was an empty object written into the live sysroot and never into
  # ${pkgdir}, so it shipped in no package while masking the gap in-tree. The real
  # object comes from cross-msysarm64-windows-default-manifest; re-stubbing here
  # would clobber it with the empty one.

  # --- Stub: libcygwin.a ---
  # Circular dep: libcygwin.a IS what we're building.
  # Empty stub to allow linking during stage1 bootstrap.
  /usr/bin/aarch64-pc-cygwin-gcc -c /tmp/empty.c -o /tmp/empty.o
  /usr/bin/aarch64-pc-cygwin-ar rcs \
    /usr/aarch64-pc-cygwin/lib/libcygwin.a /tmp/empty.o
  echo "libcygwin.a empty stub installed"

  # --- Real: crtbegin.o / crtend.o ---
  # These come from libgcc (cross-msysarm64-gcc-stage1), NOT stubs.
  # Resolve gcc's private dir from the compiler rather than hardcoding a version:
  # the installed dir tracks the compiler (15.0.1 -> 17.0.0 when the toolchain
  # moved to upstream GCC), and a stale literal makes every cp below fail with
  # "No such file or directory" before anything is built.
  _gccdir="$(dirname "$(aarch64-pc-cygwin-gcc -print-libgcc-file-name)")"
  cp "${_gccdir}"/crtbegin.o \
    /usr/aarch64-pc-cygwin/lib/crtbegin.o
  cp "${_gccdir}"/crtend.o \
    /usr/aarch64-pc-cygwin/lib/crtend.o
  echo "crtbegin.o / crtend.o from libgcc installed"

  # --- Real: libgcc.a ---
  # From cross-msysarm64-gcc-stage1. Copy to sysroot/lib for linker discovery.
  cp "${_gccdir}"/libgcc.a \
    /usr/aarch64-pc-cygwin/lib/libgcc.a
  echo "libgcc.a from gcc-stage1 installed"

  sed -i '1s/^/#pragma GCC optimize("O0")\n/' \
    ${srcdir}/${_realname}/winsup/cygwin/devices.cc
  echo "devices.cc ICE workaround applied"

  # mkdir -p ${srcdir}/${_realname}/winsup/cygwin/aarch64
  # cp ${startdir}/winsup/cygwin/aarch64/fastcwd.cc \
  #    ${srcdir}/${_realname}/winsup/cygwin/aarch64/fastcwd.cc
  # echo "aarch64/fastcwd.cc injected from startdir"

  # --- Real: Win32 import libs ---
  # These come from cross-msysarm64-crt (--enable-w32api build).
  # They should already be in /usr/aarch64-pc-cygwin/lib/w32api/ with symlinks.
  # Just verify here — do NOT stub these, stubs will break the link.
  # echo "--- Verifying Win32 import libs from cross-msysarm64-crt ---"
  # _ok=1
  # for lib in kernel32 user32 advapi32 shell32 ntdll; do
  #   if [ -f /usr/aarch64-pc-cygwin/lib/lib${lib}.a ]; then
  #     echo "  lib${lib}.a OK"
  #   else
  #     echo "  ERROR: lib${lib}.a MISSING — cross-msysarm64-crt not installed correctly"
  #     _ok=0
  #   fi
  # done
  # if [ $_ok -ne 1 ]; then
  #   echo "FATAL: Missing Win32 import libs. Install cross-msysarm64-crt first."
  #   exit 1
  # fi

  # --- libstdc++ header shadow removal ---
  # libstdc++ wrappers for C headers shadow newlib headers in the sysroot.
  # Remove them so winsup sees newlib's versions, not glibc-oriented wrappers.
  for f in fenv.h stdlib.h alloca.h unistd.h; do
    _wrapper="${_gccdir}/include/c++/${f}"
    if [ -f "${_wrapper}" ] && [ ! -f "${_wrapper}.bak" ]; then
      mv "${_wrapper}" "${_wrapper}.bak"
      echo "Moved shadowing header: ${f}"
    fi
  done

  # --- Headers: newlib + cygwin ---
  # These should already be in sysroot from cross-msysarm64-runtime-devel.
  # Refresh them from source to ensure they're the aarch64-patched versions.
  echo "--- Installing headers from source ---"

  # # newlib first (base layer)
  # cp -rf ${srcdir}/${_realname}/newlib/libc/include/. \
  #   /usr/aarch64-pc-cygwin/sys-include/
  cp -rf ${srcdir}/${_realname}/newlib/libc/include/* \
    /usr/aarch64-pc-cygwin/include/

  # # cygwin headers second (override layer)
  # cp -rf ${srcdir}/${_realname}/winsup/cygwin/include/. \
  #   /usr/aarch64-pc-cygwin/sys-include/
  # mkdir -p /usr/aarch64-pc-cygwin/include/cygwin

  cp -r ${srcdir}/${_realname}/winsup/cygwin/include/* \
        /usr/aarch64-pc-cygwin/include/

  # --- Verify aarch64-specific patches are present ---
  echo "--- Header patch verification ---"
  grep -c "__aarch64__" \
    /usr/aarch64-pc-cygwin/sys-include/cygwin/signal.h && \
    echo "signal.h aarch64 patch OK" || \
    echo "ERROR: signal.h missing aarch64 — check mcw/aarch64-winsup-sync branch"

  grep -c "aarch64" \
    ${srcdir}/${_realname}/winsup/cygwin/local_includes/register.h && \
    echo "register.h aarch64 patch OK" || \
    echo "ERROR: register.h missing aarch64 — check source branch"
  # cp -rf ${srcdir}/${_realname}/winsup/cygwin/include/* \
  #       ${srcdir}/${_realname}/newlib/libc/include/
  # cp -rf src/msys2-runtime/winsup/cygwin/include/* src/msys2-runtime/newlib/libc/include/
  # --- Run autogen from TOP-LEVEL ---
  # We need top-level autogen because we're using top-level configure.
  # winsup/autogen.sh only regenerates winsup/configure — we need the
  # top-level configure to be regenerated too if it's stale.
  cd ${srcdir}/${_realname}/winsup
  ./autogen.sh || autoreconf -fvi || true
}

build() {
  export ac_cv_header_rpc_xdr_h=yes
  export ac_cv_func_xdrmem_create=yes
  export newlib_cv_xdr_dir=yes
  # winsup/configure.ac probes libbfd's deps with AC_CHECK_LIB (link tests) for
  # sframe_decode/-lsframe and ZSTD_isError/-lzstd. This tree also runs
  # AC_NO_EXECUTABLES (cross bootstrap: target binaries can't run on the build
  # host), and a link test after AC_NO_EXECUTABLES is a hard configure error
  # ("link tests are not allowed after AC_NO_EXECUTABLES"). Pre-seed the cache
  # so configure skips both link tests — we don't link sframe/zstd (the dumper
  # is --disable-dumper). Mirrors the stage-2 recipes.
  export ac_cv_lib_sframe_sframe_decode=no
  export ac_cv_lib_zstd_ZSTD_isError=no
  unset CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
  # Do NOT export CC/CXX here — let configure use native gcc for host tools
  # and CC_FOR_TARGET for building target libraries (newlib, winsup)
  export CONFIG_SITE=/dev/null
  export CCACHE_DISABLE=1
  export PATH="/opt/bin:/usr/local/bin:/usr/bin:/bin"

  which aarch64-w64-mingw32-g++ || \
    echo "WARNING: mingw aarch64 g++ not found"

  mkdir -p ${srcdir}/runtime-build
  cd ${srcdir}/runtime-build
  # Derived, not hardcoded - see the crtbegin note in prepare().
  GCC_BASE="$(dirname "$(aarch64-pc-cygwin-gcc -print-libgcc-file-name)")"
  GCC_VER="$(basename "${GCC_BASE}")"

  # Sysroot-style include (merged newlib + cygwin)
  SYSROOT_INC=/usr/aarch64-pc-cygwin/include

export CFLAGS="\
-nostdinc \
-isystem ${GCC_BASE}/include \
-isystem ${GCC_BASE}/include-fixed \
-isystem ${SYSROOT_INC} \
-isystem ${SYSROOT_INC}/w32api \
-D_MB_CAPABLE=1 \
"
  # -isystem ${SYSROOT_INC}/w32api: the Win32 API headers live under
  # include/w32api/, and this -nostdinc build must add that dir explicitly since
  # the gcc spec's automatic -idirafter is suppressed under -nostdinc. Lets a bare
  # <windows.h> resolve while winsup's <w32api/ntstatus.h> resolves via
  # ${SYSROOT_INC} above.
  
  export CPPFLAGS="$CFLAGS"
  export CFLAGS_FOR_TARGET="$CFLAGS"
  export CPPFLAGS_FOR_TARGET="$CFLAGS"

  # winsup's C++ TUs include libstdc++ headers such as <new>, and
  # -nostdinc/-nostdinc++ drops the default C++ search, so add the target
  # libstdc++ include dirs explicitly (mirrors the stage-2 runtime recipe).
  export CXXFLAGS="\
-nostdinc \
-nostdinc++ \
-isystem ${GCC_BASE}/include \
-isystem ${GCC_BASE}/include-fixed \
-isystem ${GCC_BASE}/include/c++ \
-isystem ${GCC_BASE}/include/c++/backward \
-isystem ${SYSROOT_INC} \
-isystem ${SYSROOT_INC}/w32api \
-D_MB_CAPABLE=1 \
"
  export CXXFLAGS_FOR_TARGET="$CXXFLAGS"

  # GCC_VER=15.0.1
  # GCC_BASE=/usr/lib/gcc/aarch64-pc-cygwin/${GCC_VER}

  # SYSROOT_INC=/home/HCKTest/headers/aarch64-pc-cygwin/include

  # export CFLAGS="\
  # -nostdinc \
  # -isystem ${SYSROOT_INC} \
  # -isystem ${GCC_BASE}/include \
  # -isystem ${GCC_BASE}/include-fixed \
  # "

  # export CPPFLAGS="$CFLAGS"
  # export CFLAGS_FOR_TARGET="$CFLAGS"
  # export CPPFLAGS_FOR_TARGET="$CFLAGS"
  CXXFLAGS_FOR_TARGET="${CXXFLAGS} -Wno-error -Wno-narrowing" \
  ${srcdir}/${_realname}/configure \
    --prefix=/usr \
    --build=${_build} \
    --host=${_build} \
    --target=${_target} \
    --with-cross-bootstrap \
    --disable-libgloss \
    --enable-shared \
    --enable-static \
    --disable-doc \
    --disable-dumper \
    --disable-cygserver \
    --disable-utils \
    --without-mingw-progs \
    --without-headers \
    CC="gcc" \
    CXX="g++" \
    AR="ar" \
    RANLIB="ranlib" \
    NM="nm" \
    OBJDUMP="objdump" \
    STRIP="strip" \
    CC_FOR_TARGET="aarch64-pc-cygwin-gcc" \
    CXX_FOR_TARGET="aarch64-pc-cygwin-g++" \
    GCC_FOR_TARGET="aarch64-pc-cygwin-gcc" \
    AR_FOR_TARGET="aarch64-pc-cygwin-ar" \
    RANLIB_FOR_TARGET="aarch64-pc-cygwin-ranlib" \
    NM_FOR_TARGET="aarch64-pc-cygwin-nm" \
    OBJCOPY_FOR_TARGET="aarch64-pc-cygwin-objcopy" \
    OBJDUMP_FOR_TARGET="aarch64-pc-cygwin-objdump" \
    DLLTOOL_FOR_TARGET="aarch64-pc-cygwin-dlltool" \
    WINDRES_FOR_TARGET="aarch64-pc-cygwin-windres" \
    WINDMC_FOR_TARGET="aarch64-pc-cygwin-windmc" \
    LD_FOR_TARGET="aarch64-pc-cygwin-ld" \
    AS_FOR_TARGET="aarch64-pc-cygwin-as" \
    STRIP_FOR_TARGET="aarch64-pc-cygwin-strip" \
    MINGW_CXX=aarch64-w64-mingw32-g++ \
    MINGW_CC=aarch64-w64-mingw32-gcc  \
    CFLAGS="-O2 -pipe -D_MB_CAPABLE=1" \
    CXXFLAGS="${CXXFLAGS} -O2 -pipe"

      # 🔍 MB_CAPABLE CHECK STARTS HERE
  echo "Checking _MB_CAPABLE..."

  cat > mb_check.c << 'EOF'
#ifndef _MB_CAPABLE
#error "_MB_CAPABLE is NOT defined"
#endif
int main() { return 0; }
EOF

  # Compile only: the gate asks a preprocessor question, and linking would need
  # -lmsys-2.0 (injected by the driver's LIB_SPEC) -- which is this build's own
  # output, not yet in the sysroot.
  ${CC} ${CFLAGS} -c mb_check.c -o mb_check.o || {
    echo "❌ MB_CAPABLE check failed"
    exit 1
  }

  echo "✅ MB_CAPABLE is defined"
  # 🔍 MB_CAPABLE CHECK ENDS HERE  
  # --------------------------------------------------------------------------
  # Build ONLY what this recipe delivers: the newlib target libs.
  #
  # This is the first runtime step, and its job is to produce the archives
  # (libc.a / libm.a / libg.a) that package() ships into the sysroot and that
  # msys2-runtime-aarch64 copies in as ${srcdir}/newlib before building winsup.
  #
  # A bare top-level `make` builds `all`, which reaches past newlib into
  # all-target-winsup -- compiling the whole ~700-object winsup tree and linking
  # msys-2.0.dll. That work is redundant: the next step configures winsup
  # separately (winsup/configure, not the top-level one) with its own flags and
  # its own granular make, and never reads an artifact out of this tree's
  # winsup/ directory.
  #
  # `all-target-newlib` is the exact goal. The top-level Makefile makes winsup
  # depend on newlib, never the reverse, so asking for newlib alone is
  # well-defined and cannot silently skip anything newlib needs.
  # --------------------------------------------------------------------------
  make -j$(nproc) all-target-newlib

  # Fail here rather than letting a downstream step trip over a missing archive:
  # package() and the next build step both hard-require these three.
  _nlb="${srcdir}/runtime-build/${_target}/newlib"
  for _l in libc.a libm.a libg.a; do
    [ -f "${_nlb}/${_l}" ] || {
      echo "FATAL: newlib ${_l} missing at ${_nlb} after 'make all-target-newlib'" >&2
      exit 1
    }
  done
  echo "newlib target libs built: libc.a libm.a libg.a"
}




package() {
  # Cross package: ship the newlib C runtime libs into the SYSROOT
  # (/usr/aarch64-pc-cygwin/lib) ONLY — these are aarch64 objects consumed by the
  # aarch64-pc-cygwin cross compiler. `make DESTDIR install` is deliberately NOT
  # used: configure ran with --prefix=/usr, so a DESTDIR install would stage
  # into host /usr/{bin,lib,include} and a `pacman -U` of a host-named package
  # would overwrite the build box's own x86_64 MSYS2 runtime.
  # Mirrors stage-2 cross-msysarm64-newlib's package().
  pkgdesc="newlib C runtime libs for the aarch64-pc-cygwin cross toolchain (stage 1)"
  install -d "${pkgdir}/usr/aarch64-pc-cygwin/lib"
  local _l _s
  for _l in libc.a libm.a libg.a; do
    _s="$(find "${srcdir}/runtime-build" "${srcdir}" -name "${_l}" -path '*newlib*' 2>/dev/null | head -1)"
    [ -z "${_s}" ] && _s="$(find "${srcdir}/runtime-build" "${srcdir}" -name "${_l}" 2>/dev/null | head -1)"
    if [ -n "${_s}" ]; then
      install -m644 "${_s}" "${pkgdir}/usr/aarch64-pc-cygwin/lib/${_l}"
      echo "packaged ${_l} <- ${_s}"
    else
      echo "WARNING: newlib ${_l} not found in build tree"
    fi
  done
}