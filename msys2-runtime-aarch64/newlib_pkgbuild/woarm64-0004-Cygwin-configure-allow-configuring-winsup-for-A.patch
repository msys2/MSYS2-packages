From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aswin-mcw <aswin.kalies@multicorewareinc.com>
Date: Wed, 9 Sep 2026 13:13:39 +0530
Subject: [PATCH 004/109] Cygwin: configure: allow configuring winsup for
 AArch64

(cherry picked from commit c9d00ad85e545ec6725e392b08ea95dcc73f295a)
---
 winsup/configure.ac | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/winsup/configure.ac b/winsup/configure.ac
index 4dd5ccb9f..cae3695ce 100644
--- a/winsup/configure.ac
+++ b/winsup/configure.ac
@@ -103,12 +103,14 @@ DLL_ENTRY="dll_entry"
 
 case "$target_cpu" in
    x86_64)	;;
+   aarch64)	;;
    *)		AC_MSG_ERROR([Invalid target processor "$target_cpu"]) ;;
 esac
 
 AC_SUBST(DLL_ENTRY)
 
 AM_CONDITIONAL(TARGET_X86_64, [test $target_cpu = "x86_64"])
+AM_CONDITIONAL(TARGET_AARCH64, [test $target_cpu = "aarch64"])
 
 AC_ARG_ENABLE(doc,
 	      [AS_HELP_STRING([--disable-doc], [do not build documentation])],,
