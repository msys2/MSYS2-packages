@@ -9,6 +9,11 @@ long double
 atan2l (long double y, long double x)
 {
   long double res = 0.0L;
+#if defined(__x86_64__)
   asm volatile ("fpatan" : "=t" (res) : "u" (y), "0" (x) : "st(1)");
