 {
   long double res = 0.0L;
 
+#if defined(__x86_64__)
   asm volatile (
 	"fld	%%st\n\t"
 	"fmul	%%st(0)\n\t"			/* x^2 */
@@ -24,5 +25,9 @@ long double asinl (long double x)
 	"fsqrt\n\t"				/* sqrt (1 - x^2) */
 	"fpatan"
 	: "=t" (res) : "0" (x) : "st(1)");
+#elif defined(__aarch64__)
+    // TODO
+    res = 0.0;
+#endif
   return res;
 }
