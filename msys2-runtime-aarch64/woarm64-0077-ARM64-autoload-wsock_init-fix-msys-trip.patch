 		newlib_mb=yes
 	  	;;
 	esac
@@ -430,7 +430,7 @@ fi
 # THIS TABLE IS ALPHA SORTED.  KEEP IT THAT WAY.
 
 case "${host}" in
-  *-*-msys*)
