# Maintainer: Michał Korczak <git@omikor.in>

pkgname=xonotic-data
pkgver=0.8.6
pkgrel=1
pkgdesc='A free, fast-paced cross-platform first person shooter (data files)'
arch=('any')
url='https://xonotic.org/'
msys2_repository_url='https://gitlab.com/xonotic/xonotic'
msys2_references=(
  'archlinux: xonotic-data'
)
license=('spdx:GPL-3.0-or-later')
optdepends=(
  'perl: for dedicated server rcon scripts'
)
options=('!strip')
source=("https://dl.xonotic.org/xonotic-${pkgver}.zip")
noextract=("xonotic-${pkgver}.zip")
sha256sums=('50850f8d800e7499722f6ea61e478e96464a375494b5a24da93aa0598cbe964d')

prepare() {
  bsdtar -xf "${srcdir}/xonotic-${pkgver}.zip" \
    Xonotic/COPYING \
    Xonotic/key_0.d0pk \
    Xonotic/data \
    Xonotic/server
}

package() {
  cd "${srcdir}/Xonotic"

  install -Dm644 key_0.d0pk -t "${pkgdir}/usr/share/xonotic/"
  install -Dm644 data/*.pk3 -t "${pkgdir}/usr/share/xonotic/data/"

  find server -type f -exec install -Dm644 {} "${pkgdir}/usr/share/xonotic/{}" \;
  rm -f "${pkgdir}/usr/share/xonotic/server/.gitattributes"

  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
