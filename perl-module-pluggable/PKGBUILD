# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Module-Pluggable'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=6.4
pkgrel=2
pkgdesc="automatically give your module the ability to have plugins"
arch=('any')
url="https://metacpan.org/dist/Module-Pluggable"
msys2_references=(
  'purl: pkg:cpan/SIMONW/Module-Pluggable'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
provides=("perl-Module-Pluggable=${pkgver}")
conflicts=('perl-Module-Pluggable')
replaces=('perl-Module-Pluggable')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/S/SI/SIMONW/${_perlname}-${pkgver}.tar.gz")
sha256sums=('970fd13accd3d538e637db080ebbd9898020c8b5591837c8493a39edd737922d')

build() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"

  find ${pkgdir} -name '.packlist' -delete
  find ${pkgdir} -name '*.pod' -delete
}
