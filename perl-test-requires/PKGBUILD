# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Test-Requires'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.11
pkgrel=3
pkgdesc="Checks to see if the module can be loaded"
arch=('any')
url="https://metacpan.org/dist/Test-Requires"
msys2_references=(
  'purl: pkg:cpan/TOKUHIROM/Test-Requires'
)
groups=('perl-modules')
depends=('perl')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
provides=("perl-Test-Requires=${pkgver}")
conflicts=('perl-Test-Requires')
replaces=('perl-Test-Requires')
source=("https://search.cpan.org/CPAN/authors/id/T/TO/TOKUHIROM/Test-Requires-${pkgver}.tar.gz")
sha256sums=('4b88de549597eecddf7c3c38a4d0204a16f59ad804577b671896ac04e24e040f')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
