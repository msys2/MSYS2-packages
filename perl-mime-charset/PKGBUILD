# Maintainer: Peter Budai <peterbudai at hotmail dot com>

_perlname='MIME-Charset'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.013.1
pkgrel=2
pkgdesc="MIME::Charset - Charset Information for MIME"
arch=('any')
url="https://metacpan.org/${_perlname}/"
msys2_references=(
  "purl: pkg:cpan/NEZUMI/MIME-Charset"
)
groups=("perl-modules")
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("perl")
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/N/NE/NEZUMI/${_perlname}-${pkgver}.tar.gz)
sha256sums=('1bb7a6e0c0d251f23d6e60bf84c9adefc5b74eec58475bfee4d39107e60870f0')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR=${pkgdir}
}
