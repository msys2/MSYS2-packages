# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='ExtUtils-Depends'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.8002
pkgrel=2
pkgdesc="The Perl depends module"
arch=('any')
url="https://metacpan.org/dist/ExtUtils-Depends"
msys2_references=(
  'purl: pkg:cpan/ETJ/ExtUtils-Depends'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/E/ET/ETJ/${_perlname}-${pkgver}.tar.gz")
sha256sums=('02b9a46450050ce19b325b23e46bb4ec644229d7f2d95044f67a86d8efacdc29')

prepare() {
  cd ${_perlname}-${pkgver}
}

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
