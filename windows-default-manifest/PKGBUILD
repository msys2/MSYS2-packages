# Maintainer: dragon-archer <dragon-archer@outlook.com>

pkgname=windows-default-manifest
pkgver=20260815
pkgrel=1
pkgdesc='Default Windows application manifest'
arch=('i686' 'x86_64')
license=('custom:Public Domain')
makedepends=('gcc' 'python')
source=('genrc.py') # https://gist.github.com/lazka/e485d49354b39b81dae45d3848004b7d
sha256sums=('f2bfbcd92ab28d8671dda5a1485aae150ce5d5faf4395a6a4462cacd2a6fb60a')

build() {
  python genrc.py -o "default-manifest.rc"
  windres --target ${CHOST} -i "default-manifest.rc" -o "default-manifest.o"
}

package() {
  install -Dm644 "default-manifest.o" "${pkgdir}/usr/lib/default-manifest.o"
}
