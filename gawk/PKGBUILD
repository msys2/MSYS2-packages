# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=gawk
pkgver=5.4.2
pkgrel=1
pkgdesc="GNU version of awk"
arch=('i686' 'x86_64')
url="https://www.gnu.org/software/gawk/"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/gawk.git'
msys2_references=(
  "cpe: cpe:/a:gnu:gawk"
)
license=('spdx:GPL-3.0-or-later')
depends=(
  'mpfr'
  'libintl'
  'libreadline'
)
makedepends=(
  'autotools'
  'gcc'
  'gettext-devel'
  'mpfr-devel'
  'libreadline-devel'
)
provides=('awk')
source=("https://ftp.gnu.org/pub/gnu/${pkgname}/${pkgname}-${pkgver}.tar.gz"{,.sig})
sha256sums=('79c46f5de14401663c63c8df4fc45c3bda76f6329d73b213523a7c71f32f7243'
            'SKIP')
validpgpkeys=('D1967C63788713177D861ED7DF597815937EC0D2')

prepare() {
  cd "${pkgname}-${pkgver}"

  autoreconf -fiv
}

build() {
  cd "${pkgname}-${pkgver}"

  export gl_cv_have_weak=no

  ./configure \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    --sysconfdir=/etc \
    --without-libiconv-prefix \
    --without-libintl-prefix

  make
}

check() {
  cd "${pkgname}-${pkgver}"

  make check
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  # remove unnessary import libraries of modules
  rm -fv "${pkgdir}"/usr/lib/gawk/*.dll.a

  ln -vf "${pkgdir}"/usr/bin/{gawk,awk}.exe

  # fix OS in gawkbug
  sed -E -i '/^OS=/ s/cygwin/msys/' "${pkgdir}"/usr/bin/gawkbug
}
