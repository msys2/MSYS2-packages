# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname='gtk-doc'
pkgver=1.37.0
pkgrel=1
pkgdesc='Documentation tool for public library API'
arch=('i686' 'x86_64')
url='https://gitlab.gnome.org/GNOME/gtk-doc'
msys2_repository_url='https://gitlab.gnome.org/GNOME/gtk-doc'
msys2_references=(
  'anitya: 13140'
  'archlinux: gtk-doc'
  'aur:' # ignore
  'cygwin: gtk-doc'
  'gentoo: dev-util/gtk-doc'
)
license=('spdx:GFDL-1.1-or-later AND GPL-2.0-or-later')
depends=(
  'docbook-xml'
  'docbook-xsl'
  'glib2'
  'python'
  'python-lxml'
  'python-pygments'
)
makedepends=(
  'gcc'
  'glib2-devel'
  'itstool'
  'meson'
  'ninja'
  'pkgconf'
  'yelp-tools'
)
source=(
  "https://gitlab.gnome.org/GNOME/gtk-doc/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz"
)
sha256sums=('3059675f07bb5a6b1f92011add493494abd03b64c3e988cc0bc26a1cf44b51c9')

build() {
  local _meson_options=(
    --prefix=/usr
    --buildtype=plain
    --auto-features=enabled
    --wrap-mode=nodownload
    -Dtests=false
  )

  meson setup "${_meson_options[@]}" "build-${CHOST}" "${pkgname}-${pkgver}"
  meson compile -C "build-${CHOST}"
}

package() {
  DESTDIR="${pkgdir}" meson install -C "build-${CHOST}"
}
