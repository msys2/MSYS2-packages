

pkgname="docx2txt-rs"
pkgver=0.2.0
pkgrel=2
pkgdesc="Rust rewrite of docx2txt"
arch=('any')
url='https://github.com/dscho/docx2txt-rs'
msys2_repository_url="${url}"
license=('spdx:GPL-3.0-or-later')
depends=("gcc-libs")
makedepends=("rust")
provides=("docx2txt")
conflicts=("docx2txt")
replaces=("docx2txt")
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('25321fa9a937590017419eab8e285076b9530af588bb4c580bcee59285c3f41e')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${pkgname}-${pkgver}"
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

  cargo build --release --frozen
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "target/release/docx2txt.exe" -t "${pkgdir}/usr/bin"
  install -Dm755 "target/release/docx-strip-pii.exe" -t "${pkgdir}/usr/bin"
  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
