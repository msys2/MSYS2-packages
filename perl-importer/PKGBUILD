# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Importer'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.026
pkgrel=3
pkgdesc="Alternative but compatible interface to modules that export symbols"
arch=('any')
url="https://metacpan.org/release/Importer"
msys2_references=(
  'purl: pkg:cpan/EXODIST/Importer'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/E/EX/EXODIST/${_perlname}-${pkgver}.tar.gz")
sha256sums=('e08fa84e13cb998b7a897fc8ec9c3459fcc1716aff25cc343e36ef875891b0ef')

build() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"

  find ${pkgdir} -name '.packlist' -delete
  find ${pkgdir} -name '*.pod' -delete
}
