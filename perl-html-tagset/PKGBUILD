# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='HTML-Tagset'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=3.24
pkgrel=2
pkgdesc="Data tables useful in parsing HTML"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/HTML-Tagset"
msys2_references=(
  "purl: pkg:cpan/PETDANCE/HTML-Tagset"
)
groups=('perl-modules')
depends=('perl>=5.10.0')
replaces=('HTML-Tagset')
provides=('HTML-Tagset')
options=(!emptydirs)
source=(https://www.cpan.org/authors/id/P/PE/PETDANCE/${_perlname}-${pkgver}.tar.gz)
sha256sums=('eb89e145a608ed1f8f141a57472ee5f69e67592a432dcd2e8b1dbb445f2b230b')

build() {
  cd ${srcdir}/${_perlname}-${pkgver}
  # install module in vendor directories.
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${srcdir}/${_perlname}-${pkgver}
  make test
}

package() {
  cd ${srcdir}/${_perlname}-${pkgver}
  make install DESTDIR=${pkgdir}
}
