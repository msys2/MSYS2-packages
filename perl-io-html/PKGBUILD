# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='IO-HTML'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.004
pkgrel=3
pkgdesc="Open an HTML file with automatic charset detection"
arch=('any')
url='https://metacpan.org/release/IO-HTML'
msys2_references=(
  "purl: pkg:cpan/CJM/IO-HTML"
)
groups=('perl-modules')
depends=('perl')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
provides=("perl-IO-HTML=${pkgver}")
conflicts=('perl-IO-HTML')
replaces=('perl-IO-HTML')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/C/CJ/CJM/${_perlname}-$pkgver.tar.gz)
sha256sums=('c87b2df59463bbf2c39596773dfb5c03bde0f7e1051af339f963f58c1cbd8bf5')

build() {
  export PERL_MM_USE_DEFAULT=1 PERL_MM_OPT="INSTALLDIRS=vendor" \
    PERL_MB_OPT="--installdirs vendor"
  cd ${_perlname}-$pkgver
  perl Makefile.PL
  make
}

check() {
  cd ${_perlname}-$pkgver
  make test
}

package() {
  cd ${_perlname}-$pkgver
  make DESTDIR="$pkgdir" install
}
