_realname='pyalpm'
pkgbase="python-${_realname}"
pkgname="python-${_realname}"
pkgver=0.12.0
pkgrel=1
pkgdesc='Libalpm bindings for Python'
arch=('i686' 'x86_64')
url='https://gitlab.archlinux.org/archlinux/pyalpm'
msys2_repository_url='https://gitlab.archlinux.org/archlinux/pyalpm'
msys2_changelog_url='https://gitlab.archlinux.org/archlinux/pyalpm/-/blob/main/NEWS'
msys2_references=(
  'archlinux: pyalpm'
  'purl: pkg:pypi/pyalpm'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  'libarchive'
  'libgpgme'
  'python'
)
makedepends=(
  'gcc'
  'gettext-devel'
  'git'
  'heimdal-devel'
  'libarchive-devel'
  'libcurl-devel'
  'libgpgme-devel'
  'meson'
  'meson-python'
  'pacman'
  'python-build'
  'python-installer'
  'python-pkgconfig'
  'python-pytest' # pytest is checked during build()
)
checkdepends=(
  # 'python-pytest-pacman' # missing
)
provides=("python3-${_realname}")
conflicts=("python3-${_realname}")
replaces=("python3-${_realname}")
source=(
  "git+https://gitlab.archlinux.org/archlinux/pyalpm.git#tag=${pkgver}"
  '001-add-static-libalpm-option.patch'
)
sha256sums=('7d4b8f0329c93970de83df6586e8d55b4b7ecd1c0dc369267e93e9272349ab36'
            '0dbfb531ee845b5ed2506412801067e07a94cadbbc3c2d9d248ce902cfcb6e82')

prepare() {
  cd "${_realname}"

  patch -Nbp1 -i "${srcdir}/001-add-static-libalpm-option.patch"

  # The git repo uses symlinks in the scripts folder to
  # the actual source files in the pycman folder. Patch
  # files created by git will therefore not contain any
  # changes to the files in scripts so copy the patched
  # ones across now.
  cp -f "pycman/action_optdepends.py" "scripts/lsoptdepends"

  for _file in database deptest query remove sync upgrade version; do
    cp -f "pycman/action_${_file}.py" "scripts/pycman-${_file}"
  done
}

build() {
  cp -r "${_realname}" 'python-build' && cd 'python-build'

  python -m build --wheel --skip-dependency-check --no-isolation \
    -C setup-args="-Dstatic-libalpm=true" # passed to meson
}

check() {
  cd 'python-build'

  # MISSING: python-pytest-pacman
  # TODO: uncomment when finished

  # `python -m build` runs meson internally,
  # running manually is needed for tests.
  # meson setup build
  # meson compile -C build
  # meson test -C build -v
}

package() {
  cd 'python-build'

  python -m installer --destdir="${pkgdir}" dist/*.whl
}
