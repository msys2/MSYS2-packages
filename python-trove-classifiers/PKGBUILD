# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname='trove-classifiers'
_pyname="${_realname/-/_}"
pkgname="python-${_realname}"
pkgver=2026.9.21.13
pkgrel=1
pkgdesc='Canonical source for classifiers on PyPI (pypi.org)'
arch=('any')
url='https://github.com/pypa/trove-classifiers'
msys2_repository_url='https://github.com/pypa/trove-classifiers'
msys2_references=(
  'anitya: 88298'
  'archlinux: python-trove-classifiers'
  'gentoo: dev-python/trove-classifiers'
  'purl: pkg:pypi/trove-classifiers'
)
license=('spdx:Apache-2.0')
depends=(
  'python'
)
makedepends=(
  'python-build'
  'python-calver'
  'python-installer'
  'python-setuptools'
)
source=("https://pypi.org/packages/source/${_pyname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('0a9ebc8d4e2f3e8a22848c5258033035bec17a3012ac3fea16dbaa764489eb71')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
