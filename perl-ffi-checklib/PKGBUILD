_perlname='FFI-CheckLib'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.31
pkgrel=2
pkgdesc="Check that a library is available for FFI"
arch=('any')
url="https://metacpan.org/release/FFI-CheckLib"
msys2_references=(
  'purl: pkg:cpan/PLICEASE/FFI-CheckLib'
)
groups=('perl-modules')
depends=('perl')
checkdepends=('perl-test2-suite')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
provides=("perl-FFI-CheckLib=${pkgver}")
conflicts=('perl-FFI-CheckLib')
replaces=('perl-FFI-CheckLib')
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('04d885fc377d44896e5ea1c4ec310f979bb04f2f18658a7e7a4d509f7e80bb80')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  # cd "${srcdir}/${_realname}-${pkgver}"
  # perl-test2-tools-process missing in repository
  # make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
