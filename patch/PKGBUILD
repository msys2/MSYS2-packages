# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname='patch'
pkgver=2.8
pkgrel=1
pkgdesc='A utility to apply patch files to original sources'
arch=('i686' 'x86_64')
url='https://www.gnu.org/software/patch/patch.html'
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/patch.git'
msys2_changelog_url='https://cgit.git.savannah.gnu.org/cgit/patch.git/tree/NEWS'
msys2_references=(
  'anitya: 2597'
  'archlinux: patch'
  'cpe: cpe:/a:gnu:patch'
  'gentoo: sys-devel/patch'
)
license=('spdx:GPL-3.0-or-later')
makedepends=(
  'autotools'
  'ed'
  'gcc'
  'python'
)
optdepends=(
  'ed: for patch -e functionality'
)
source=(
  "https://ftp.gnu.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.xz"{,.sig}
  'msys2-patch-2.7.1.patch'
  'msys2-patch-manifest.patch'
)
sha256sums=('f87cee69eec2b4fcbf60a396b030ad6aa3415f192aa5f7ee84cad5e11f7f5ae3'
            'SKIP'
            '616eb43416099b94ac12064aac987028454a8745f79a1482524e514285e02c98'
            '180a810171f4dc3491e9eb723c30a29d2f9e051a357b4b997ded4b78d6036cbb')
validpgpkeys=(
  '259B3792B3D6D319212CC4DCD5BF9FEB0313653A' # Andreas Gruenbacher
)

prepare() {
  cd "${pkgname}-${pkgver}"

  rm -f src/patch.manifest src/patch.rc

  patch -Np1 -i "${srcdir}/msys2-patch-2.7.1.patch"
  patch -Np2 -i "${srcdir}/msys2-patch-manifest.patch"

  local _arch
  if [[ "${CARCH}" == 'x86_64' ]]; then
    _arch='amd64'
  elif [[ "${CARCH}" == 'i686' ]]; then
    _arch='x86'
  fi
  sed -i "s|@ARCH@|${_arch}|g" src/patch.manifest

  autoreconf -fiv
}

build() {
  cd "${pkgname}-${pkgver}"

  export MSYSTEM=CYGWIN

  local _configure_options=(
    --build="${CHOST}"
    --prefix=/usr
    ac_cv_func_setmode_dos=yes
    gl_cv_clean_version_stddef=yes # fixes gnulib on cygwin
  )

  ./configure "${_configure_options[@]}"

  make
}

check() {
  cd "${pkgname}-${pkgver}"

  make check
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
