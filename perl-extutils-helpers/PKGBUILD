# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='ExtUtils-Helpers'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.028
pkgrel=3
pkgdesc="ExtUtils::Helpers - Various portability utilities for module builders"
arch=('any')
url="https://metacpan.org/dist/ExtUtils-Helpers"
msys2_references=(
  'purl: pkg:cpan/LEONT/ExtUtils-Helpers'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
provides=("perl-ExtUtils-Helpers=${pkgver}")
conflicts=('perl-ExtUtils-Helpers')
replaces=('perl-ExtUtils-Helpers')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/L/LE/LEONT/${_perlname}-${pkgver}.tar.gz")
sha256sums=('c8574875cce073e7dc5345a7b06d502e52044d68894f9160203fcaab379514fe')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""                 \
      PERL_AUTOINSTALL=--skipdeps                            \
      PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'"     \
      PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
      MODULEBUILDRC=/dev/null

    cd "${srcdir}/${_perlname}-${pkgver}"
    /usr/bin/perl Makefile.PL
    make
  )
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""
    make test
  )
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}
