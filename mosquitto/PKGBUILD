pkgname=mosquitto
pkgver=2.1.4
pkgrel=1
pkgdesc='An Open Source MQTT Broker'
arch=('x86_64')
url='https://mosquitto.org'
msys2_repository_url='https://github.com/eclipse-mosquitto/mosquitto'
msys2_documentation_url='https://mosquitto.org/documentation/'
msys2_changelog_url='https://github.com/eclipse-mosquitto/mosquitto/blob/master/ChangeLog.txt'
msys2_references=(
  'anitya: 6078'
  'archlinux: mosquitto'
  'cpe: cpe:/a:eclipse:mosquitto'
  'gentoo: app-misc/mosquitto'
)
license=('spdx:EPL-2.0 OR EDL-1.0')
depends=(
  'cjson'
  'libcares'
  'libmicrohttpd'
  'libopenssl'
  'libwebsockets'
)
makedepends=(
  'cmake'
  'docbook-xsl'
  'gcc'
  'libcares-devel'
  'openssl-devel'
)
source=(
  "https://mosquitto.org/files/source/${pkgname}-${pkgver}.tar.gz"
  '0001-Fix-the-build-for-cygwin-and-msys2.patch'
  '0002-link-libmicrohttpd.patch'
)
noextract=("${pkgname}-${pkgver}.tar.gz")
sha512sums=('310a8b7a69a8bd2fee1ff4d58302203b3b5765cc1aa1948dd423cb367ee66314ab683b92cfde67454bc66fd193ba2bc8875136218f63b130ecf6790f4f20bed3'
            '7ea9d41c979f0e574437535be0943d0387bc968b1099421f64dc2c0951d5d974c0a2222ef789f6c4bd76b88f641d9fb0191818f21a14ba33dcf67af8e4f9b163'
            '2f915414ef0154998d0397320b6ad0dbcca20ca3ebb28badb0d0269ddc0acd9da3a2064a8200e4281bded8c837ba926f86143df5e9d98f3e8bcb12e4a6714205')
validpgpkeys=('A0D6EEA1DCAE49A635A3B2F0779B22DFB3E717B7') # Roger A. Light <roger@atchoo.org>

prepare() {
  # fixes symlinks: www/man
  bsdtar -xf "${pkgname}-${pkgver}.tar.gz" || true

  cd "${pkgname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-Fix-the-build-for-cygwin-and-msys2.patch"
  patch -Np1 -i "${srcdir}/0002-link-libmicrohttpd.patch"
}

build() {
  local cmake_options=(
    -B build
    -S "${pkgname}-${pkgver}"
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_INSTALL_SBINDIR=bin
    -D CMAKE_INSTALL_SYSCONFDIR=/etc
    -D WITH_SRV=ON
    -D WITH_PLUGINS=OFF
    -D WITH_WEBSOCKETS=ON
    -D WITH_TESTS=OFF
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -Dm644 "${pkgname}-${pkgver}/epl-v20" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  ln -sf msys-mosquitto-1.dll   "${pkgdir}/usr/bin/msys-mosquitto.dll"
  ln -sf msys-mosquittopp-1.dll "${pkgdir}/usr/bin/msys-mosquittopp.dll"
}
