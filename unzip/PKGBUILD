pkgname=unzip
pkgver=6.0
pkgrel=4
pkgdesc="Unpacks .zip archives such as those made by PKZIP"
arch=('i686' 'x86_64')
url="http://www.info-zip.org/"
msys2_references=(
  "anitya: 8684"
  "cpe: cpe:/a:unzip_project:unzip"
  "cpe: cpe:/a:info-zip:unzip"
)
license=('spdx:LicenseRef-Info-ZIP')
groups=('compression')
depends=('libbz2' 'bash')
makedepends=(
  'libbz2-devel'
  'libiconv-devel'
  'gcc'
  'git'
  'make'
)
source=(
  'https://downloads.sourceforge.net/infozip/unzip60.tar.gz'
  "unzip-fedora::git+https://src.fedoraproject.org/rpms/unzip.git#commit=5787660118b7f462b8ff39151b773bf64fec6400"
)
sha256sums=('036d96991646d0449ed0aa952e4fbe21b476ce994abc276e49d30e686708bd37'
            '7eed63a37f5dde5d0cb755f4ecc3775abda1187da2557231bfee65623a488362')

prepare() {
  cd ${srcdir}/${pkgname}${pkgver/./}
  # see unzip-fedora/unzip.spec
  patch -p1 -i ../unzip-fedora/unzip-6.0-bzip2-configure.patch   # unexpectedly ends in middle of line... but configure looks collect
  patch -p1 -i ../unzip-fedora/unzip-6.0-exec-shield.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-close.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-attribs-overflow.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-configure.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-manpage-fix.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-fix-recmatch.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-symlink.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-caseinsensitive.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-format-secure.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-valgrind.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-x-option.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-overflow.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-cve-2014-8139.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-cve-2014-8140.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-cve-2014-8141.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-overflow-long-fsize.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-heap-overflow-infloop.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-alt-iconv-utf8.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-alt-iconv-utf8-print.patch
  patch -p1 -i ../unzip-fedora/0001-Fix-CVE-2016-9844-rhbz-1404283.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-timestamp.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-cve-2018-1000035-heap-based-overflow.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-cve-2018-18384.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-COVSCAN-fix-unterminated-string.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part1.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part2.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part3.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-manpage.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part4.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part5.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part6.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-part7.patch
  patch -p1 -i ../unzip-fedora/unzip-zipbomb-switch.patch
  patch -p1 -i ../unzip-fedora/unzip-gnu89-build.patch
  patch -p1 -i ../unzip-fedora/unzip-6.0-wcstombs-fortify.patch
  # patch -p1 -i ../unzip-fedora/unzip-6.0-fix-warning-messages-on-big-files.patch
  # patch -p1 -i ../unzip-fedora/unzip-6.0-sast.patch
  # patch -p1 -i ../unzip-fedora/unzip-6.0-RHEL-86228.patch
  # patch -p1 -i ../unzip-fedora/unzip-6.0-CVE-2022-0529-and-0530.patch
}

build() {
  cd ${srcdir}/${pkgname}${pkgver/./}

  # set CFLAGS -- from Debian
  export CFLAGS="$CFLAGS -D_FILE_OFFSET_BITS=64 -DACORN_FTYPE_NFS \
  -DWILD_STOP_AT_DIR -DLARGE_FILE_SUPPORT -DUNICODE_SUPPORT \
  -DUNICODE_WCHAR -DUTF8_MAYBE_NATIVE -DNO_LCHMOD -DDATE_FORMAT=DF_YMD \
  -DUSE_BZIP2 -DNATIVE"

  sed -i "/MANDIR =/s#)/#)/share/#" unix/Makefile

  make \
    -f unix/Makefile generic_gcc CC=gcc LD=gcc AS=gcc \
    CF_NOOPT="${CFLAGS} -DUNIX -I." \
    LFLAGS2="-liconv" \
    E=".exe" CP="cp" LN="ln -s"
}

package() {
  cd ${srcdir}/${pkgname}${pkgver/./}

  # install -- from Debian
  make -f unix/Makefile prefix=${pkgdir}/usr LN="ln -s" MANDIR=${D}/usr/share/man/man1 INSTALL_PROGRAM="install" install

  # install the license file
  install -Dm644 LICENSE ${pkgdir}/usr/share/licenses/unzip/LICENSE
}
