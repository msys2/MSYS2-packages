# Maintainer: Andrea Dalle Vacche

_perlname='List-MoreUtils-XS'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.430
pkgrel=6
pkgdesc="Provide the stuff missing in List::Util"
arch=('i686' 'x86_64')
license=('spdx:Apache-2.0')
url="https://metacpan.org/release/List-MoreUtils"
msys2_references=(
  "purl: pkg:cpan/REHSACK/List-MoreUtils-XS"
)
depends=('perl')
makedepends=('perl-devel' 'make' 'gcc')
groups=('perl-modules')
provides=("perl-List-MoreUtils-XS=${pkgver}")
conflicts=('perl-List-MoreUtils-XS')
replaces=('perl-List-MoreUtils-XS')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/R/RE/REHSACK/${_perlname}-${pkgver}.tar.gz)
sha256sums=('e8ce46d57c179eecd8758293e9400ff300aaf20fefe0a9d15b9fe2302b9cb242')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
