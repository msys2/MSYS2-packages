# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Clone'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.51
pkgrel=1
pkgdesc='Recursive copy of nested objects.'
arch=('i686' 'x86_64')
url='https://metacpan.org/dist/Clone'
msys2_repository_url='https://github.com/garu/Clone'
msys2_changelog_url='https://metacpan.org/dist/Clone/changes'
msys2_references=(
  'archlinux: perl-clone'
  'purl: pkg:cpan/ATOOMIC/Clone'
)
groups=('perl-modules')
license=('spdx:GPL-1.0-or-later' 'spdx:Artistic-1.0-Perl')
depends=('perl')
makedepends=('perl-devel' 'gcc' 'make')
provides=("perl-Clone=${pkgver}")
conflicts=('perl-Clone')
replaces=('perl-Clone')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/A/AT/ATOOMIC/${_perlname}-${pkgver}.tar.gz")
sha256sums=('f17f66fec97dacca67ac9585701d2d079cfc80539fe6e8160c201c4e55f67507')

build() {
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""                 \
      PERL_AUTOINSTALL=--skipdeps                            \
      PERL_MM_OPT="INSTALLDIRS=vendor"     \
      PERL_MB_OPT="--installdirs vendor" \
      MODULEBUILDRC=/dev/null

    cd ${_perlname}-${pkgver}
    /usr/bin/perl Makefile.PL
    make
  )
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="$pkgdir" install
  find "$pkgdir" -name '.packlist' -delete
  find "$pkgdir" -name '*.pod' -delete
}
