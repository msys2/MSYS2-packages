# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

_perlname='Test-Pod'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.52
pkgrel=3
pkgdesc="Check for POD errors in files"
arch=('any')
url="https://metacpan.org/dist/Test-Pod"
msys2_references=(
  "purl: pkg:cpan/ETHER/Test-Pod"
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl' 'perl-module-build')
groups=('perl-modules')
provides=("perl-Test-Pod=${pkgver}")
conflicts=('perl-Test-Pod')
replaces=('perl-Test-Pod')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/E/ET/ETHER/${_perlname}-${pkgver}.tar.gz)
sha256sums=('60a8dbcc60168bf1daa5cc2350236df9343e9878f4ab9830970a5dde6fe8e5fc')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL installdirs=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
