# Maintainer : Gork             <bertsmithzp@gmail.com>
# Contributor: Christoph Reiter <reiter.christoph@gmail.com>

pkgname=fmt
pkgver=12.2.1
pkgrel=1
pkgdesc='Open-source formatting library for C++'
arch=('x86_64' 'i686')
url='https://fmt.dev'
msys2_repository_url='https://github.com/fmtlib/fmt'
msys2_documentation_url='https://fmt.dev'
msys2_changelog_url='https://github.com/fmtlib/fmt/blob/main/ChangeLog.md'
msys2_references=(
  'anitya: 11526'
  'archlinux: fmt'
  'cpe: cpe:/a:fmt:fmt'
  'gentoo: dev-libs/libfmt'
)
license=(spdx:MIT)
depends=(
  'gcc-libs'
)
makedepends=(
  'cmake'
  'gcc'
  'ninja'
)
source=("https://github.com/fmtlib/fmt/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('449374d74f31b67796dece454d59b93e6f1538efcce0e9ac78000c98142c139e')

build() {
  cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -S "${pkgname}-${pkgver}" \
    -B build

  cmake --build build
}

check() {
  cmake --build build --target test
}

package() {
  DESTDIR="${pkgdir}" cmake --build build --target install

  install -Dm 644 "${pkgname}-${pkgver}"/LICENSE -t "${pkgdir}"/usr/share/licenses/fmt/
}
