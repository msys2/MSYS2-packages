# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='JSON'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=4.11
pkgrel=2
pkgdesc="JSON (JavaScript Object Notation) encoder/decoder"
arch=('any')
url="https://metacpan.org/release/JSON"
msys2_repository_url='https://github.com/makamaka/JSON'
msys2_references=(
  'purl: pkg:cpan/ISHIGAKI/JSON'
)
license=('spdx:GPL-1.0-or-later' 'spdx:Artistic-1.0-Perl')
groups=('perl-modules')
depends=('perl>=5.10.0')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/I/IS/ISHIGAKI/${_perlname}-${pkgver}.tar.gz")
sha256sums=('713bdbe724dbb915ed50265ffe47e079a511980cb2427aa19076788bb64c3182')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
  find "${pkgdir}" -name '.packlist' -delete
  find "${pkgdir}" -name '*.pod' -delete
}
