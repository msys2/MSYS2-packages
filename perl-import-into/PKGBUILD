# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

_perlname='Import-Into'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.002005
pkgrel=3
pkgdesc="Import packages into other packages"
arch=('any')
url="https://metacpan.org/dist/Import-Into"
msys2_references=(
  'purl: pkg:cpan/HAARG/Import-Into'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=('perl-modules')
depends=('perl-module-runtime>=0' 'perl>=5.006')
provides=("perl-Import-Into=${pkgver}")
conflicts=('perl-Import-Into')
replaces=('perl-Import-Into')
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/H/HA/HAARG/Import-Into-${pkgver}.tar.gz)
sha512sums=('d356307072da18bc40b25f11583018ed416cb87178f080982e14e98e53d42bc1e04aebda56d595e707c05065eaa6ad7a6b059920e8b5b8e1589bfd68e26900fb')

prepare() {
  cd ${_perlname}-${pkgver}
}

build() {
  cd ${_perlname}-${pkgver}
  PERL_MM_USE_DEFAULT=1 \
  PERL_AUTOINSTALL=--skipdeps \
  PERL5LIB="" \
  MODULEBUILDRC=/dev/null \
  PERL_MM_OPT="INSTALLDIRS=vendor" \
  PERL_MB_OPT="--installdirs vendor" \
  perl Makefile.PL
  make
}

package() {
  cd ${_perlname}-${pkgver}
  make install DESTDIR="${pkgdir}"
}
