# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=Authen-SASL
pkgname=perl-${_realname}
pkgver=2.2100
pkgrel=1
pkgdesc="Perl/CPAN Module Authen::SASL : SASL authentication framework"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Authen-SASL"
msys2_repository_url='https://github.com/perl-authen-sasl/perl-authen-sasl'
msys2_changelog_url='https://metacpan.org/dist/Authen-SASL/changes'
msys2_references=(
  'purl: pkg:cpan/EHUELS/Authen-SASL'
)
depends=('perl')
groups=('perl-modules')
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/E/EH/EHUELS/${_realname}-${pkgver}.tar.gz)
sha256sums=('4f0f100aeed34b52977a94b7df973e7f0b8f92d167b09f2b249bab81e8590e57')

build() {
  cd ${_realname}-${pkgver}
  PERL_USE_UNSAFE_INC=1 \
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd ${_realname}-${pkgver}
  make pure_install doc_install DESTDIR=$pkgdir
  find $pkgdir -name '.packlist' -delete
  find $pkgdir -name '*.pod' -delete
}
