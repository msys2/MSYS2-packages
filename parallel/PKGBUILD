# Maintainer: David Mott <mott.david.j@gmail.com>
# Contributor: Niklas Holm <jadedcyborg@gmail.com>

pkgname='parallel'
pkgver=20261122
pkgrel=1
pkgdesc="A shell tool for executing jobs in parallel"
arch=('any')
url='https://www.gnu.org/software/parallel/'
msys2_references=(
  "cpe: cpe:/a:gnu:parallel"
)
license=('spdx:GPL-3.0-or-later')
depends=('perl')
makedepends=(
  'autotools'
  'autoconf-archive' # for AX_SYS_PERLSHARPBANG
)
source=(
  "https://ftpmirror.gnu.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.bz2"{,".sig"}
  "0001-support-MSys2.patch"
)
sha256sums=('95d3f68a482561c68fbc1a136b7e10098b7068493451b53380b322388403aa6f'
            'SKIP'
            'bc2be2aa945f69ce7b95b905e3bcfbb67bd0b0bf41f40b32d4c167f2c07b05db')
validpgpkeys=(
  'CDA01A4208C4F74506107E7BD1AB451688888888' # Ole Tange <ole@tange.dk>
)

prepare() {
  cd "${pkgname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-support-MSys2.patch"

  autoreconf -fiv
}

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
