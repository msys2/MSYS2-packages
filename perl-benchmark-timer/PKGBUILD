# Maintainer: Ray Donnelly <mingw.android@gmail.com>

_perlname='Benchmark-Timer'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.7112
pkgrel=2
pkgdesc="Provide commonly requested regular expressions"
arch=('any')
url="https://metacpan.org/dist/Benchmark-Timer"
msys2_references=(
  "purl: pkg:cpan/DCOPPIT/Benchmark-Timer"
)
groups=('perl-modules')
depends=('perl')
license=('spdx:GPL-2.0-only')
provides=("perl-Benchmark-Timer=${pkgver}")
conflicts=('perl-Benchmark-Timer')
replaces=('perl-Benchmark-Timer')
source=("https://www.cpan.org/authors/id/D/DC/DCOPPIT/${_perlname}-${pkgver}.tar.gz")
sha256sums=('0278447d9ad9d773d59a4ebd6db8afeadde81c8fa5d6a8738f5e7d578e2a402e')

prepare() {
  cd "$srcdir/${_perlname}-${pkgver}"
}

build() {
  cd "$srcdir/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "$srcdir/${_perlname}-${pkgver}"
  make install DESTDIR="$pkgdir"
}
