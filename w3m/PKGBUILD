# Maintainer: Johannes Schindelin <johannes.schindelin@gmx.de>

pkgname=w3m
pkgver=0.5.6
pkgrel=1
pkgdesc="w3m is a pager with WWW capability (net-utils)"
arch=('i686' 'x86_64')
url="https://git.sr.ht/~rkta/w3m"
msys2_repository_url='https://git.sr.ht/~rkta/w3m'
msys2_references=(
  "anitya: 5115"
  "cpe: cpe:/a:w3m:w3m"
)
license=('spdx:LicenseRef-w3m')
groups=('net-utils')
depends=('libgc' 'libiconv' 'libintl' 'openssl' 'zlib' 'ncurses')
makedepends=('libgc-devel' 'libiconv-devel' 'gettext-devel' 'openssl-devel' 'zlib-devel' 'autotools' 'ncurses-devel' 'gcc')
source=("${pkgname}-${pkgver}.tar.gz::https://git.sr.ht/~rkta/w3m/archive/v${pkgver}.tar.gz"
        '0001-fix-win9x-cygwin-legacy.patch')
sha256sums=('8dd652cd3f31817d68c7263c34eeffb50118c80be19e1159bf8cbf763037095e'
            'e664ac2af4b98fca2307fbd47db03437b7a6b5b6cf8394b789925a3796b3643d')

prepare() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  cp /usr/share/libtool/build-aux/config.{guess,sub} ./
  patch -p1 -i "${srcdir}/0001-fix-win9x-cygwin-legacy.patch"
}

build() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  ./configure \
    --prefix=/usr \
    --with-editor=/usr/bin/vim \
    --with-mailer=/usr/bin/mutt \
    --with-browser=/usr/bin/elinks
  make
}

package() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  make DESTDIR="${pkgdir}" install

  mkdir -p "${pkgdir}/usr/share/licenses/${pkgname}"
  cp -f doc/README "${pkgdir}/usr/share/licenses/${pkgname}"
}
