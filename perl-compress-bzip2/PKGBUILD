# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Compress-Bzip2'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=2.28
pkgrel=8
pkgdesc="Interface to Bzip2 compression library"
arch=('i686' 'x86_64')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
makedepends=('perl-devel' 'libbz2-devel' 'gcc' 'make')
depends=('perl' 'libbz2')
groups=('perl-modules')
url="https://metacpan.org/release/Compress-Bzip2"
msys2_references=(
  "purl: pkg:cpan/RURBAN/Compress-Bzip2"
)
provides=("perl-Compress-Bzip2=${pkgver}")
conflicts=('perl-Compress-Bzip2')
replaces=('perl-Compress-Bzip2')
options=('!emptydirs')
source=("https://www.cpan.org/authors/id/R/RU/RURBAN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('859f835c3f5c998810d8b2a6f9e282ff99d6cb66ccfa55cae7e66dafb035116e')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
