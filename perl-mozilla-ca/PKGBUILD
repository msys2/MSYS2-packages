# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Mozilla-CA'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=20260813
pkgrel=2
pkgdesc="Mozilla's CA cert bundle in PEM format"
arch=('any')
license=('spdx:MPL-2.0')
options=(!emptydirs)
depends=('perl>=5.006')
url="https://metacpan.org/dist/Mozilla-CA"
msys2_references=(
  'purl: pkg:cpan/LWP/Mozilla-CA'
)
groups=('perl-modules')
provides=("perl-Mozilla-CA=${pkgver}")
conflicts=('perl-Mozilla-CA')
replaces=('perl-Mozilla-CA')
source=("https://cpan.metacpan.org/authors/id/L/LW/LWP/Mozilla-CA-${pkgver}.tar.gz")
sha256sums=('81f0bd9665eacbb6feef13b0fa16fbb30162c09292542b1206434e569196dd9b')

build() {
  cd ${_perlname}-${pkgver}
  export PERL_MM_USE_DEFAULT=1 PERL_AUTOINSTALL=--skipdeps
  unset PERL5LIB PERL_MM_OPT
  /usr/bin/perl Makefile.PL
  make
}

check() {
  cd ${_perlname}-${pkgver}
  export PERL_MM_USE_DEFAULT=1
  unset PERL5LIB
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make install INSTALLDIRS=vendor DESTDIR="$pkgdir"
}
