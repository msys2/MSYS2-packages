# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

_perlname='YAML-Tiny'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.76
pkgrel=2
pkgdesc="Read/Write YAML files with as little code as possible"
arch=('any')
url="https://metacpan.org/dist/YAML-Tiny"
msys2_references=(
  'purl: pkg:cpan/ETHER/YAML-Tiny'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/E/ET/ETHER/${_perlname}-${pkgver}.tar.gz")
sha256sums=('a8d584394cf069bf8f17cba3dd5099003b097fce316c31fb094f1b1c171c08a3')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  # install module in vendor directories.
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
