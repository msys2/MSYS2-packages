# Maintainer: Yasuhiro MATSUMOTO <mattn.jp@gmail.com>

pkgname='znc'
pkgver=1.10.3
pkgrel=1
pkgdesc='An IRC bouncer with modules & scripts support'
arch=('x86_64')
url='https://znc.in/'
msys2_repository_url='https://github.com/znc/znc'
msys2_references=(
  'anitya: 5305'
  'archlinux: znc'
  'aur:' # ignore znc-git
  'cpe: cpe:/a:znc:znc'
  'gentoo: net-irc/znc'
)
license=('spdx:Apache-2.0')
depends=(
  'icu'
  'openssl'
)
makedepends=(
  'cmake'
  'cyrus-sasl'
  'gcc'
  'gettext-devel'
  'git'
  'icu-devel'
  'libsasl-devel'
  'ninja'
  'perl'
  'python'
  'swig'
)
optdepends=(
  'cyrus-sasl: cyrusauth module'
  'perl: modperl module'
  'python: modpython module'
  'tcl: modtcl module'
)
conflicts=('znc-git')
replaces=('znc-git')
source=("${pkgname}-${pkgver}::git+https://github.com/znc/znc.git#tag=znc-${pkgver}")
sha256sums=('fe5a24c385dc2093c84d8397585c6ee24714024f6f1be38e7fb8c5394144e67c')

prepare() {
  cd "${pkgname}-${pkgver}"

  git submodule update --init --recursive
}

build() {
  local _cmake_options=(
    -B "build-${CARCH}"
    -G Ninja
    -D BUILD_SHARED_LIBS=OFF
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -D WANT_CYRUS=ON
    -D WANT_I18N=OFF
    -D WANT_PERL=ON
    -D WANT_PYTHON=ON
    -S "${pkgname}-${pkgver}"
  )

  cmake "${_cmake_options[@]}"
  cmake --build "build-${CARCH}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${CARCH}"

  python -m compileall -o 0 -o 1 -s "${pkgdir}" "${pkgdir}/usr/lib/znc"

  cd "${pkgname}-${pkgver}"

  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
