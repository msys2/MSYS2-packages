# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

_perlname='Devel-GlobalDestruction'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.14
pkgrel=4
pkgdesc="Expose the flag which marks global"
arch=('any')
url="https://metacpan.org/release/Sub-Exporter"
msys2_references=(
  'purl: pkg:cpan/HAARG/Devel-GlobalDestruction'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl' 'perl-sub-exporter' 'perl-sub-exporter-progressive')
provides=("perl-Devel-GlobalDestruction=${pkgver}")
conflicts=('perl-Devel-GlobalDestruction')
replaces=('perl-Devel-GlobalDestruction')
options=('!emptydirs')
source=(https://search.cpan.org/CPAN/authors/id/H/HA/HAARG/Devel-GlobalDestruction-${pkgver}.tar.gz)
sha512sums=('75c346feae98897fb202dea0295f0225bf3cac59f21915da5dd1cdcf845052f4f8bcd0362d357020fb0facb6358175112b3685860ca1c1f173421c7c6a54f45d')

prepare() {
  cd ${_perlname}-${pkgver}
}

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd ${_perlname}-${pkgver}
  make install DESTDIR="${pkgdir}"
}
