# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_perlname='HTTP-CookieJar'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=0.014
pkgrel=2
pkgdesc='A minimalist HTTP user agent cookie jar'
arch=(any)
url="https://metacpan.org/dist/${_perlname}"
msys2_references=(
  'purl: pkg:cpan/DAGOLDEN/HTTP-CookieJar'
)
license=('spdx:Apache-2.0')
depends=(perl-http-date)
checkdepends=(perl-test-deep perl-test-requires perl-http-message)
options=(!emptydirs)
source=("https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('7094ea5c91f536d263b85e83ab4e9a963e11c4408ce08ecae553fa9c0cc47e73')

build() (
  cd "${_perlname}-${pkgver}"
  unset PERL5LIB PERL_MM_OPT PERL_LOCAL_LIB_ROOT
  export PERL_MM_USE_DEFAULT=1 PERL_AUTOINSTALL=--skipdeps
  perl Makefile.PL INSTALLDIRS=vendor
  make
)

check() (
  cd "${_perlname}-${pkgver}"
  unset PERL5LIB PERL_MM_OPT PERL_LOCAL_LIB_ROOT
  export PERL_MM_USE_DEFAULT=1
  make test
)

package() (
  cd "${_perlname}-${pkgver}"
  unset PERL5LIB PERL_MM_OPT PERL_LOCAL_LIB_ROOT
  make install INSTALLDIRS=vendor DESTDIR="$pkgdir"
)
