apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -p1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd ${srcdir}/binutils

  # The AArch64 port, as a patch series on top of upstream binutils.
  # (Previously these lived as commits on binutils-woarm64 aarch64-on-latest.)
  for _p in "${srcdir}"/woarm64-*.patch; do
    msg2 "Applying $(basename "${_p}")"
    patch -Nbp1 -i "${_p}" || return 1
  done
  # apply_patch_with_msg \
  #   0002-check-for-unusual-file-harder.patch \
  #   0010-bfd-Increase-_bfd_coff_max_nscns-to-65279.patch \
  #   9999-workarounds.patch
  # No patches on the aarch64-on-latest base (upstream 2.47.50):
  #   9999-workarounds.patch  readline/tcap.h already has the real prototypes
  #                           upstream, so the patch is effectively already in.
  #   0010-..._max_nscns      its bfd/coffcode.h literal is gone upstream and its
  #                           other targets (rs6000/alpha/mips/sh) are not built
  #                           here; large section counts on aarch64 are handled
  #                           by upstream bigobj (aarch64_pe_bigobj_le_vec).
  :
}

build() {
  mkdir -p ${srcdir}/binutils-build && cd ${srcdir}/binutils-build

  ${srcdir}/binutils/configure \
    --build=${_host} \
    --host=${_host} \
    --target=${_target} \
    --prefix=/usr \
    --disable-dependency-tracking \
    --disable-werror \
    --enable-lto \
    --enable-64-bit-bfd \
    --with-libiconv-prefix=/usr \
    --with-system-zlib

  make CFLAGS="-std=gnu17 -O2 -pipe"
}

package() {
  cd ${srcdir}/binutils-build
  make DESTDIR=${pkgdir} install
  rm -rf "${pkgdir}/usr/share/info"
  rm -rf "${pkgdir}/usr/share/locale"
  rm -rf "${pkgdir}/usr/share/gdb"
  rm -rf "${pkgdir}/usr/lib"
  rm -rf "${pkgdir}/usr/include"
}