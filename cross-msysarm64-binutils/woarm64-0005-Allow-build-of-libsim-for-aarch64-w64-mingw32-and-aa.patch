From: =?UTF-8?q?Radek=20Barto=C5=88?= <radek.barton@microsoft.com>
Date: Tue, 20 May 2025 09:02:55 +0200
Subject: [PATCH 05/10] Allow build of `libsim` for `aarch64-w64-mingw32` and
 `aarch64-pc-cygwin` (#8)

(cherry picked from commit 4c7df05d93ba1af0bde1a74eab2ab0875a8ab835)
---
 gdb/configure.tgt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/gdb/configure.tgt b/gdb/configure.tgt
index 7313b31e42a..1d837c82efb 100644
--- a/gdb/configure.tgt
+++ b/gdb/configure.tgt
@@ -138,6 +138,10 @@ aarch64*-*-elf | aarch64*-*-rtems*)
 	gdb_target_obs="aarch64-newlib-tdep.o"
 	;;
 
+aarch64-*-mingw* | aarch64-*-cygwin*)
+	gdb_target_obs="windows-tdep.o"
+	;;
+
 aarch64*-*-freebsd*)
 	# Target: FreeBSD/aarch64
 	gdb_target_obs="aarch64-fbsd-tdep.o"
