pkgname=nyacc
pkgver=4.0.0
pkgrel=1
pkgdesc="NYACC (Not Yet Another Compiler Compiler)"
arch=('x86_64')
url="https://www.nongnu.org/nyacc/"
msys2_repository_url="https://github.com/mwette/nyacc"
license=('spdx:LGPL-3.0-or-later')
depends=(
  'guile'
)
makedepends=(
  'gcc'
)
options=('!makeflags')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/mwette/nyacc/archive/refs/tags/v${pkgver}.tar.gz"
)
sha512sums=('ea19ee1c732b86bc93cdcf2b129cf5354fb26bea6d38dbcfbc28523d194352b88c7154596420cfa5d44bc50ddf89f8d6f2360d1e7ad6bb63355bd3ca5ca5f41f')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure --prefix=/usr

  make
}

check() {
  cd "${pkgname}-${pkgver}"

  make check
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
