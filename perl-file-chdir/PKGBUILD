# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='File-chdir'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.1011
pkgrel=3
pkgdesc="a more sensible way to change directories"
arch=('any')
url="https://metacpan.org/dist/File-chdir"
msys2_references=(
  "purl: pkg:cpan/DAGOLDEN/File-chdir"
)
groups=('perl-modules')
depends=('perl')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
provides=("perl-File-chdir=${pkgver}")
conflicts=('perl-File-chdir')
replaces=('perl-File-chdir')
source=("https://www.cpan.org/authors/id/D/DA/DAGOLDEN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('31ebf912df48d5d681def74b9880d78b1f3aca4351a0ed1fe3570b8e03af6c79')

build() {
  cd "$srcdir/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
