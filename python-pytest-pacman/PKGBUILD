_realname='pytest-pacman'
pkgbase="python-${_realname}"
pkgname="python-${_realname}"
pkgver=0.2.1
pkgrel=2
pkgdesc='Pacman db pytest fixture'
arch=('any')
url='https://gitlab.archlinux.org/archlinux/pytest-pacman'
msys2_repository_url='https://gitlab.archlinux.org/archlinux/pytest-pacman'
msys2_references=(
  'archlinux: python-pytest-pacman'
  # 'purl: pkg:pypi/pytest-pacman' # PyPI package disappeared?
)
license=('spdx:MIT')
depends=(
  'python'
  'python-pytest'
)
makedepends=(
  'git'
  'python-build'
  'python-flit-core'
  'python-installer'
)
source=("git+https://gitlab.archlinux.org/archlinux/${_realname}.git#tag=v${pkgver}")
sha256sums=('fd4af7f3facabb57c0b382fb767ab5b92f4b031d479c3140cf482140c8ebae55')

build() {
  cp -r "${_realname}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m pytest || warning 'Tests failed'
}

package() {
  cd "build-${MSYSTEM}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
