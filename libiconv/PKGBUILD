# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

pkgname=('libiconv' 'iconv' 'libiconv-devel')
pkgver=1.19
pkgrel=1
pkgdesc='Libiconv is a conversion library'
groups=('libraries')
arch=('i686' 'x86_64' 'aarch64')
makedepends=('autotools' 'gcc' 'gettext-devel')
url='https://www.gnu.org/software/libiconv/'
msys2_repository_url='https://git.savannah.gnu.org/gitweb/?p=libiconv.git'
license=('spdx:GPL-3.0-only AND LGPL-2.1-only')
source=("https://ftp.gnu.org/pub/gnu/${pkgname}/${pkgname}-${pkgver}.tar.gz"
        1.16-aliases.patch
        1.16-cross-install.patch
        1.16-wchar.patch
        libiconv-1.16-msysize.patch
        0001-fixes-building-with-gcc-15.patch)
sha256sums=('88dd96a8c0464eca144fc791ae60cd31cd8ee78321e67397e25fc095c4a19aa6'
            'd447b5467867b72041737d0d35720c30e4edf4845b9bcd1858b0f44e126a179d'
            '1e24e990d67fd8fbb9ece6318880127ff06b84d2d278dd18b0643044e64e5edf'
            'c2f4b2d0ce0cd7d2dc98aa1d5e2db31c3b88c1b399d3706dbdacfaef3c13d70c'
            '8a43391e9402e99f70ef3f5dfbb8dda7ab7a30d91c00189ce5ab38c1bc6352d8'
            '126065bc77421edfe0eb01ca50c2920742f0ddddb5860f8eec06d0e497cbcd20')
options=(!libtool)

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying $_patch"
    patch -Nbp1 -i "${srcdir}/$_patch"
  done
}

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}

  apply_patch_with_msg \
    1.16-aliases.patch \
    1.16-cross-install.patch \
    1.16-wchar.patch \
    libiconv-1.16-msysize.patch \
    0001-fixes-building-with-gcc-15.patch

  cp -f srcm4/* m4/

  for _m4 in build-to-host.m4 codeset.m4 fcntl-o.m4 host-cpu-c-abi.m4 \
             lib-ld.m4 relocatable.m4 relocatable-lib.m4 visibility.m4; do
    cp -f "srcm4/${_m4}" "libcharset/m4/${_m4}"
  done

  (cd libcharset && autoreconf -fiv)
  autoreconf -fiv

  # gl_RELOCATABLE going unexpanded is only a runtime warning, so a broken
  # macro dir would otherwise cost a full build to notice. Fail loudly here.
  if grep -q '^gl_RELOCATABLE$' libcharset/configure; then
    echo "==> ERROR: libcharset/configure still has an unexpanded gl_RELOCATABLE" >&2
    echo "    -- libcharset/m4 is missing macros from srcm4 (see #42)." >&2
    return 1
  fi

  # libtool 2.6.2-1 lost every `msys*` case label, so $host_os=msys matches no
  # Windows branch and libtool silently refuses shared libraries. ltmain.sh is
  # patched too (its `-lc` skip list lost *-*-msys*).
  source "${startdir}/../.ci/fix-msys-libtool.sh"
  fix_msys_libtool configure libcharset/configure
  # ltmain.sh's location depends on where autoreconf puts the aux dir, so find
  # it rather than assuming. Missing it entirely is NOT harmless -- that is the
  # hunk that keeps the link from silently degrading to static (see #36), and a
  # `[ -f ]` guard would skip it quietly. Require at least one.
  _lt_found=0
  while IFS= read -r lt; do
    fix_msys_libtool "$lt"
    _lt_found=1
  done < <(find . -maxdepth 3 -name ltmain.sh -type f)
  if [[ ${_lt_found} -eq 0 ]]; then
    echo "==> ERROR: no ltmain.sh found -- libtool would link static-only (see #36)." >&2
    return 1
  fi
}

build() {
  cd ${srcdir}/${pkgname}-${pkgver}

  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    ./configure \
      --prefix=/usr \
      --host=aarch64-pc-cygwin \
      --build=${CHOST} \
      --without-libintl-prefix \
      --enable-static \
      --enable-shared \
      --enable-extra-encodings \
      gl_cv_clean_version_stddef=yes \
      am_cv_proto_iconv_arg1= \
      am_cv_proto_iconv="extern size_t iconv (iconv_t cd, char * *inbuf, size_t *inbytesleft, char * *outbuf, size_t *outbytesleft);"
    make lib/localcharset.h
    make -C lib iconv.lo CFLAGS="-O1"
    make
    make DESTDIR=${srcdir}/dest install
    return
  fi

  ./configure \
    --prefix=/usr \
    --build=${CHOST} \
    --without-libintl-prefix \
    --enable-static \
    --enable-shared \
    --enable-extra-encodings

  make
  make DESTDIR=${srcdir}/dest install
}

check() {
  # target binaries can't run on the x64 (emulated) cross host
  [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]] && return 0
  cd ${srcdir}/${pkgname}-${pkgver}
  make check
}

package_libiconv() {
  depends=('gcc-libs')

  mkdir -p ${pkgdir}/usr
  cp -rf ${srcdir}/dest/usr/bin ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/share ${pkgdir}/usr/
  rm ${pkgdir}/usr/bin/*.exe
}

package_iconv() {
  depends=('gcc-libs' "libiconv=${pkgver}" 'libintl')
  conflicts=('libiconv<1.18-2')

  mkdir -p ${pkgdir}/usr
  cp -rf ${srcdir}/dest/usr/bin ${pkgdir}/usr/
  rm ${pkgdir}/usr/bin/*.dll
}

package_libiconv-devel() {
  groups=('development')
  options=('staticlibs')
  depends=("iconv=${pkgver}" "libiconv=${pkgver}")
  pkgdesc="libiconv headers and libraries"

  mkdir -p ${pkgdir}/usr
  cp -rf $srcdir/dest/usr/include ${pkgdir}/usr/
  cp -rf $srcdir/dest/usr/lib ${pkgdir}/usr/
  rm -f ${pkgdir}/usr/lib/charset.alias
}
