# Maintainer: Michał Korczak

pkgname=supertux-data
pkgver=0.7.0.1
pkgrel=1
pkgdesc="A classic 2D jump'n'run sidescroller game (data files)"
arch=('any')
url='https://github.com/supertux/supertux'
msys2_repository_url='https://github.com/supertux/supertux'
msys2_references=(
  'archlinux: supertux'
  'cpe: cpe:/a:supertux:supertux'
  'purl: pkg:github/supertux/supertux'
)
license=(
  'spdx:GPL-2.0-or-later'
  'spdx:GPL-3.0-or-later'
  'spdx:Apache-2.0'
  'spdx:OFL-1.1'
  'spdx:CC-BY-3.0'
  'spdx:CC-BY-4.0'
  'spdx:CC-BY-SA-3.0'
  'spdx:CC-BY-SA-4.0'
  'spdx:CC-BY-NC-4.0'
  'spdx:CC0-1.0'
  'custom:MapoBackpacking'
)
options=('!strip')
source=("https://github.com/SuperTux/supertux/releases/download/v${pkgver}/SuperTux-v${pkgver}-Source.tar.gz")
noextract=("SuperTux-v${pkgver}-Source.tar.gz")
sha256sums=('c3a3813bc57b8267960e4fcc33afe5f5cb468abe2a288fe58da4f288d0d7442c')

prepare() {
  # Excluded files are based on CMake Release if-block
  bsdtar -xf "${srcdir}/SuperTux-v${pkgver}-Source.tar.gz" \
    --exclude='*/data/levels/test' \
    --exclude='*/data/levels/test_old' \
    --exclude='*/data/levels/incubator' \
    "SuperTux-v${pkgver}-Source/LICENSE.txt" \
    "SuperTux-v${pkgver}-Source/data"
}

package() {
  cd "${srcdir}/SuperTux-v${pkgver}-Source"

  mkdir -p "${pkgdir}/usr/share/supertux2"
  cp -r data/. "${pkgdir}/usr/share/supertux2/"

  install -Dm644 LICENSE.txt \
    data/ACKNOWLEDGEMENTS.txt \
    data/AUTHORS \
    data/credits.stxt \
    data/fonts/DEKKO_LICENSE.txt \
    data/fonts/MapoBackpacking_License.txt \
    data/fonts/NOTO_SANS_LICENSE.txt \
    data/fonts/Roboto_License.txt \
    data/fonts/SOURCECODEPRO_LICENSE.md \
    data/fonts/VARELA_ROUND_LICENSE.txt \
    -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
