# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Text-Diff'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.45
pkgrel=3
pkgdesc="Text::CharWidth - Perform diffs on files and record sets"
arch=('any')
url="https://metacpan.org/dist/Text-Diff/"
msys2_references=(
  'purl: pkg:cpan/NEILB/Text-Diff'
)
groups=("perl-modules")
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("perl" "perl-algorithm-diff" "perl-exporter")
makedepends=("perl-extutils-makemaker")
provides=("perl-Text-Diff=${pkgver}")
conflicts=('perl-Text-Diff')
replaces=('perl-Text-Diff')
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/N/NE/NEILB/${_perlname}-${pkgver}.tar.gz)
sha256sums=('e8baa07b1b3f53e00af3636898bbf73aec9a0ff38f94536ede1dbe96ef086f04')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR=${pkgdir}
}
