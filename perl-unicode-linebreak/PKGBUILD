# Maintainer: Peter Budai <peterbudai at hotmail dot com>

_perlname='Unicode-LineBreak'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=2019.001
pkgrel=9
pkgdesc="UAX #14 Unicode Line Breaking Algorithm"
arch=('i686' 'x86_64')
url="https://metacpan.org/release/${_perlname}"
msys2_references=(
  "purl: pkg:cpan/NEZUMI/Unicode-LineBreak"
)
groups=("perl-modules")
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("perl" "perl-MIME-Charset")
makedepends=("perl-devel" 'make' 'gcc')
checkdepends=("perl-Test-Pod")
conflicts=("perl-Unicode-GCString")
replaces=("perl-Unicode-GCString")
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/N/NE/NEZUMI/${_perlname}-${pkgver}.tar.gz)
sha256sums=('486762e4cacddcc77b13989f979a029f84630b8175e7fef17989e157d4b6318a')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR=${pkgdir}
}
