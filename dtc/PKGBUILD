# Maintainer: Andy Gross <andy.gross@linaro.org>

pkgname=dtc
pkgver=1.8.1
pkgrel=1
pkgdesc="Device Tree Compiler"
arch=('i686' 'x86_64')
url="https://git.kernel.org/pub/scm/utils/dtc/dtc.git"
msys2_references=(
  "anitya: 16911"
  "cpe: cpe:2.3:a:dtc_project:dtc"
)
license=('spdx:GPL-2.0-or-later')
depends=('libyaml' 'bash')
makedepends=('python-devel' 'swig' 'libyaml-devel' 'gcc' 'python-setuptools-scm' 'pkgconf' 'meson')
source=("https://git.kernel.org/pub/scm/utils/dtc/dtc.git/snapshot/${pkgname}-${pkgver}.tar.gz"
        '001-legacy-swig.patch')
sha256sums=('74b50bb19134f6562490afea53e59953dd6c4afb17e5ccb60be32221262d3390'
            '35198d278ab70499ed97f3eb9159efc6756cf2fa672563e0ec40d88b5d770ec0')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  patch -p1 -i "${srcdir}/001-legacy-swig.patch"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export SETUPTOOLS_SCM_PRETEND_VERSION="${pkgver}"

  meson setup \
    --prefix=/usr \
    build-${CARCH}

  meson compile -C build-${CARCH}
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  meson test -C build-${CARCH} --print-errorlogs || true
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  
  DESTDIR="${pkgdir}" meson install -C build-${CARCH}

  # license
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/README.license" "${pkgdir}/usr/share/licenses/${pkgname}/README.license"
}
