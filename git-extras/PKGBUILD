_realname='git-extras'
pkgname="${_realname}"
pkgver=7.5.0
pkgrel=1
pkgdesc='GIT utilities -- repo summary, commit counting, repl, changelog population and more'
arch=('any')
url='https://github.com/tj/git-extras'
msys2_repository_url='https://github.com/tj/git-extras'
msys2_references=(
  'anitya: 1167'
  'archlinux: git-extras'
  'gentoo: dev-vcs/git-extras'
)
license=('spdx:MIT')
depends=('git')
replaces=("${pkgname}-git")
conflicts=("${pkgname}-git")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/tj/git-extras/archive/${pkgver}.tar.gz")
noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('bcfe0eabdccc806e53a10130fed6fb02373720ddeb670eecc5cc84d041d79880')

prepare() {
  bsdtar -zxf "${_realname}-${pkgver}.tar.gz" || true

  cd "${_realname}-${pkgver}"

  cp bin/git-scp bin/git-rscp
}

package() {
  cd "${_realname}-${pkgver}"

  make DESTDIR="${pkgdir}" PREFIX=/usr SYSCONFDIR=/etc install

  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${_realname}"
}
