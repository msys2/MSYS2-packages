# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='TermReadKey'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=2.38
pkgrel=9
pkgdesc="Provides simple control over terminal driver modes"
arch=('i686' 'x86_64')
license=('spdx:LicenseRef-TermReadKey')
depends=('perl')
makedepends=('make' 'gcc' 'perl-devel')
url="https://metacpan.org/dist/TermReadKey"
groups=('perl-modules')
provides=("perl-TermReadKey=${pkgver}")
conflicts=('perl-TermReadKey')
replaces=('perl-TermReadKey')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/J/JS/JSTOWE/${_perlname}-${pkgver}.tar.gz)
sha256sums=('5a645878dc570ac33661581fbb090ff24ebce17d43ea53fd22e105a856a47290')
msys2_references=(
  'archlinux: perl-term-readkey'
  "purl: pkg:cpan/JSTOWE/TermReadKey"
)

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install

  install -d "${pkgdir}/usr/share/licenses/${pkgname}/"
  head -7 README > "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
