# Maintainer: Peter Budai <peterbudai@hotmail.com>

_perlname='Spiffy'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.46
pkgrel=4
pkgdesc="Spiffy Perl Interface Framework For You"
arch=('any')
url="https://metacpan.org/dist/Spiffy"
msys2_references=(
  "purl: pkg:cpan/INGY/Spiffy"
)
groups=('perl-modules')
depends=('perl')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
provides=("perl-Spiffy=${pkgver}")
conflicts=('perl-Spiffy')
replaces=('perl-Spiffy')
source=("https://www.cpan.org/authors/id/I/IN/INGY/Spiffy-${pkgver}.tar.gz")
sha256sums=('8f58620a8420255c49b6c43c5ff5802bd25e4f09240c51e5bf2b022833d41da3')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
