--- origsrc/util-linux-2.42.4/sys-utils/setsid.c
+++ src/util-linux-2.42.4/sys-utils/setsid.c
@@ -15,6 +15,8 @@
  * 2008-08-20 Daniel Kahn Gillmor <dkg@fifthhorseman.net>
  * - if forked, wait on child process and emit its return code.
  */
+
+#include <fcntl.h>
 #include <getopt.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -53,6 +55,7 @@
 {
 	int ch, forcefork = 0;
 	int ctty = 0;
+	int fd;
 	pid_t pid;
 	int status = 0;
 
@@ -120,6 +123,16 @@
 
 	if (ctty && ioctl(STDIN_FILENO, TIOCSCTTY, 1))
 		err(EXIT_FAILURE, _("failed to set the controlling terminal"));
+	if ((fd = open ("/dev/null", O_RDWR, 0)) >= 0) {
+		if (isatty (STDIN_FILENO))
+			dup2 (fd, STDIN_FILENO);
+		if (isatty (STDOUT_FILENO))
+			dup2 (fd, STDOUT_FILENO);
+		if (isatty (STDERR_FILENO))
+			dup2 (fd, STDERR_FILENO);
+		if (fd > 2)
+			close (fd);
+	}
 	execvp(argv[optind], argv + optind);
 	errexec(argv[optind]);
 }
