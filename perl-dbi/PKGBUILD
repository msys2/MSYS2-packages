# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='DBI'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.653
pkgrel=2
pkgdesc="Database independent interface for Perl"
arch=('i686' 'x86_64')
url="https://metacpan.org/dist/DBI"
msys2_repository_url='https://github.com/perl5-dbi/dbi'
msys2_changelog_url='https://metacpan.org/dist/DBI/changes'
msys2_references=(
  "cpe: cpe:/a:perl:database_interface"
  "cpe: cpe:/a:perl:dbi"
  'purl: pkg:cpan/HMBRAND/DBI'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
makedepends=('perl-devel' 'gcc')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/H/HM/HMBRAND/${_perlname}-${pkgver}.tgz")
sha256sums=('a98c21fd37eed8f841172875d175d972fe87f063d7d0d2a3b7765908bb25eb58')

build() {
  cd "${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
