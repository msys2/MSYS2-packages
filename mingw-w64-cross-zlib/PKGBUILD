# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=zlib
_mingw_suff=mingw-w64-cross
pkgbase="${_mingw_suff}-zlib"
_targetpkgs=("${_mingw_suff}-ucrt64-${_realname}" "${_mingw_suff}-mingw32-${_realname}" "${_mingw_suff}-mingw64-${_realname}" "${_mingw_suff}-mingwarm64-${_realname}")
pkgname=("${_mingw_suff}-${_realname}" "${_targetpkgs[@]}")
pkgdesc="Compression library implementing the deflate compression method found in gzip and PKZIP"
pkgver=1.4
pkgrel=1
arch=('i686' 'x86_64')
url="https://www.zlib.net/"
msys2_repository_url="https://github.com/madler/zlib"
msys2_references=(
  'archlinux: zlib'
  'cpe: cpe:/a:zlib:zlib'
)
msys2_ignore_vulnerabilities=(
  "CVE-2026-22184" # only affects demo program untgz which we don't ship
)
license=('spdx:Zlib')
groups=("${_mingw_suff}-toolchain" "${_mingw_suff}")
depends=()
makedepends=(
  'cmake'
  'ninja'
  "${_mingw_suff}-gcc"
  "${_mingw_suff}-mingwarm64-gcc"
)
options=('!strip' '!buildflags')
source=(
  "https://github.com/madler/zlib/releases/download/v${pkgver}/zlib-${pkgver}.tar.xz"{,.asc}
  01-no-extra-suffix-for-static-library.patch
  02-no-pdb-for-mingw.patch
  03-fix-output-name-for-zlib1.patch
  04-no-minizip-headers-in-zlib1.patch
)
sha256sums=('4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c'
            'SKIP'
            'c3d9dd52828a458b7558712dda57b4acf1ddfe9944d6c1a2675e1471e661975d'
            '3b969ab5377633fc9e66c1ae862b2d5bc37f954a2bfe56d752b280ea13e3bec2'
            'aa541a5f4c50c5355209f7f94087e5970ebb8c34100b5ad5adba690bc100c992'
            '39e63187a6bd6108ec926e7148d5a43e67ed8b8beb4e1c82e8408248c0d1f0c3')
validpgpkeys=(
  '5ED46A6721D365587791E2AA783FCD8E58BCAFBA' # Mark Adler <madler@alumni.caltech.edu>
)

apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  apply_patch_with_msg \
    01-no-extra-suffix-for-static-library.patch \
    02-no-pdb-for-mingw.patch \
    03-fix-output-name-for-zlib1.patch \
    04-no-minizip-headers-in-zlib1.patch
}

_build() {
  _target=$1
  msg "Configuring ${_realname} for ${_target}"
  unset CC CXX

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_SYSTEM_NAME=Windows \
    -DCMAKE_SYSTEM_PROCESSOR="${_target%%-*}" \
    -DCMAKE_C_COMPILER="${_target}-gcc" \
    -DCMAKE_RC_COMPILER="${_target}-windres" \
    -DCMAKE_INSTALL_PREFIX="/opt/${_target}" \
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
    -DZLIB_BUILD_ZLIB1_DLL=ON \
    -DZLIB1_DLL_ENABLE_BZIP2=OFF \
    -DZLIB_BUILD_TESTING=OFF \
    -DZLIB_BUILD_MINIZIP=OFF \
    -S "${srcdir}/${_realname}-${pkgver}" \
    -B "${srcdir}/build-${_target}"

  cmake --build "${srcdir}/build-${_target}"
}

_package() {
  _target=$1
  msg "Installing ${_realname} for ${_target}"
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build-${_target}"
}

build() {
  for _pkg in "${_targetpkgs[@]}"; do
    case "$_pkg" in
    "${_mingw_suff}-ucrt64-${_realname}") _build "x86_64-w64-mingw32ucrt" ;;
    "${_mingw_suff}-mingw32-${_realname}") _build "i686-w64-mingw32" ;;
    "${_mingw_suff}-mingw64-${_realname}") _build "x86_64-w64-mingw32" ;;
    "${_mingw_suff}-mingwarm64-${_realname}") _build "aarch64-w64-mingw32" ;;
    esac
  done
}

package_mingw-w64-cross-zlib() {
  pkgdesc+=" (meta package, for backward compatibility)"
  depends=("${_targetpkgs[@]}")
}

package_mingw-w64-cross-ucrt64-zlib() {
  conflicts=("${_mingw_suff}-zlib<=1.3.1-1")

  _package x86_64-w64-mingw32ucrt
}

package_mingw-w64-cross-mingw32-zlib() {
  conflicts=("${_mingw_suff}-zlib<=1.3.1-1")

  _package i686-w64-mingw32
}

package_mingw-w64-cross-mingw64-zlib() {
  conflicts=("${_mingw_suff}-zlib<=1.3.1-1")

  _package x86_64-w64-mingw32
}

package_mingw-w64-cross-mingwarm64-zlib() {
  conflicts=("${_mingw_suff}-zlib<=1.3.1-1")

  _package aarch64-w64-mingw32
}
