# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='IO-Stringy'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
provides=(perl-io-stringy)
conflicts=(perl-io-stringy)
replaces=(perl-io-stringy)
pkgver=2.113
pkgrel=4
pkgdesc="I/O on in-core objects like strings and arrays"
arch=('any')
url="https://metacpan.org/dist/IO-Stringy"
msys2_references=(
  'purl: pkg:cpan/CAPOEIRAB/IO-Stringy'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/C/CA/CAPOEIRAB/${_perlname}-${pkgver}.tar.gz")
sha256sums=('51220fcaf9f66a639b69d251d7b0757bf4202f4f9debd45bdd341a6aca62fe4e')

build() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd  "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"

  find ${pkgdir} -name '.packlist' -delete
  find ${pkgdir} -name '*.pod' -delete
}
