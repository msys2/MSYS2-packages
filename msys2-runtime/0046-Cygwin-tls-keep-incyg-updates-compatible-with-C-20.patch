From 1b69c2d5ae56fbf24b9336bd15aeb4e898e9b305 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Tue, 27 Oct 2026 12:48:17 +0100
Subject: [PATCH 46/N] Cygwin: tls: keep incyg updates compatible with C++20

GCC 16 defaults to C++20, which deprecates volatile increment and
decrement expressions. The TLS `incyg` updates fail under
`-Werror=volatile` when the configured `-Wno-error=volatile` override is
omitted.

Restore compilation while retaining the counter's volatile qualification
and existing synchronization semantics. Only the target thread adjusts
`incyg`; the memory-ordering questions raised in the discussion are a
separate concern, not something to resolve incidentally in this
compiler-compatibility change.

Addresses: https://inbox.sourceware.org/cygwin-developers/7ae045b2-3d29-4c7e-960f-f5e136d77b5d@dronecode.org.uk/
Assisted-by: GPT-6.1 Sol
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 winsup/cygwin/dcrt0.cc      | 6 +++---
 winsup/cygwin/exceptions.cc | 4 ++--
 winsup/cygwin/signal.cc     | 2 +-
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/winsup/cygwin/dcrt0.cc b/winsup/cygwin/dcrt0.cc
index 33cad1e..7c8a60b 100644
--- a/winsup/cygwin/dcrt0.cc
+++ b/winsup/cygwin/dcrt0.cc
@@ -814,7 +814,7 @@ dll_crt0_1 (void *)
 {
   extern void initial_setlocale ();
 
-  _my_tls.incyg++;
+  _my_tls.incyg = _my_tls.incyg + 1;
   /* Inherit "parent" exec'ed process sigmask */
   if (spawn_info && __in_forkee != FORKING)
     _my_tls.sigmask = spawn_info->sigmask;
@@ -987,7 +987,7 @@ dll_crt0_1 (void *)
     {
       /* Handle any signals which may have arrived */
       _my_tls.call_signal_handler ();
-      _my_tls.incyg--;	/* Not in Cygwin anymore */
+      _my_tls.incyg = _my_tls.incyg - 1;	/* Not in Cygwin anymore */
     }
   else
     {
@@ -1012,7 +1012,7 @@ dll_crt0_1 (void *)
       /* Handle any signals which may have arrived */
       sig_dispatch_pending (false);
       _my_tls.call_signal_handler ();
-      _my_tls.incyg--;	/* Not in Cygwin anymore */
+      _my_tls.incyg = _my_tls.incyg - 1;	/* Not in Cygwin anymore */
       cygwin_exit (user_data->main (__argc, newargv, environ));
     }
   __asm__ ("				\n\
diff --git a/winsup/cygwin/exceptions.cc b/winsup/cygwin/exceptions.cc
index 131fe4f..9d724c2 100644
--- a/winsup/cygwin/exceptions.cc
+++ b/winsup/cygwin/exceptions.cc
@@ -826,7 +826,7 @@ exception::handle (EXCEPTION_RECORD *e, exception_list *frame, CONTEXT *in,
      undefined so we just set those to the faulting instruction too.  */
   si.si_addr = (si.si_signo == SIGSEGV || si.si_signo == SIGBUS)
 	       ? (void *) e->ExceptionInformation[1] : (void *) in->_CX_instPtr;
-  me.incyg++;
+  me.incyg = me.incyg + 1;
   sig_send (NULL, si, &me);	/* Signal myself */
   if ((NTSTATUS) e->ExceptionCode == STATUS_STACK_OVERFLOW)
     {
@@ -841,7 +841,7 @@ exception::handle (EXCEPTION_RECORD *e, exception_list *frame, CONTEXT *in,
       global_sigs[SIGSEGV].sa_handler = SIG_DFL;
       sig_send (NULL, si, &me);
     }
-  me.incyg--;
+  me.incyg = me.incyg - 1;
   e->ExceptionFlags = 0;
   return ExceptionContinueExecution;
 }
diff --git a/winsup/cygwin/signal.cc b/winsup/cygwin/signal.cc
index f8ba67e..2f543bb 100644
--- a/winsup/cygwin/signal.cc
+++ b/winsup/cygwin/signal.cc
@@ -398,7 +398,7 @@ killpg (pid_t pgrp, int sig)
 extern "C" void
 abort (void)
 {
-  _my_tls.incyg++;
+  _my_tls.incyg = _my_tls.incyg + 1;
   sig_dispatch_pending ();
   /* Ensure that SIGABRT can be caught regardless of blockage. */
   sigset_t sig_mask;
