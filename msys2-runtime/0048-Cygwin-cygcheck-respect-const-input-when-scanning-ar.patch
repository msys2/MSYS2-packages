From 5aa742e6c91ef25c6d0c46262f8c7050f27a9ae2 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Tue, 27 Oct 2026 13:10:54 +0100
Subject: [PATCH 48/N] Cygwin: cygcheck: respect const input when scanning
 archive suffixes

Newer GCC versions reject a const-discarding pointer conversion in
`find_tar_ext()`.

Honor the read-only contract rather than casting away `const` or
relaxing strict type checks. The scan only searches and computes pointer
differences, so the archive-suffix algorithm remains unchanged.

Assisted-by: GPT-6.1 Sol
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 winsup/utils/mingw/dump_setup.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/winsup/utils/mingw/dump_setup.cc b/winsup/utils/mingw/dump_setup.cc
index 050679a..78c97bc 100644
--- a/winsup/utils/mingw/dump_setup.cc
+++ b/winsup/utils/mingw/dump_setup.cc
@@ -40,7 +40,7 @@ typedef struct
 static int
 find_tar_ext (const char *path)
 {
-  char *p = strchr (path, '\0') - 9;
+  const char *p = strchr (path, '\0') - 9;
   if (p <= path)
     return 0;
   if ((p = strstr (p, ".tar")) != NULL)
