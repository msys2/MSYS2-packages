From efa00353dea2138e6a92f7a6731bc89b0e811824 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Tue, 27 Oct 2026 13:23:16 +0100
Subject: [PATCH 51/N] Cygwin: cygcheck: keep application-path separator
 scanning const-correct

The build fails with newer GCC versions because the separator scan stores a
pointer into the read-only path returned by find_app_on_path() in a mutable
pointer.

Preserve the input's constness. The separator is only checked for NULL and used
to compute an offset, while path construction uses a separate mutable buffer,
anyway. This fixes the type mismatch without changing path resolution.

Assisted-by: GPT-6.1 Sol
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 winsup/utils/mingw/cygcheck.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/winsup/utils/mingw/cygcheck.cc b/winsup/utils/mingw/cygcheck.cc
index b5994e7..f1e321d 100644
--- a/winsup/utils/mingw/cygcheck.cc
+++ b/winsup/utils/mingw/cygcheck.cc
@@ -978,7 +978,7 @@ cygcheck (const char *app)
     }
 
   char *s;
-  char *sep = strpbrk (papp, ":/\\");
+  const char *sep = strpbrk (papp, ":/\\");
   if (!sep)
     {
       static char dot[] = ".";
