From ee5bd4f20d3e5aeaf488683569c962c806efb6e1 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Tue, 27 Oct 2026 12:53:18 +0100
Subject: [PATCH 47/N] Cygwin: fork: avoid deprecated volatile parameters

GCC 16's C++20 default makes top-level volatile parameter qualifiers
fatal under -Werror=volatile. Allow strict builds without weakening the
stack-related qualifications.

`frok::child` does not use its parameter, while `frok::parent` only reads
it as a stack address, never modifying it or taking its address. Neither
needs a volatile pointer object. The pointed-to volatility and the local
`stackp` qualification around `setjmp` are separate and remain intact.

Addresses: https://inbox.sourceware.org/cygwin-developers/7ae045b2-3d29-4c7e-960f-f5e136d77b5d@dronecode.org.uk/
Assisted-by: GPT-6.1 Sol
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 winsup/cygwin/fork.cc | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/winsup/cygwin/fork.cc b/winsup/cygwin/fork.cc
index 2aa5273..3a9d2b6 100644
--- a/winsup/cygwin/fork.cc
+++ b/winsup/cygwin/fork.cc
@@ -44,8 +44,8 @@ class frok
   int child_pid;
   int this_errno;
   HANDLE hchild;
-  int parent (volatile char * volatile here);
-  int child (volatile char * volatile here);
+  int parent (volatile char *here);
+  int child (volatile char *here);
   bool error (const char *fmt, ...);
   friend int dofork (void **proc, bool *with_forkables);
 };
@@ -132,7 +132,7 @@ child_info::prefork (bool detached)
 }
 
 int
-frok::child (volatile char * volatile here)
+frok::child (volatile char *here)
 {
   HANDLE& hParent = ch.parent;
 
@@ -203,7 +203,7 @@ frok::child (volatile char * volatile here)
 }
 
 int
-frok::parent (volatile char * volatile stack_here)
+frok::parent (volatile char *stack_here)
 {
   HANDLE forker_finished;
   DWORD rc;
