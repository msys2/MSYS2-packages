# Maintainer: micbou <contact@micbou.com>

pkgname='pass'
pkgver=1.7.4
pkgrel=2
pkgdesc='Stores, retrieves, generates, and synchronizes passwords securely'
arch=('any')
url='https://www.passwordstore.org'
msys2_references=(
  "cpe: cpe:/a:zx2c4:password-store"
)
license=('spdx:GPL-2.0-or-later')
depends=(
  'bash'
  'gnupg'
  'tree'
)
optdepends=(
  'git: Git support'
  'libqrencode: QR Code support'
)
source=(
  "https://git.zx2c4.com/password-store/snapshot/password-store-${pkgver}.tar.xz"
  'msys.sh'
)
sha256sums=('4c2d0a8b99df8915a87099607a8d912fd05d30651b6f014745c14e4ca8dbbfb7'
            '1d25ab821516e1838f01bfd0ec6c96c5506633855862e3ce988fc7d0cbc3fdba')

package() {
  cd "${srcdir}/password-store-${pkgver}"
  install -Dm644 "${srcdir}/msys.sh" src/platform/ # Excerpted from src/platform/cygwin.sh
  make DESTDIR=${pkgdir} WITH_ALLCOMP=yes install
}
