# Maintainer: Andrea Dalle Vacche

_perlname='ExtUtils-MakeMaker'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=7.68
pkgrel=4
pkgdesc="ExtUtils::MakeMaker - Create a module Makefile"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/release/ExtUtils-MakeMaker"
msys2_references=(
  "purl: pkg:cpan/BINGOS/ExtUtils-MakeMaker"
)
depends=('perl')
groups=('perl-modules')
provides=("perl-ExtUtils-MakeMaker=${pkgver}")
conflicts=('perl-ExtUtils-MakeMaker')
replaces=('perl-ExtUtils-MakeMaker')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/B/BI/BINGOS/${_perlname}-${pkgver}.tar.gz)
sha256sums=('270238d253343b833daa005fb57a3a5d8916b59da197698a632b141e7acad779')

prepare() {
  cd ${_perlname}-${pkgver}
}

build() {
  cd ${_perlname}-${pkgver}
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
