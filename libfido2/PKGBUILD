# Contributor: Karol Babioch <karol@babioch.de>

pkgbase=libfido2
pkgname=("${pkgbase}" "fido2-tools" "${pkgbase}-devel" "${pkgbase}-docs")
pkgver=1.17.0
pkgrel=2
pkgdesc="Library functionality for FIDO 2.0, including communication with a device over USB"
arch=('i686' 'x86_64' 'aarch64')
url="https://developers.yubico.com/libfido2/"
msys2_repository_url="https://github.com/Yubico/libfido2"
license=('spdx:BSD-2-Clause')
depends=("libcbor" "openssl" "zlib")
makedepends=("libcbor-devel" "openssl-devel" "cmake" "gcc" "zlib-devel" "ninja")
source=("https://developers.yubico.com/libfido2/Releases/libfido2-${pkgver}.tar.gz"{,.sig}
        msys2-fix-ln.diff)
sha256sums=('c1012c8871d71b65872fd5ff1a9d6b0838a55683a03e85ba97479ce57129c736'
            'SKIP'
            '3134757a26e80eb1917036d4402551fa517e4e0e678c54dcf6c166b714de2bf2')
# https://developers.yubico.com/Software_Projects/Software_Signing.html
validpgpkeys=(
  '1D7308B0055F5AEF36944A8F27A9C24D9588EA0F' # Aveen Ismail <aveen.ismail@yubico.com>
  '7FBB6186957496D58C751AC20E777DD85755AA4A' # Konstantinos Georgantas <kostas@yubico.com>
  '78D997D53E9C0A2A205392ED14A19784723C9988' # Ludvig Michaelsson <ludvig.michaelsson@yubico.com>
)

prepare() {
  cd ${pkgname}-${pkgver}
  patch -p1 -i ${srcdir}/msys2-fix-ln.diff
}

build() {
  if [[ ${CARCH} == aarch64 || -n ${MSYS2_ARM64_CROSS:-} ]]; then
    # Cross-build for aarch64-pc-cygwin, same shape as the libcbor recipe:
    # CMAKE_SYSTEM_NAME is what switches cmake into cross mode, and MSYS (not
    # CYGWIN) is what makes the platform module emit the msys- DLL prefix.
    #
    # Two root paths, not one: the libcbor/openssl/zlib we cross-built live
    # under .../usr, but the w32api headers libfido2 needs for USE_WINHELLO
    # (webauthn.h) sit one level up in .../include/w32api.  With only the
    # first, the WinHello backend fails to configure.
    # libfido2 builds with -Werror and only defines OPENSSL_API_COMPAT --
    # which is what silences the OpenSSL 3.0 deprecation warnings -- when
    # CRYPTO_VERSION is set, and that comes from pkg-config.  Without the
    # sysroot pointers below pkg-config finds nothing, CRYPTO_VERSION is
    # empty, the guard never fires and every HMAC_/EC_KEY_ call is a fatal
    # deprecation error.  SYSROOT_DIR is needed too: the .pc files say
    # prefix=/usr, which would otherwise resolve to the host's /usr.
    export PKG_CONFIG_LIBDIR=/usr/aarch64-pc-cygwin/usr/lib/pkgconfig
    export PKG_CONFIG_SYSROOT_DIR=/usr/aarch64-pc-cygwin
    # USE_WINHELLO=OFF on aarch64 only.  With the Windows Hello backend built
    # in, fido_dev_info_manifest() aborts with "stack smashing detected" as
    # soon as it enters the webauthn path, so device enumeration -- and so
    # every -sk key operation -- is unusable.  Established by bisection:
    #   - identical crash at -O0, so not a codegen/optimisation artifact
    #   - the same source built natively for x86_64 on this machine is fine
    #     (finds the winhello device, exit 0), so it is aarch64-specific
    #   - the SetupAPI/HID enumeration is clean; a standalone replica of
    #     hid_ok() and of the DLL's eight __thread variables both run fine,
    #     including LoadLibraryEx(webauthn.dll) + WebAuthNGetApiVersionNumber
    #   - USE_WINHELLO=OFF makes fido2-token -L exit 0
    # Native i686/x86_64 keep the backend.  Re-enable once the winhello path
    # is fixed; the FIDO/U2F HID support openssh -sk keys use is unaffected.
    # -static-libgcc because the cross GCC's shared libgcc, cyggcc_s-seh-1.dll,
    # is not part of the runtime we ship: linking against it gives a DLL that
    # builds cleanly and then fails to load.  No other package in this series
    # pulls it in.
    # CMAKE_RC_COMPILER must be set explicitly: cmake does not derive the
    # resource compiler from the C compiler, so it would use the host
    # /usr/bin/windres and version.rc.obj would come out an x86-64 COFF that
    # the aarch64 linker refuses ("file format not recognized").
    cmake \
      -GNinja \
      -S "${pkgname}-${pkgver}" \
      -B build \
      -DCMAKE_SYSTEM_NAME=MSYS \
      -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
      -DCMAKE_C_COMPILER=aarch64-pc-cygwin-gcc \
      -DCMAKE_RC_COMPILER=aarch64-pc-cygwin-windres \
      -DCMAKE_FIND_ROOT_PATH="/usr/aarch64-pc-cygwin/usr;/usr/aarch64-pc-cygwin" \
      -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
      -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
      -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/aarch64-pc-cygwin/lib/w32api -static-libgcc" \
      -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/aarch64-pc-cygwin/lib/w32api -static-libgcc" \
      -DBUILD_TESTS=OFF \
      -DUSE_WINHELLO=OFF
    cmake --build build
    DESTDIR="${srcdir}/dest" cmake --install build
    return
  fi

  cmake \
    -GNinja \
    -S "${pkgname}-${pkgver}" \
    -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DUSE_WINHELLO=ON
  cmake --build build
  DESTDIR="${srcdir}/dest" cmake --install build
}

package_libfido2() {
  groups=("libraries")

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/*.dll ${pkgdir}/usr/bin/
}

package_fido2-tools() {
  pkgdesc="FIDO2 command line tools to access and configure a FIDO2 compliant authentication device"
  depends=("$pkgbase=$pkgver")

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/*.exe ${pkgdir}/usr/bin/
  mkdir -p ${pkgdir}/usr/share/man
  cp -rf ${srcdir}/dest/usr/share/man/man1 ${pkgdir}/usr/share/man
}

package_libfido2-devel() {
  pkgdesc="Development headers and library for libfido2"
  depends=("$pkgbase=$pkgver")
  groups=("development")

  mkdir -p ${pkgdir}/usr/lib
  cp -rf ${srcdir}/dest/usr/include ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/lib/pkgconfig ${pkgdir}/usr/lib/ 
  cp -f ${srcdir}/dest/usr/lib/*.a ${pkgdir}/usr/lib
}

package_libfido2-docs() {
  pkgdesc="Documentation for libfido2"
  depends=("libfido2-devel=$pkgver")  

  mkdir -p ${pkgdir}/usr/share/man
  cp -rf ${srcdir}/dest/usr/share/man/man3 ${pkgdir}/usr/share/man
}
