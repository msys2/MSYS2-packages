diff --git a/libstdc++-v3/crossconfig.m4 b/libstdc++-v3/crossconfig.m4
--- a/libstdc++-v3/crossconfig.m4
+++ b/libstdc++-v3/crossconfig.m4
@@ -197,6 +197,10 @@
     AC_CHECK_FUNCS(aligned_alloc posix_memalign memalign _aligned_malloc)
     AC_CHECK_FUNCS(_wfopen)
     GCC_CHECK_TLS
+    dnl The MinGW-w64 CRT provides this in libmingw32.a. Cross builds do not
+    dnl run the native link check, so do not build libstdc++'s atexit fallback
+    dnl (which runs TLS destructors after executable global destructors).
+    AC_DEFINE(HAVE___CXA_THREAD_ATEXIT)
     ;;
   *-netbsd* | *-openbsd*)
     SECTION_FLAGS='-ffunction-sections -fdata-sections'
 diff --git a/libstdc++-v3/configure b/libstdc++-v3/configure
--- a/libstdc++-v3/configure
+++ b/libstdc++-v3/configure
@@ -46102,6 +46102,9 @@
 $as_echo "#define HAVE_TLS 1" >>confdefs.h
 
   fi
+
+$as_echo "#define HAVE___CXA_THREAD_ATEXIT 1" >>confdefs.h
+
     ;;
   *-netbsd* | *-openbsd*)
     SECTION_FLAGS='-ffunction-sections -fdata-sections'
