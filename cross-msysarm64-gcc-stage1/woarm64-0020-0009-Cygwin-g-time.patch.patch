From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Radek=20Barto=C5=88?= <radek.barton@microsoft.com>
Date: Tue, 3 Dec 2024 14:56:14 +0100
Subject: [PATCH 20/29] 0009-Cygwin-g-time.patch

(cherry picked from commit 1a49a66e8161da7814feae00644c6e1a9071db7a)
---
 libstdc++-v3/acinclude.m4 | 3 +++
 libstdc++-v3/configure    | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/libstdc++-v3/acinclude.m4 b/libstdc++-v3/acinclude.m4
index 8c44e618cb8..966e34d9694 100644
--- a/libstdc++-v3/acinclude.m4
+++ b/libstdc++-v3/acinclude.m4
@@ -1765,7 +1765,10 @@ AC_DEFUN([GLIBCXX_ENABLE_LIBSTDCXX_TIME], [
 
     case "${target_os}" in
       cygwin*)
+        ac_has_clock_monotonic=yes
+        ac_has_clock_realtime=yes
         ac_has_nanosleep=yes
+        ac_has_sched_yield=yes
         ;;
       mingw*)
         ac_has_win32_sleep=yes
diff --git a/libstdc++-v3/configure b/libstdc++-v3/configure
index 577640fcb75..e291a9b18c6 100755
--- a/libstdc++-v3/configure
+++ b/libstdc++-v3/configure
@@ -21453,7 +21453,10 @@ ac_compiler_gnu=$ac_cv_cxx_compiler_gnu
 
     case "${target_os}" in
       cygwin*)
+        ac_has_clock_monotonic=yes
+        ac_has_clock_realtime=yes
         ac_has_nanosleep=yes
+        ac_has_sched_yield=yes
         ;;
       mingw*)
         ac_has_win32_sleep=yes
