From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Radek=20Barto=C5=88?= <radek.barton@microsoft.com>
Date: Tue, 3 Dec 2024 14:55:50 +0100
Subject: [PATCH 18/29] 0007-Cygwin-__cxa-atexit.patch

(cherry picked from commit 07a9d4834f253de957eaccfe34aefcef432388ec)
---
 gcc/config.gcc                        | 2 ++
 libgcc/config/i386/cygming-crtbegin.c | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/gcc/config.gcc b/gcc/config.gcc
index 0913dd8d98b..8989a4d0872 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -2227,6 +2227,7 @@ i[34567]86-*-cygwin*)
 	fi
 	default_use_cxa_atexit=yes
 	use_gcc_stdint=wrap
+	default_use_cxa_atexit=yes
 	;;
 x86_64-*-cygwin*)
 	need_64bit_isa=yes
@@ -2861,6 +2862,7 @@ mipstx39-*-elf* | mipstx39el-*-elf*)
 mmix-knuth-mmixware)
 	tm_file="${tm_file} newlib-stdint.h"
 	use_gcc_stdint=wrap
+	default_use_cxa_atexit=yes
 	;;
 mn10300-*-*)
 	tm_file="elfos.h newlib-stdint.h ${tm_file}"
diff --git a/libgcc/config/i386/cygming-crtbegin.c b/libgcc/config/i386/cygming-crtbegin.c
index a0682fca1b5..b52626561a8 100644
--- a/libgcc/config/i386/cygming-crtbegin.c
+++ b/libgcc/config/i386/cygming-crtbegin.c
@@ -146,7 +146,11 @@ __gcc_register_frame (void)
   /* If we use the __cxa_atexit method to register C++ dtors
      at object construction,  also use atexit to register eh frame
      info cleanup.  */
+#ifdef __CYGWIN__
+  __cxa_atexit(__gcc_deregister_frame, NULL, (void *)&__dso_handle);
+#else
   atexit(__gcc_deregister_frame);
+#endif /* __CYGWIN__ */
 #endif /* DEFAULT_USE_CXA_ATEXIT */
 }
 
