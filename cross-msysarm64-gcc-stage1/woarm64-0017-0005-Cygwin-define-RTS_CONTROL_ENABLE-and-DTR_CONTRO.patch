 gcc/ada/s-oscons-tmplt.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/gcc/ada/s-oscons-tmplt.c b/gcc/ada/s-oscons-tmplt.c
index cb2e05f6aae..1f33e902942 100644
--- a/gcc/ada/s-oscons-tmplt.c
