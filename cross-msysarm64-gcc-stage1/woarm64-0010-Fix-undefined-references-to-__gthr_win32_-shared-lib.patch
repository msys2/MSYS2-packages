+++ b/libgcc/config.host
@@ -487,7 +487,7 @@ aarch64-*-mingw*)
 	fi
 	tmake_file="${tmake_file} ${tmake_eh_file} ${tmake_thr_file} ${tmake_dlldir_file}"
 	tmake_file="${tmake_file} t-dfprules"
