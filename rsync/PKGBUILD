# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=rsync
pkgver=3.5.2
pkgrel=1
pkgdesc="A file transfer program to keep remote files in sync"
arch=('i686' 'x86_64')
url="https://rsync.samba.org"
msys2_repository_url='https://github.com/RsyncProject/rsync'
msys2_references=(
  "anitya: 4217"
  "cpe: cpe:2.3:a:andrew_tridgell:rsync"
  "cpe: cpe:2.3:a:gnu:rsync"
  "cpe: cpe:2.3:a:redhat:rsync"
  "cpe: cpe:2.3:a:rsync:rsync"
  "cpe: cpe:2.3:a:samba:rsync"
)
groups=('net-utils')
license=('spdx:GPL-3.0-or-later')
depends=(
  'libiconv'
  'libidn2'
  'liblz4'
  'libopenssl'
  'libxxhash'
  'libzstd'
  'popt'
)
optdepends=(
  'python: for rrsync'
)
makedepends=(
  'autotools'
  'gcc'
  'libiconv-devel'
  'libidn2-devel'
  'liblz4-devel'
  'libxxhash-devel'
  'libzstd-devel'
  'openssl-devel'
  'popt-devel'
)
conflicts=('rsync2')
replaces=('rsync2')
source=("https://download.samba.org/pub/rsync/src/${pkgname}-${pkgver}.tar.gz"
        'cygwin-fchmod-writable-handle.patch')
noextract=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('a10d591825251e070f74c98df3daad195def4ed81b4a2de16169026aea33f6c8'
            '56c6f1a68db7752952687216f673d6911b56e1760e33e28a2c79a06a764f9c66')

prepare() {
  tar zxf "${pkgname}-${pkgver}.tar.gz" || tar zxf "${pkgname}-${pkgver}.tar.gz"
  cd "${srcdir}/${pkgname}-${pkgver}"

  # https://github.com/msys2/msys2-runtime/issues/374
  # https://github.com/msys2/MSYS2-packages/issues/6555
  patch -p1 -i "${srcdir}/cygwin-fchmod-writable-handle.patch"

  autoreconf -fiv
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --build=${CHOST} \
    --prefix=/usr

  make reconfigure
  make man all
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm755 support/rrsync "${pkgdir}/usr/lib/rsync/rrsync"

  install -Dm644 ${srcdir}/${pkgname}-${pkgver}/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
}
