# Maintainer: poxu <poxvuibr@gmail.com>

pkgname='pv'
pkgver=1.12.0
pkgrel=1
pkgdesc='Pipe viewer'
arch=('i686' 'x86_64')
url='https://www.ivarch.com/programs/pv.shtml'
msys2_repository_url='https://codeberg.org/ivarch/pv'
msys2_changelog_url='https://codeberg.org/ivarch/pv/src/branch/main/docs/NEWS.md'
msys2_references=(
  'anitya: 3736'
  'archlinux: pv'
  'gentoo: sys-apps/pv'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  'libintl'
)
makedepends=(
  'autotools'
  'gcc'
  'gettext-devel'
)
source=("https://www.ivarch.com/programs/sources/${pkgname}-${pkgver}.tar.gz")
sha256sums=('31fdbdb449c7143cd2968567bef7599e9f031950e6158ee7bb76e40aebf6ffb8')

build() {
  mkdir -p "build-${CHOST}" && cd "build-${CHOST}"

  "../${pkgname}-${pkgver}/configure" \
    --prefix=/usr \
    --build="${CHOST}" \
    --host="${CHOST}"

  make
}

check() {
  cd "build-${CHOST}"

  make test
}

package() {
  cd "build-${CHOST}"

  make DESTDIR="${pkgdir}" install
}
