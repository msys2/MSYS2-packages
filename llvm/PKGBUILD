_url=https://github.com/llvm/llvm-project/releases/download/${_tag}
_pkgfn=llvm-project-${_version}${_rc}.src
source=("${_url}/${_pkgfn}.tar.xz"{,.sig}
        "0001-hack-tablegentest.patch"
