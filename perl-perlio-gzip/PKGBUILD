# Maintainer: Mark Sikora <marknsikora@gmail.com>

_perlname='PerlIO-gzip'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.20
pkgrel=8
pkgdesc="Perl extension to provide a PerlIO layer to gzip/gunzip"
arch=('i686' 'x86_64')
url="https://metacpan.org/release/PerlIO-gzip"
msys2_references=(
  'purl: pkg:cpan/NWCLARK/PerlIO-gzip'
)
groups=('perl-modules')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl' 'zlib')
makedepends=('perl-devel' 'zlib-devel' 'make' 'gcc')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/N/NW/NWCLARK/${_perlname}-${pkgver}.tar.gz")
sha256sums=('4848679a3f201e3f3b0c5f6f9526e602af52923ffa471a2a3657db786bd3bdc5')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
