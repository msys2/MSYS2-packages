# Maintainer: Andrea Dalle Vacche

_perlname='Date-Calc'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=6.4
pkgrel=3
pkgdesc="Date::Calc - Gregorian calendar date calculations"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Date-Calc"
msys2_references=(
  "purl: pkg:cpan/STBEY/Date-Calc"
)
depends=('perl')
groups=('perl-modules')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/S/ST/STBEY/${_perlname}-${pkgver}.tar.gz)
sha256sums=('7ce137b2e797b7c0901f3adf1a05a19343356cd1f04676aa1c56a9f624f859ad')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
