# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

_realname='Sub-Exporter'
pkgname="perl-${_realname}"
pkgver=0.992
pkgrel=1
pkgdesc='A sophisticated exporter for custom-built routines'
arch=('any')
url='https://metacpan.org/dist/Sub-Exporter'
msys2_repository_url='https://github.com/rjbs/Sub-Exporter'
msys2_changelog_url='https://metacpan.org/dist/Sub-Exporter/changes'
msys2_references=(
  'anitya: 11900'
  'archlinux: perl-sub-exporter'
  'gentoo: dev-perl/Sub-Exporter'
  'purl: pkg:cpan/RJBS/Sub-Exporter'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  'perl'
  'perl-Data-OptList'
  'perl-Params-SomeUtil'
  'perl-Sub-Install'
)
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_realname}-${pkgver}.tar.gz")
sha512sums=('1856b27b7190451737d9a260ba36aa3808fdc90a70e6cfa2aca42afd4b8b8a128c4ff0179e1658b16f6feaf1bbee237d7ac6161d2b20a89442c3966521670696')

build() {
  cd "${_realname}-${pkgver}"

  PERL_MM_USE_DEFAULT=1 \
  PERL_AUTOINSTALL=--skipdeps \
  PERL5LIB="" \
  MODULEBUILDRC=/dev/null \
  PERL_MM_OPT="INSTALLDIRS=vendor" \
  PERL_MB_OPT="--installdirs vendor" \
  perl Makefile.PL

  make
}

package() {
  cd "${_realname}-${pkgver}"

  make install DESTDIR="${pkgdir}"
}
