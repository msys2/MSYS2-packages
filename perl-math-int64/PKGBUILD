# Maintainer: Andrea Dalle Vacche adallevacche@bloomberg.net

_perlname='Math-Int64'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=0.57
pkgrel=4
pkgdesc="Math::Int64 - Manipulate 64 bits integers in Perl"
arch=('i686' 'x86_64')
url="https://metacpan.org/dist/Math-Int64"
msys2_references=(
  'anitya: 5963'
  'aur: perl-math-int64'
  'cygwin:' # ignore perl-Math-Int64-src bad versioning
  'purl: pkg:cpan/SALVA/Math-Int64'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  'perl'
)
makedepends=(
  'perl-devel'
  'make'
  'gcc'
)
groups=('perl-modules')
provides=("perl-Math-Int64=${pkgver}")
conflicts=('perl-Math-Int64')
replaces=('perl-Math-Int64')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/S/SA/SALVA/${_perlname}-${pkgver}.tar.gz")
sha256sums=('12c60111c1cfceb257ac2ccc5b2e1721879efa09a1b0a73e8836afca107a7d75')

build() {
  cd "${_perlname}-${pkgver}"

  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

  make
}

check() {
  cd "${_perlname}-${pkgver}"

  make test
}

package() {
  cd "${_perlname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
