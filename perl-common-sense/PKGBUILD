# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='common-sense'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=3.75
pkgrel=3
pkgdesc="Implements some sane defaults for Perl programs"
arch=('any')
groups=('perl-modules')
url="https://metacpan.org/release/common-sense"
msys2_references=(
  "purl: pkg:cpan/MLEHMANN/common-sense"
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://www.cpan.org/authors/id/M/ML/MLEHMANN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('a86a1c4ca4f3006d7479064425a09fa5b6689e57261fcb994fe67d061cba0e7e')

build() {
  cd "${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${_perlname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
