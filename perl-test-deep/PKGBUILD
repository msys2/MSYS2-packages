# Maintainer: Peter Budai <peterbudai@hotmail.com>

_perlname='Test-Deep'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.205
pkgrel=2
pkgdesc="Extremely flexible deep comparison"
arch=('any')
url="https://metacpan.org/dist/Test-Deep"
msys2_references=(
  'purl: pkg:cpan/RJBS/Test-Deep'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl' 'perl-Test-Simple' 'perl-Test-NoWarnings')
options=('!emptydirs')
groups=('perl-modules')
source=("https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('42781e9943a7a215e662c4973b9feafdc019fd16469bdb849a8537ee58956273')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL installdirs=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
