From 60603cb05b6a8f7f92b5c3759ccfc54a8c559c12 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Tue, 15 Sep 2026 19:10:24 +0200
Subject: [PATCH 4/N] tests: preserve C-locale byte coverage under DOS text
 handling

The raw-byte check fails on CR because the appended LF forms CRLF, which
restored DOS text handling correctly treats as an empty line.

This check needs binary mode to retain full byte coverage without weakening the
restored default behavior.

Assisted-by: GPT-6
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 tests/c-locale | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/c-locale b/tests/c-locale
index c8248a54..f7109a4a 100755
--- a/tests/c-locale
+++ b/tests/c-locale
@@ -16,7 +16,7 @@ while test $c -lt 256; do
   tr2=$(printf '\\%o\n' $c)
   echo X | tr X "$tr2" >in
   if test $(wc -l <in) -eq 1; then
-    grep . in >out || fail=1
+    grep -U . in >out || fail=1
     compare in out || fail=1
   fi
   test $fail -ne 0 && Exit $fail
