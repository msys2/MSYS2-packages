# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_perlname='Alien-Build-Plugin-Download-GitLab'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=0.01
pkgrel=2
pkgdesc="Alien::Build plugin to download from GitLab"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/release/${_perlname}"
msys2_references=(
  'purl: pkg:cpan/PLICEASE/Alien-Build-Plugin-Download-GitLab'
)
groups=('perl-modules')
depends=('perl-alien-build' 'perl-path-tiny' 'perl-uri')
makedepends=('perl-test2-suite')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('c1f089c8ea152a789909d48a83dbfcf2626f773daf30431c8622582b26aba902')

build() {
  cd "${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${_perlname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
