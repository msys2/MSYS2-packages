# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=sed
pkgver=4.10
pkgrel=1
pkgdesc="GNU stream editor"
arch=('i686' 'x86_64')
url="https://www.gnu.org/software/sed"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/sed.git'
msys2_references=(
  'anitya: 4789'
  'archlinux: sed'
  'cpe: cpe:/a:gnu:sed'
  'gentoo: sys-apps/sed'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  'libintl'
  'sh'
)
makedepends=(
  'autotools'
  'gcc'
  'gettext'
  'gettext-devel'
)
source=(
  "https://ftp.gnu.org/pub/gnu/sed/${pkgname}-${pkgver}.tar.xz"{,.sig}
  sed-4.4-1.src.patch
  sed-4.4-msys-use-text-mode.patch
)
sha256sums=('b8e72182b2ec96a3574e2998c47b7aaa64cc20ce000d8e9ac313cc07cecf28c7'
            'SKIP'
            '12525e7bf4a1b57913d4047a2313f9127f29468193c2b583cfdfa128b4141032'
            'a6cf37f31c11f5fbc6d11fb379a3feabdcbe0606b69941d82449d106299ffbf6')
validpgpkeys=(
  '155D3FC500C834486D1EEA677FD9FCCB000BEEEE' # Jim Meyering <jim@meyering.net>
)

prepare() {
  cd "${pkgname}-${pkgver}"

  patch -Np1 -i "${srcdir}/sed-4.4-msys-use-text-mode.patch"
  autoreconf -fiv

  patch -Np2 -i "${srcdir}/sed-4.4-1.src.patch"
}

build() {
  cd "${pkgname}-${pkgver}"

  export gl_cv_have_weak=no

  ./configure \
    --prefix=/usr \
    --build=${CHOST}

  make all html
}

check() {
  cd "${pkgname}-${pkgver}"

  make check
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  rm -f "${pkgdir}/usr/lib/charset.alias"
}
