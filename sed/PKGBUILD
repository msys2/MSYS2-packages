# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=sed
pkgver=4.10
pkgrel=1
pkgdesc="GNU stream editor"
arch=('i686' 'x86_64')
url="https://www.gnu.org/software/sed"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/sed.git'
msys2_references=(
  "anitya: 4789"
  "cpe: cpe:/a:gnu:sed"
)
license=('spdx:GPL-3.0-or-later')
depends=('libintl')
makedepends=(
  'gcc'
  'gettext-devel'
  'texinfo'
)
source=(
  "https://ftp.gnu.org/pub/gnu/sed/${pkgname}-${pkgver}.tar.xz"{,.sig}
  'sed-4.4-msys-use-text-mode.patch'
  '0001-fix-test.patch'
)
sha256sums=('b8e72182b2ec96a3574e2998c47b7aaa64cc20ce000d8e9ac313cc07cecf28c7'
            'SKIP'
            'a6cf37f31c11f5fbc6d11fb379a3feabdcbe0606b69941d82449d106299ffbf6'
            'adf36877462911f234a90dac9d30727ceeffb5f842927b726970e9c259b12a22')
validpgpkeys=('155D3FC500C834486D1EEA677FD9FCCB000BEEEE')

prepare() {
  cd "${pkgname}-${pkgver}"

  patch -p1 -i ${srcdir}/sed-4.4-msys-use-text-mode.patch
  patch -p1 -i ${srcdir}/0001-fix-test.patch
}

build() {
  cd "${pkgname}-${pkgver}"

  export gl_cv_have_weak=no

  ./configure \
    --prefix=/usr

  make all html
}

check() {
  cd "${pkgname}-${pkgver}"

  # test-lstat, test-rename, test-stat-time failed
  # first two are symlink related, last one is ctime/mtime related
  make -k check || warning "Tests failed"
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR=${pkgdir} install
  rm -f ${pkgdir}/usr/lib/charset.alias
}
