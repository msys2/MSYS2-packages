# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Alien-Build'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=2.87
pkgrel=1
pkgdesc="Build external dependencies for use in CPAN"
arch=('any')
license=('spdx:Artistic-1.0-Perl' 'spdx:GPL-1.0-or-later')
url="https://metacpan.org/dist/Alien-Build"
msys2_changelog_url='https://metacpan.org/dist/Alien-Build/changes'
msys2_repository_url='https://github.com/PerlAlien/Alien-Build'
msys2_references=(
  'purl: pkg:cpan/PLICEASE/Alien-Build'
)
groups=('perl-modules')
depends=('perl-capture-tiny' 'perl-ffi-checklib' 'perl-file-chdir' 'perl-file-which' 'perl-path-tiny')
makedepends=('perl-test2-suite' 'perl-devel')
#checkdepends=('perl-alien-base-modulebuild' 'perl-alien-cmake3' 'perl-env-ShellWords'
#              'perl-pkgconfig' 'perl-pkgconfig-libpkgconf' 'perl-readonly' 'perl-sort-versions')
options=(!emptydirs)
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
options=(!emptydirs)
sha256sums=('b041d6e160fcad569bcc1bb314bbe1ea3679d0e5fd735f187a31bf77817e8254')

build() {
  cd "${_perlname}-${pkgver}"

  # install module in vendor directories.
  perl Makefile.PL -- INSTALLDIRS=vendor
  make
}

check() {
  cd "${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${_perlname}-${pkgver}"

  make install DESTDIR="${pkgdir}"
  # Remove .packlist and perllocal.pod files.
  find "$pkgdir" -name '.packlist' -delete
  find "$pkgdir" -name 'perllocal.pod' -delete
}
