# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='SGMLSpm'
_realname=sgmls
pkgname="perl-${_realname}"
pkgver=1.03ii
pkgrel=3
pkgdesc="A Post-Processor for SGMLS and NSGMLS"
arch=('any')
url="https://metacpan.org/dist/SGMLSpm"
msys2_references=(
  'purl: pkg:cpan/DMEGG/SGMLSpm'
)
license=('spdx:GPL-2.0-only')
groups=('perl-modules')
depends=('perl')
options=('!emptydirs' 'docs')
source=("https://cpan.metacpan.org/authors/id/D/DM/DMEGG/${_perlname}-${pkgver}.tar.gz")
sha256sums=('f06895c0206dada9f9e7f07ecaeb6a3651fd648f4820f49c1f76bfeaec2f2913')

prepare() {
  cd "$srcdir/${_perlname}"
  patch Makefile <<EOF
84a85
> 	find \${HTMLDIR} -type l -exec rm -f {} \;
EOF
}

package() {
  cd "$srcdir/${_perlname}"

  mkdir -p \
    "$pkgdir/usr/bin" \
    "$pkgdir/usr/lib/perl5/vendor_perl/SGMLS" \
    "$pkgdir/usr/share/doc/${pkgname}"

  make install install_html \
    BINDIR="$pkgdir/usr/bin" \
    PERL5DIR="$pkgdir/usr/lib/perl5/vendor_perl" \
    HTMLDIR="$pkgdir/usr/share/doc/${pkgname}"

  find "$pkgdir" -name '.packlist' -delete
  find "$pkgdir" -name '*.pod' -delete
}
