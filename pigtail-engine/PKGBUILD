# Maintainer: Pelagia-Applications <tayofatox@gmail.com>
_realname=Pigtail
pkgname="${MINGW_PREFIX}-pigtail-engine"
pkgver=0.1.0
pkgrel=1
shortdesc="A cross-platform game engine written in C++"
license=('MIT')

source=("git+https://github.com/Pelagia-Applications/Pigtail-Engine.git")
sha256sums=('SKIP')

prepare() {
  # Use $_realname to go into Pigtail
  cd "${srcdir}/"
  git config core.autocrlf false
}


build() {

  cd ..

  cmake -S . -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr

  cmake --build build
}

package() {
  cd ..
  
  # Ensure the target bin folder exists in the package structure
  install -d "${pkgdir}${MINGW_PREFIX}/bin"
  
  # Add the .exe extension and copy it to the package directory
  install -m755 "build/PigtailSandbox.exe" "${pkgdir}${MINGW_PREFIX}/bin/PigtailSandbox.exe"
}

