# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Archive-Zip'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.68
pkgrel=3
pkgdesc="Provide a perl interface to ZIP archive files"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/release/Archive-Zip"
msys2_references=(
  "purl: pkg:cpan/PHRED/Archive-Zip"
)
depends=('perl')
groups=('perl-modules')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/P/PH/PHRED/${_perlname}-${pkgver}.tar.gz)
sha256sums=('984e185d785baf6129c6e75f8eb44411745ac00bf6122fb1c8e822a3861ec650')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
