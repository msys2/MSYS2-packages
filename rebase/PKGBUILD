# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname='rebase'
pkgver=4.6.6
_ver="${pkgver//./-}"
pkgrel=1
pkgdesc='The Cygwin rebase distribution contains four utilities, rebase, rebaseall, peflags, and peflagsall'
arch=('i686' 'x86_64')
url='https://www.cygwin.com/'
msys2_references=(
  'archlinux:' # ignore
  'aur:' # ignore
  'cygwin: rebase'
  'gentoo:' # ignore sci-biology/rebase
)
license=('spdx:LicenseRef-Cygwin-rebase')
depends=(
  'dash'
)
makedepends=(
  'autotools'
  'coreutils'
  'gcc'
  'git'
  'grep'
  'gzip'
  'sed'
)
source=(
  "${pkgname}-${pkgver}::git://sourceware.org/git/cygwin-apps/rebase.git#tag=${pkgname}-${_ver}"
  '001-msys2.patch'
  '003-allow-non-database-mode-when-__CYGWIN__-__MSYS__.patch'
  '004-msys2-usr.patch'
  'autorebase.bat'
  'rebase.hook'
)
sha256sums=('ecad139ddc0c77e5d8e647543dbbaa9559f46b8e19a7fd2c59020ccea6ce9379'
            'bee918288d615c7a0257fcfe169c25ac80ff1e0f98a8d9215721823354f6e407'
            '3d716cb14dc1ef2fe4330da12b861065ff9d3a365d85ca0d01955cff277b4b72'
            '9583d4436de7b63c782ca1a273d43dc18a10c0957b632e13c7daaa7f91163cf6'
            '37fbcf495c90c41c98afcd0ce06aabbc727a65468e92960efd9d88c0e3f83330'
            'a50a8bfdb28c47c1742f400287a8a7ba65f9893dee74c109aad517d46afed2a1')

prepare() {
  cd "${pkgname}-${pkgver}"

  patch -Np1 -i "${srcdir}/001-msys2.patch"
  patch -Np1 -i "${srcdir}/003-allow-non-database-mode-when-__CYGWIN__-__MSYS__.patch"
  patch -Np1 -i "${srcdir}/004-msys2-usr.patch"

  autoreconf -fiv
}

build() {
  cd "${pkgname}-${pkgver}"

  # _WIN32_WINNT for WOF_EXTERNAL_INFO etc. used in rebase.c
  local _flags="-static -static-libgcc -Wno-error=unused-but-set-variable -D_WIN32_WINNT=0x0A00"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-posix-shell=/usr/bin/dash \
    CFLAGS="${CFLAGS} ${_flags}" \
    CXXFLAGS="${CXXFLAGS} ${_flags} -static-libstdc++"

  make
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm755 "${srcdir}/autorebase.bat" -t "${pkgdir}/"

  if [[ "${CARCH}" == 'i686' ]]; then
    install -Dm755 "${srcdir}/rebase.hook" -t "${pkgdir}/usr/share/libalpm/hooks/"
  fi
}
