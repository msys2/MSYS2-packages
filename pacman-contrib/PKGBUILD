# Contributor: Martell Malone <martellmalone@gmail.com>
# Contributor: Ray Donnelly <mingw.android@gmail.com>

pkgname=pacman-contrib
pkgver=1.13.1
pkgrel=1
pkgdesc="Contributed scripts and tools for pacman systems (MSYS2 port)"
arch=('i686' 'x86_64')
url="https://gitlab.archlinux.org/pacman/pacman-contrib"
license=('spdx:GPL-2.0-or-later')
depends=('pacman')
optdepends=(
  'diffutils: for pacdiff'
  'perl: for pacsearch'
  'vim: default diff program for pacdiff'
)
makedepends=(
  'asciidoc'
  'autotools'
  'gcc'
  'libarchive-devel'
  # Below are actually dependencies of libalpm-devel
  'libcurl-devel'
  'libgpgme-devel'
)
source=(
  "${url}/-/archive/v${pkgver}/${pkgname}-v${pkgver}.tar.gz"
  '0100-contrib.patch'
  '0101-fix-tests.patch'
)
sha256sums=('78cbad3dd6f816ad61422de15bde242ab65c6e02bc3504abb6464fe54afe62aa'
            '3b7e27f8f84fa42dc12cdb7ae1a030b8521504a185d4dcaf245d3e6cb5964d5e'
            '8df9cdf27cc554c4c3d748210aaef5726d560f3c7df3b66289a266f59ac76238')

prepare() {
  cd "${pkgname}-v${pkgver}"

  patch -p1 -i ${srcdir}/0100-contrib.patch
  patch -p1 -i ${srcdir}/0101-fix-tests.patch

  ./autogen.sh
}

build() {
  cd "${pkgname}-v${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-git-version

  make
}

check() {
  cd "${pkgname}-v${pkgver}"

  make check
}

package() {
  cd "${pkgname}-v${pkgver}"

  make DESTDIR=${pkgdir} install
}
