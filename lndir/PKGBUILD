# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=lndir
pkgver=1.0.6
pkgrel=1
pkgdesc="Create a shadow directory of symbolic links to another directory tree"
arch=('i686' 'x86_64')
url="https://xorg.freedesktop.org/"
license=('spdx:X11')
makedepends=('xorgproto' 'autotools' 'gcc')
source=(https://xorg.freedesktop.org/archive/individual/util/$pkgname-$pkgver.tar.xz)
sha256sums=('18f6d664e52894b7dee0d2fc9b171e0e58566e5091e44f9535f10e6d941912a4')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  export MSYSTEM=CYGWIN
  ./configure --build=${CHOST} \
              --prefix=/usr \
              --sysconfdir=/etc \
              --localstatedir=/var
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  make DESTDIR="$pkgdir/" install
  install -D -m 644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
