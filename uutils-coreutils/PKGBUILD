# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=coreutils
pkgname="uutils-${_realname}"
pkgver=0.12.0
pkgrel=1
pkgdesc="Cross-platform Rust rewrite of the GNU coreutils"
arch=('any')
url='https://github.com/uutils/coreutils'
msys2_repository_url='https://github.com/uutils/coreutils'
msys2_references=(
  'archlinux: uutils-coreutils'
  'purl: pkg:cargo/coreutils'
)
license=('spdx:MIT')
depends=("gcc-libs"
         "libopenssl")
makedepends=("openssl-devel" "rust" "pkgconf")
provides=("coreutils")
conflicts=("coreutils")
source=("https://github.com/uutils/coreutils/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('4fb327655cb4ffcbf2f16550cf9234079ffe839692f7aa1a6eda104af684e122')

prepare() {
  cd "${_realname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

# spliting build() sometimes cause building twice at make build
package() {
  cd "${_realname}-${pkgver}"

  export OPENSSL_NO_VENDOR=1
  export CARGOFLAGS="--features openssl"

  export CARGO_TARGET_DIR="${srcdir}/target-4"

  make install \
    DESTDIR="${pkgdir}" \
    PREFIX="/usr" \
    PROFILE=release \
    LIBSTDBUF_DIR="/usr/lib/${pkgname}" \
    SKIP_UTILS="more kill uptime" \
    MULTICALL=y

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
