# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=coreutils
pkgname="uutils-${_realname}"
pkgver=0.10.0
pkgrel=3
pkgdesc="Cross-platform Rust rewrite of the GNU coreutils"
arch=('any')
url='https://github.com/uutils/coreutils'
msys2_repository_url='https://github.com/uutils/coreutils'
msys2_references=(
  'archlinux: uutils-coreutils'
  'purl: pkg:cargo/coreutils'
)
license=('spdx:MIT')
depends=("gcc-libs"
         "libopenssl"
         "oniguruma")
makedepends=("openssl-devel" "rust" "pkgconf")
provides=("coreutils")
conflicts=("coreutils")
source=("https://github.com/uutils/coreutils/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('f8e68cd0e3629378f047544ead272161a83211c43f4985a9f52944e5db8f1a44')

prepare() {
  cd "${_realname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

# spliting build() sometimes cause building twice at make build
package() {
  cd "${_realname}-${pkgver}"

  export RUSTONIG_DYNAMIC_LIBONIG=1
  export OPENSSL_NO_VENDOR=1
  export CARGOFLAGS="--features openssl"
  # this fixed build failure on the CI, but not reliable
  # export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-Wl,--dynamicbase -C link-arg=-Wl,--enable-auto-image-base"

  export CARGO_TARGET_DIR="${srcdir}/target-3"

  make install \
    DESTDIR="${pkgdir}" \
    PREFIX="/usr" \
    PROFILE=release \
    LIBSTDBUF_DIR="/usr/lib/${pkgname}" \
    SKIP_UTILS="more kill uptime" \
    MULTICALL=y

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
