# Maintainer: J. Peter Mugaas <jpmugaas@suddenlink.net>

_realname='more-itertools'
_pyname="${_realname/-/_}"
pkgbase="python-${_realname}"
pkgname="python-${_realname}"
pkgver=11.1.0
pkgrel=1
pkgdesc='More routines for operating on iterables, beyond itertools'
arch=('any')
url='https://more-itertools.readthedocs.io'
msys2_repository_url='https://github.com/more-itertools/more-itertools'
msys2_documentation_url='https://more-itertools.readthedocs.io'
msys2_changelog_url='https://more-itertools.readthedocs.io/en/stable/versions.html'
msys2_references=(
  'anitya: 12201'
  'archlinux: python-more-itertools'
  'gentoo: dev-python/more-itertools'
  'purl: pkg:pypi/more-itertools'
)
license=('spdx:MIT')
depends=('python')
makedepends=(
  'python-build'
  'python-flit-core'
  'python-installer'
)
source=("https://pypi.org/packages/source/${_pyname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('48e8f4d9e7e5878571ecf6f2b4e57634f93cd474cc8cfbd2376f2d11b396e30d')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
