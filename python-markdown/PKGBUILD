# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=markdown
pkgname=python-markdown
pkgver=3.11.2
pkgrel=1
pkgdesc="Python implementation of John Gruber's Markdown"
arch=('any')
url='https://python-markdown.github.io/'
msys2_repository_url='https://github.com/Python-Markdown/markdown'
msys2_changelog_url='https://python-markdown.github.io/changelog'
msys2_references=(
  'anitya: 3916'
  'archlinux:' # ignore python-markdown bad versioning
  'gentoo: dev-python/markdown'
  'purl: pkg:pypi/markdown'
)
license=('spdx:BSD-3-Clause')
depends=(
  'python'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
)
optdepends=(
  'python-yaml: parse Python in YAML metadata'
)
checkdepends=(
  'python-yaml'
)
source=("${_realname}-${pkgver}.tar.gz::https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('87bf5d90f2d2882e2c02fcda182c2800456b985bff38913867c49706481514b0')

build() {
  cd "${_realname}-${pkgver}"

  python -m build --wheel --no-isolation
}

check() {
  cd "${_realname}-${pkgver}"

  python -m unittest discover tests
}

package() {
  cd "${_realname}-${pkgver}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.md -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
