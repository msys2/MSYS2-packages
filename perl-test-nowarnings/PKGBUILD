# Maintainer: Peter Budai <peterbudai@hotmail.com>

_perlname='Test-NoWarnings'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.06
pkgrel=2
pkgdesc="Make sure you didn't emit any warnings while testing"
arch=('any')
url="https://metacpan.org/release/Test-NoWarnings"
msys2_references=(
  'purl: pkg:cpan/HAARG/Test-NoWarnings'
)
license=('spdx:LGPL-2.1-only')
depends=('perl' 'perl-test-simple')
groups=('perl-modules')
provides=("perl-Test-NoWarnings=${pkgver}")
conflicts=('perl-Test-NoWarnings')
replaces=('perl-Test-NoWarnings')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_perlname}-${pkgver}.tar.gz")
sha256sums=('c2dc51143b7eb63231210e27df20d2c8393772e0a333547ec8b7a205ed62f737')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL installdirs=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
