# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Socket6'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=0.29
pkgrel=10
pkgdesc="A getaddrinfo/getnameinfo support module"
arch=('i686' 'x86_64')
url='https://metacpan.org/release/Socket6'
msys2_references=(
  "purl: pkg:cpan/UMEMOTO/Socket6"
)
license=('spdx:BSD-3-Clause')
groups=('perl-modules')
depends=('perl')
makedepends=('perl-devel' 'make' 'gcc')
provides=("perl-Socket6=${pkgver}")
conflicts=('perl-Socket6')
replaces=('perl-Socket6')
options=('!emptydirs')
source=(https://www.cpan.org/authors/id/U/UM/UMEMOTO/Socket6-$pkgver.tar.gz)
sha256sums=('468915fa3a04dcf6574fc957eff495915e24569434970c91ee8e4e1459fc9114')

build() {
  cd Socket6-$pkgver
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd Socket6-$pkgver
  make test
}

package() {
  cd Socket6-$pkgver
  make DESTDIR="$pkgdir" install
}
