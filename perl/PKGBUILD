prepare() {
  chmod -R u+w "${pkgname}-${pkgver}"
  cd "${pkgname}-${pkgver}"

  patch -p2 -i ${srcdir}/0001-cygwin-globalvar.patch
  patch -p2 -i ${srcdir}/0002-cygwin-hints.patch
  patch -p2 -i ${srcdir}/0003-cygwin-ExtUtils-MakeMaker.patch
  patch -p2 -i ${srcdir}/0004-cygwin-Win32.patch
  patch -p2 -i ${srcdir}/0005-cygwin-use-system-zlib.patch

  patch -p1 -i ${srcdir}/0006-perl-5.36.0-msys2.patch

  # MSYS2/Cygwin test fixes
  patch -p1 -i ${srcdir}/0008-Censor-dev-stdin-in-stat.t-like-stdout-and-stderr.patch
  patch -p1 -i ${srcdir}/0009-Skip-locale_threads.t-on-Cygwin-incomplete-nl_langin.patch
  patch -p1 -i ${srcdir}/0010-perlbug.t-set-PERL_BUILD_PACKAGING-to-avoid-XS-versi.patch

  cat > Policy.sh <<_EOF
#!/bin/sh
d_readlink='undef'
_EOF
}

build() {
  cd "${pkgname}-${pkgver}"

  export MSYSTEM=CYGWIN
  ./Configure -des \
    -Doptimize="${CFLAGS}" \
    -Dprefix=/usr \
    -Dvendorprefix=/usr \
    -Dprivlib=/usr/share/perl5/core_perl \
    -Darchlib=/usr/lib/perl5/core_perl \
    -Dsitelib=/usr/share/perl5/site_perl \
    -Dsitearch=/usr/lib/perl5/site_perl \
    -Dvendorlib=/usr/share/perl5/vendor_perl \
    -Dvendorarch=/usr/lib/perl5/vendor_perl \
    -Dscriptdir=/usr/bin/core_perl \
    -Dsitescript=/usr/bin/site_perl \
    -Dvendorscript=/usr/bin/vendor_perl \
    -Dinc_version_list=none \
    -Dman1ext=1perl -Dman3ext=3perl \
    -Darchname="${CARCH}-cygwin" \
    -Dlibperl=msys-perl"$(echo "${pkgver%.[0-9]*}" | tr . _)".dll \
    -Dcc=gcc -Dld=g++ \
    -Accflags="$CFLAGS -fwrapv" \
    -Ud_setproctitle

  LC_ALL=C make
}

check() {
  cd "${pkgname}-${pkgver}"

  TEST_JOBS=$(echo $MAKEFLAGS | sed 's/.*-j\([0-9][0-9]*\).*/\1/') \
  MSYS=winsymlinks:nativestrict \
    make test_harness
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="${srcdir}/${p}/${f}"
    mkdir -vp "$(dirname "${d}")"
    mv -v "${f}" "${d}"
    rmdir -vp --ignore-fail-on-non-empty "$(dirname "${f}")"
  done
}

_unpick() {
  local p="$1" f d; shift
  for f; do
    d="${srcdir}/${p}/${f}"
    mkdir -vp "$(dirname "${f}")"
    mv -v "${d}" "${f}"
    rmdir -vp --ignore-fail-on-non-empty "$(dirname "${d}")"
  done
}

package_perl() {
  depends=(
    'gcc-libs'
    'libxcrypt'
    'zlib'
  )
  optdepends=(
    'db: for DB_File'
    'gdbm: for GDBM_File'
  )
  replaces=('perl-Scalar-List-Utils')

  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm755 lib/auto/XS/APItest/APItest.dll -t "${pkgdir}/usr/lib/perl5/core_perl/auto/XS/APItest/"
  install -Dm755 lib/auto/XS/Typemap/Typemap.dll -t "${pkgdir}/usr/lib/perl5/core_perl/auto/XS/Typemap/"
  install -Dm755 lib/auto/Win32CORE/Win32CORE.a -t "${pkgdir}/usr/lib/perl5/core_perl/auto/Win32CORE/"

  cd "${pkgdir}"

  ### Perl Settings ###
  # Change man page extensions for site and vendor module builds.
  # Set no mail address since bug reports should go to the bug tracker
  # and not someone's email.
  # prevent xsinit-generated code from referencing boot_Win32CORE
  sed -e '/^man1ext=/ s/1perl/1p/' -e '/^man3ext=/ s/3perl/3pm/' \
      -e "/^cf_email=/ s/'.*'/''/" \
      -e "/^perladmin=/ s/'.*'/''/" \
      -e "s/^\(static_ext\)=.*/\1=' '/" \
      -i usr/lib/perl5/core_perl/Config_heavy.pl

  ### CPAN Settings ###
  # Set CPAN default config to use the site directories.
  sed -e '/(makepl_arg =>/   s/""/"INSTALLDIRS=site"/' \
      -e '/(mbuildpl_arg =>/ s/""/"installdirs=site"/' \
      -i usr/share/perl5/core_perl/CPAN/FirstTime.pm

  for template in "${srcdir}/"*.template; do
    install -Dm644 "${template}" "usr/share/makepkg-template/${template##*/}"
  done
  ln -v usr/share/makepkg-template/perl-binary-module-dependency{-1,}.template

  # Profile script to set paths to perl scripts.
  install -Dm755 "${srcdir}/"perlbin.{sh,csh} -t 'etc/profile.d/'
  # Profile script to set paths to perl scripts on fish. (FS#51191)
  install -Dm755 "${srcdir}/perlbin.fish" -t 'usr/share/fish/vendor_conf.d/'

  # Add the dirs so new installs will already have them in PATH once they
  # install their first perl programm
  install -dm755 usr/bin/{site,vendor}_perl

  # Split documention to perl-doc, except those man1 pages which are for perl scripts in /usr/bin/core_perl
  _pick perl-doc usr/bin/core_perl/perldoc
  _pick perl-doc usr/share/man/
  _pick perl-doc usr/share/perl5/core_perl/pods/
  local _prog
  for _prog in usr/bin/core_perl/* usr/bin/perl; do
    _unpick perl-doc usr/share/man/man1/$(basename "${_prog}").1perl
  done
}

package_perl-doc() {
  pkgdesc="Perl documentation"
  depends=("perl=${pkgver}")
  provides=()
  options=('!purge') # Keep .pod files

  mv -v ${pkgname}/* "${pkgdir}"
}

package_perl-devel() {
  pkgdesc="Perl headers and dev dependencies"
  depends=(
    "perl=${pkgver}"
    'libxcrypt-devel'
    'zlib-devel'
  )
  provides=()
}
