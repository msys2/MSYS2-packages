prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Cygwin patches
  patch -p1 -i $srcdir/gettext-tools-tests-locale-ll-es.patch
  patch -p1 -i $srcdir/gettext-0.21.1-autopoint-V.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-gnulib-lib-localcharset-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-gnulib-lib-localename-h.patch
  patch -p1 -i $srcdir/gettext-0.26-gettext-runtime-gnulib-lib-localename-environ-c.patch
  patch -p1 -i $srcdir/gettext-0.26-gettext-runtime-gnulib-lib-localename-unsafe-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localcharset-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-h.patch
  patch -p1 -i $srcdir/gettext-0.26-gettext-runtime-intl-gnulib-lib-localename-environ-c.patch
  patch -p1 -i $srcdir/gettext-0.26-gettext-runtime-intl-gnulib-lib-localename-unsafe-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-tools-gnulib-lib-localcharset-c.patch
  patch -p1 -i $srcdir/gettext-0.22.5-gettext-tools-gnulib-lib-localename-h.patch
  patch -p1 -i $srcdir/gettext-0.26-gettext-tools-gnulib-lib-localename-environ-c.patch
  patch -p1 -i $srcdir/gettext-0.26-gettext-tools-gnulib-lib-localename-unsafe-c.patch
  patch -p1 -i $srcdir/gettext-0.26-m4-more-warnings.m4-FOREIGN_WARN_CFLAGS-Wno-format-security.patch

  # MSYS2 patches
  patch -p1 -i $srcdir/gettext-0.26-msys2-cygwin-macro.patch
  patch -p1 -i $srcdir/gettext-0.22-disable-libtextstyle.patch
  patch -p1 -i $srcdir/gettext-0.19.8.1-msys2.patch
  # patch -p1 -i $srcdir/gettext-0.26-supersede-open-fallback.patch

  pushd gettext-tools/misc > /dev/null
    mkdir archive
    tar -xvf archive.dir.tar -C archive
    rm -f archive.dir.tar
    pushd archive > /dev/null
      patch -p1 -i ${srcdir}/gettext-0.19.7-archive.patch
      tar -cvf ../archive.dir.tar *
    popd > /dev/null
    rm -rf archive
  popd > /dev/null

  libtoolize --copy --force
  ./autogen.sh --skip-gnulib
}

_ci_check() {
  local _rc=0
  local _bindir="${srcdir}/dest/usr/bin"
  cd "${srcdir}/${pkgname}-${pkgver}/gettext-tools"

  msg2 "Inspecting gnulib filesystem wrapper decisions..."
  grep -E '^(REPLACE_(CANONICALIZE|REALPATH|GETCWD|OPEN|STAT|LSTAT)|HAVE_(REALPATH|CANONICALIZE))[[:space:]]*=' \
    gnulib-lib/Makefile || true
  grep -E 'HAVE_(REALPATH|CANONICALIZE)|REPLACE_(CANONICALIZE|REALPATH|GETCWD|OPEN|STAT|LSTAT)' \
    config.h || true
  grep -E 'gl_cv_func_getcwd' config.log || true

  msg2 "Running core gnulib filesystem tests..."
  local _gnulib_tests=(
    test-supersede.exe
    test-canonicalize.exe
    test-canonicalize-lgpl.exe
    test-getcwd-lgpl.exe
    test-open.exe
    test-stat.exe
  )
  make -C gnulib-tests check TESTS="${_gnulib_tests[*]}" VERBOSE=1 || _rc=1

  local _t _log
  for _t in "${_gnulib_tests[@]}"; do
    _log="gnulib-tests/${_t%.exe}.log"
    msg2 "=== ${_log} ==="
    if [[ -f "${_log}" ]]; then
      cat "${_log}"
    else
      echo "(missing)"
    fi
  done

  msg2 "Running diagnostic test-getcwd.sh (non-fatal)..."
  make -C gnulib-tests check-TESTS TESTS="test-getcwd.sh" VERBOSE=1 || \
    warning "test-getcwd.sh failed (expected when gl_cv_func_getcwd_path_max=no)"

  local _found_getcwd_log=0
  for _log in gnulib-tests/test-getcwd.sh.log gnulib-tests/test-getcwd.log; do
    if [[ -f "${_log}" ]]; then
      _found_getcwd_log=1
      msg2 "=== ${_log} ==="
      cat "${_log}"
    fi
  done
  (( _found_getcwd_log )) || warning "No test-getcwd log found"

  msg2 "Running upstream msgfmt tests..."
  local _msgfmt_tests=(msgfmt-1 msgfmt-2 msgfmt-3 msgfmt-4)
  make -C tests check TESTS="${_msgfmt_tests[*]}" VERBOSE=1 || _rc=1
  for _t in "${_msgfmt_tests[@]}"; do
    _log="tests/${_t}.log"
    msg2 "=== ${_log} ==="
    if [[ -f "${_log}" ]]; then
      cat "${_log}"
    else
      echo "(missing)"
    fi
  done

  msg2 "Smoke-testing installed msgfmt..."
  local _po="${PWD}/smoke-test.po"
  cat > "${_po}" << 'EOF'
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "hello"
msgstr "world"
EOF

  local _out
  for _out in /tmp/smoke-test.mo "${PWD}/smoke-test.mo" smoke-test-rel.mo; do
    msg2 "Testing msgfmt -o ${_out}"
    if PATH="${_bindir}:${PATH}" "${_bindir}/msgfmt" -v -o "${_out}" "${_po}" && [[ -s "${_out}" ]]; then
      ls -lh "${_out}"
    else
      warning "msgfmt failed for output path: ${_out}"
      _rc=1
    fi
  done
  rm -f "${_po}" /tmp/smoke-test.mo "${PWD}/smoke-test.mo" smoke-test-rel.mo

  if (( _rc == 0 )); then
    msg2 "All CI checks passed."
  else
    warning "CI checks failed (exit status: ${_rc})."
  fi
  return "${_rc}"
}

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

  local CHOST="$(echo "${CHOST}" | sed 's|-msys$|-cygwin|')"

  # GCC 16's stdcountof.h is C-only; use gnulib's C/C++ fallback.
  #
  # This is a tricky one, gnulib replaces MSYS/Cygwin getcwd() with its own
  # because of the following problem:
  # checking whether getcwd (NULL, 0) allocates memory for result... yes
  # checking for getcwd with POSIX signature... yes
  # checking whether getcwd handles long file names properly... no   <-- only failure
  # checking whether getcwd succeeds when 4k < cwd_length < 16k... yes

  ./configure \
    ac_cv_header_stdcountof_h=no \
    gl_cv_func_getcwd_path_max=yes \
    --build=${CHOST} \
    --host=${CHOST} \
    --prefix=/usr \
    --with-included-libunistring \
    --with-included-libxml \
    --with-included-gettext \
    --without-emacs \
    --enable-shared \
    --enable-static \
    --disable-java \
    --disable-csharp \
    --disable-d \
    --disable-go \
    --disable-modula2 \
    --disable-openmp

  make

  make DESTDIR="${srcdir}/dest" install
  rm -f ${srcdir}/dest/usr/lib/charset.alias

  # temporarily for CI
  _ci_check
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make check
}

package_gettext() {
  depends=('libintl' 'libgettextpo' 'libasprintf')
  license=('spdx:GPL-3.0-or-later')

  mkdir -p ${pkgdir}/usr/share/gettext

  cp -rf ${srcdir}/dest/usr/libexec ${pkgdir}/usr/

  cp -rf ${srcdir}/dest/usr/bin ${pkgdir}/usr/
  rm -rf ${pkgdir}/usr/bin/msys-asprintf-0.dll
  rm -rf ${pkgdir}/usr/bin/msys-gettextpo-0.dll
  rm -rf ${pkgdir}/usr/bin/msys-intl-8.dll

  cp -rf ${srcdir}/dest/usr/share/{aclocal,doc,info,locale,man,gettext-${pkgver}} \
    ${pkgdir}/usr/share/
  cp -rf ${srcdir}/dest/usr/share/gettext/{schema,styles} ${pkgdir}/usr/share/gettext/
}

package_gettext-devel() {
  pkgdesc="GNU Internationalization development utilities"
  groups=('development')
  depends=("gettext=${pkgver}" "libiconv-devel")
  options=('staticlibs')
  optdepends=('cvs: for autopoint tool')

  mkdir -p ${pkgdir}/usr/share

  cp -rf ${srcdir}/dest/usr/include ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/lib ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/share/gettext ${pkgdir}/usr/share/
  rm -rf ${pkgdir}/usr/share/gettext/{schema,styles}
}

package_libintl() {
  pkgdesc="GNU Internationalization runtime library"
  groups=('libraries')
  depends=('gcc-libs' 'libiconv')
  license=('spdx:LGPL-2.1-or-later')

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/msys-intl-8.dll ${pkgdir}/usr/bin/
}

package_libgettextpo() {
  pkgdesc="GNU Internationalization runtime library"
  groups=('libraries')
  depends=('gcc-libs')
  license=('spdx:LGPL-2.1-or-later')

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/msys-gettextpo-0.dll ${pkgdir}/usr/bin/
}

package_libasprintf() {
  pkgdesc="C-style formatted output in C++ (runtime)"
  groups=('libraries')
  depends=('gcc-libs')
  license=('spdx:LGPL-2.1-or-later')

  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/msys-asprintf-0.dll ${pkgdir}/usr/bin/
