# $Id: PKGBUILD 229968 2015-01-24 17:42:53Z bisson $
# Maintainer: Gaetan Bisson <bisson@archlinux.org>
# Contributor: Juergen Hoetzel <juergen@archlinux.org>
# Contributor: John Proctor <jproctor@prium.net>

pkgname=socat
pkgver=1.8.1.3
pkgrel=3
pkgdesc='Multipurpose relay'
url='http://www.dest-unreach.org/socat/'
msys2_changelog_url='http://www.dest-unreach.org/socat/CHANGES'
msys2_references=(
  "anitya: 4848"
  "cpe: cpe:2.3:a:dest-unreach:socat"
  "cpe: cpe:2.3:a:socat:socat"
)
license=('spdx:GPL-2.0-only')
arch=('i686' 'x86_64')
depends=('libreadline' 'libopenssl')
makedepends=('libreadline-devel' 'openssl-devel' 'tar' 'autotools' 'gcc')
source=("http://www.dest-unreach.org/socat/download/${pkgname}-${pkgver}.tar.gz"
        'openssl4.patch')
sha256sums=('06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097'
            '2a987f2df8babee7249377f724b2659b2309e2c0f00b9ac4f5af9df93a58df0a')
noextract=("${pkgname}-${pkgver}.tar.gz")

prepare() {
  cd "${srcdir}"
  tar -xzf ${srcdir}/${pkgname}-${pkgver}.tar.gz -C ${srcdir} || true

  cd "${pkgname}-${pkgver}"
  # https://git.openembedded.org/openembedded-core/plain/meta/recipes-connectivity/socat/files/0001-Fix-build-with-OpenSSL-4.0-use-ASN1_STRING-accessors.patch
  patch -Np1 -i "${srcdir}/openssl4.patch"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --mandir=/usr/share/man

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
