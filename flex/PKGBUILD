# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=flex
pkgver=2.6.4
pkgrel=5
pkgdesc="A tool for generating text-scanning programs"
arch=('i686' 'x86_64')
url="https://github.com/westes/flex"
msys2_repository_url='https://github.com/westes/flex'
msys2_references=(
  "anitya: 819"
  "cpe: cpe:2.3:a:westes:flex"
)
license=('spdx:LicenseRef-flex')
depends=('m4' 'sh' 'libiconv' 'libintl')
makedepends=('libiconv-devel' 'gettext-devel' 'autotools' 'gcc' 'git')
options=('staticlibs')
source=(https://github.com/westes/flex/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz
        # https://github.com/westes/flex/pull/216
        https://github.com/westes/flex/commit/2c3f4639099863b5d419d7c3442babb8ffc3f58a.patch
        # https://github.com/westes/flex/issues/222
        https://github.com/westes/flex/commit/1f3db3aeb311b58d50e5a9eb0e3e78f271255bb0.patch)
sha256sums=('e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995'
            'eee4bb97ca12c1b7266fe08f520f4d32d9a5be25111469e6e9b47b82a055abc1'
            '693f2de22bc6851f3553776c41535f04f0e8b27743786e33de97a547b74f13c8')

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}

  git apply --include='tests/*' ${srcdir}/2c3f4639099863b5d419d7c3442babb8ffc3f58a.patch
  git apply ${srcdir}/1f3db3aeb311b58d50e5a9eb0e3e78f271255bb0.patch
  sh tests/tableopts.sh > tests/tableopts.am
  ./autogen.sh
}

build() {
  cd ${srcdir}/${pkgname}-${pkgver}

  ./configure \
    --build=${CHOST} \
    --prefix=/usr \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --enable-static \
    --disable-shared

  make
}

check() {
  cd ${srcdir}/${pkgname}-${pkgver}

  make check
}

package() {
  cd ${srcdir}/${pkgname}-${pkgver}

  make DESTDIR=${pkgdir} install
  if [ ! -f ${pkgdir}/usr/bin/flex++.exe ]; then
	cp -f ${pkgdir}/usr/bin/flex.exe ${pkgdir}/usr/bin/flex++.exe
  fi
  if [ ! -f ${pkgdir}/usr/bin/lex.exe ]; then
	cp -f ${pkgdir}/usr/bin/flex.exe ${pkgdir}/usr/bin/lex.exe
  fi

  install -Dm644 COPYING ${pkgdir}/usr/share/licenses/${pkgname}/license.txt
}
