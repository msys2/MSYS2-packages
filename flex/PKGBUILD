pkgname=flex
pkgver=2.6.5
pkgrel=1
pkgdesc="A tool for generating text-scanning programs"
arch=('i686' 'x86_64')
url="https://github.com/westes/flex"
msys2_repository_url='https://github.com/westes/flex'
msys2_references=(
  "anitya: 819"
  "cpe: cpe:2.3:a:westes:flex"
)
license=('spdx:LicenseRef-flex')
depends=('m4' 'sh' 'libiconv' 'libintl')
makedepends=('libiconv-devel' 'gettext-devel' 'autotools' 'gcc' 'git')
options=('staticlibs')
source=("https://github.com/westes/flex/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.lz"{,.sig})
sha256sums=('cfeb900c956c0f72090c5fa9ac7c932dea10263d204af05f9829861a6896aa5c'
            'SKIP')
validpgpkeys=('56D664C70CC2364CF5164914B7DFE8BB6C241FED')

