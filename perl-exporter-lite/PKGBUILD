# Maintainer: Ray Donnelly <mingw.android@gmail.com>

_perlname='Exporter-Lite'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.09
pkgrel=2
pkgdesc="lightweight exporting of functions and variables"
arch=('any')
url="https://metacpan.org/author/NEILB${_perlname}-${pkgver}"
msys2_references=(
  "purl: pkg:cpan/NEILB/Exporter-Lite"
)
groups=('perl-modules')
depends=('perl')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
provides=("perl-Exporter-Lite=${pkgver}")
conflicts=('perl-Exporter-Lite')
replaces=('perl-Exporter-Lite')
source=("https://www.cpan.org/authors/id/N/NE/NEILB/${_perlname}-${pkgver}.tar.gz")
sha256sums=('79d8b14fd5013922c63e850f15bf51059f2502404535eb6690ef23612c2a198d')

prepare() {
  cd "$srcdir/${_perlname}-${pkgver}"
}

build() {
  cd "$srcdir/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "$srcdir/${_perlname}-${pkgver}"
  make install DESTDIR="$pkgdir"
}
