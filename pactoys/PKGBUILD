# Maintainer: Renato Silva <br.renatosilva@gmail.com>

_realname='pactoys'
pkgname="${_realname}"
_commit='b5fcc0f3100a20bbb15602c99f4297dbe16ddad9'
pkgver=r65.b5fcc0f
pkgrel=1
pkgdesc='A set of pacman packaging utilities'
arch=('i686' 'x86_64')
url='https://github.com/msys2/pactoys'
msys2_repository_url='https://github.com/msys2/pactoys'
msys2_references=(
  'internal'
)
license=('spdx:BSD-3-Clause')
depends=(
  'pacman'
  'wget'
)
makedepends=(
  'gcc'
  'git'
)
provides=(
  "${_realname}-git"
  'repman-git'
  'updpkgver-git'
)
conflicts=(
  "${_realname}-git"
  'repman-git'
  'updpkgver-git'
)
replaces=(
  "${_realname}-git"
  'repman-git'
  'updpkgver-git'
)
install="${_realname}.install"
source=("${_realname}::git+https://github.com/msys2/pactoys#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd "${_realname}"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${_realname}"

  make
}

package() {
  cd "${_realname}"

  make DESTDIR="${pkgdir}" install
}
