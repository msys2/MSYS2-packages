pkgname=doxygen
pkgver=1.18.0
pkgrel=1
pkgdesc="A documentation system for C++, C, Java, IDL and PHP"
arch=('i686' 'x86_64')
url="http://www.doxygen.org/"
msys2_repository_url="https://github.com/doxygen/doxygen"
msys2_references=(
  'anitya: 457'
  'archlinux: doxygen'
  'cpe: cpe:/a:doxygen:doxygen'
  'gentoo: app-text/doxygen'
)
license=('spdx:GPL-2.0-only')
depends=("gcc-libs" "libsqlite" "libiconv")
makedepends=("cmake" "ninja" "flex" "python" "libsqlite-devel" "libiconv-devel" 'gcc')
source=("https://www.doxygen.nl/files/${pkgname}-${pkgver}.src.tar.gz")
sha256sums=('3650f84019b05188f8a38cafce2d555cd113904b9fa8d3e75519e881b9f19a8e')

# prepare() {
# }

build() {
  local extra_config=Release
  if check_option "debug" "y"; then
    extra_config=Debug
  fi

  mkdir -p build-${MSYSTEM} && cd build-${MSYSTEM}

  /usr/bin/cmake \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=${extra_config} \
    -Dbuild_wizard=OFF \
    -Dbuild_search=OFF \
    -Duse_sys_sqlite3=ON \
    -Duse_libclang=OFF \
    ../${pkgname}-${pkgver}

  /usr/bin/cmake --build .
}

package() {
  cd ${srcdir}/build-${MSYSTEM}

  DESTDIR="${pkgdir}" /usr/bin/cmake --install .

  install -Dm644 "${srcdir}"/${pkgname}-${pkgver}/LICENSE \
    "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
