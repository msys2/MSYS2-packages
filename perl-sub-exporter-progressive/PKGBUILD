# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Sub-Exporter-Progressive'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.001013
pkgrel=3
pkgdesc="Only use Sub::Exporter if you need it"
arch=('any')
url="https://metacpan.org/dist/Sub-Exporter-Progressive"
msys2_references=(
  'purl: pkg:cpan/FREW/Sub-Exporter-Progressive'
)
groups=('perl-modules')
depends=('perl')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
source=("https://search.cpan.org/CPAN/authors/id/F/FR/FREW/Sub-Exporter-Progressive-${pkgver}.tar.gz")
sha256sums=('d535b7954d64da1ac1305b1fadf98202769e3599376854b2ced90c382beac056')

prepare() {
  cd "${srcdir}/${_perlname}-${pkgver}"
}

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
