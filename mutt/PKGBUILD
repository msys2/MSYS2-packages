# Maintainer: Felix Huettner <huettner94@gmx.de>

pkgname=mutt
pkgver=2.4.3
pkgrel=1
pkgdesc='Small but very powerful text-based mail client (net-utils)'
url='http://www.mutt.org/'
arch=('i686' 'x86_64')
msys2_repository_url='https://gitlab.com/muttmua/mutt'
msys2_references=(
  'anitya: 2035'
  'archlinux: mutt'
  'aur:' # ignore mutt-git
  'cpe: cpe:/a:mutt:mutt'
  'cygwin: mutt'
  'gentoo: mail-client/mutt'
)
license=('spdx:GPL-2.0-or-later')
groups=('net-utils')
depends=(
  'libgdbm'
  'libgnutls'
  'libgpgme'
  'libidn2'
  'libsasl'
  'libsqlite'
  'ncurses'
  'zlib'
)
makedepends=(
  'autotools'
  'docbook-xml'
  'docbook-xsl'
  'elinks'
  'gcc'
  'libgdbm-devel'
  'libgnutls-devel'
  'libgpgme-devel'
  'libidn2-devel'
  'libsasl-devel'
  'libsqlite-devel'
  'ncurses-devel'
  'zlib-devel'
)
backup=('etc/Muttrc')
source=("http://ftp.mutt.org/pub/mutt/${pkgname}-${pkgver}.tar.gz"{,.asc})
sha256sums=('ce9154e3afede622d98b90a22c87d06f32051c930a9afb2b7ef41656c4dbc948'
            'SKIP')
validpgpkeys=(
  '8975A9B33AA37910385C5308ADEF768480316BDA' # Kevin J. McCarthy <kevin@8t8.us>
)

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-gpgme \
    --enable-pop \
    --enable-imap \
    --enable-smtp \
    --enable-hcache \
    --with-curses=/usr \
    --with-gss=/usr \
    --with-gnutls=/usr \
    --with-sqlite3=/usr \
    --with-sasl \
    --with-idn2 \
    --with-gdbm \
    --with-mailpath=/var/spool/mail

  make
}

check() {
  cd "${pkgname}-${pkgver}"

  make -k check
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  rm -f "${pkgdir}"/etc/mime.types{,.dist}

  install -Dm644 contrib/gpg.rc "${pkgdir}/etc/Muttrc.gpg.dist"
}
