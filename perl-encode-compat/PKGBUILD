# Maintainer: Andrea Dalle Vacche

_perlname='Encode-compat'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.07
pkgrel=3
pkgdesc="Encode::compat - Encode.pm emulation layer"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Encode-compat"
msys2_references=(
  "purl: pkg:cpan/AUTRIJUS/Encode-compat"
)
depends=('perl')
groups=('perl-modules')
provides=("perl-Encode-compat=${pkgver}")
conflicts=('perl-Encode-compat')
replaces=('perl-Encode-compat')
options=('!emptydirs')
source=("https://www.cpan.org/authors/id/A/AU/AUTRIJUS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('4436c2b168b7e11627a24c54c7e8ce56e25dbf368219b9298d96281d4b463420')

prepare() {
  cd ${_perlname}-${pkgver}
    }

build() {
  cd ${_perlname}-${pkgver}
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
