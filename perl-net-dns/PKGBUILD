# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Net-DNS'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=1.58
pkgrel=1
pkgdesc="Perl Module: Interface to the DNS resolver."
arch=('i686' 'x86_64')
url="https://metacpan.org/dist/Net-DNS"
msys2_references=(
  'archlinux: perl-net-dns'
  'cygwin: perl-Net-DNS'
  'purl: pkg:cpan/NLNETLABS/Net-DNS'
)
license=('spdx:MIT')
groups=('perl-modules')
depends=(
  'perl'
  'perl-digest-hmac'
  'perl-net-ip'
)
makedepends=(
  'gcc'
  'make'
)
checkdepends=(
  'perl-test-pod'
)
provides=("perl-Net-DNS=${pkgver}")
conflicts=('perl-Net-DNS')
replaces=('perl-Net-DNS')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/N/NL/NLNETLABS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('6335e9e253bc457c7f7e26aaef673c613f62bde26ab8d1cbdd3ddfeb402871a7')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  # install module in vendor directories.
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"

  make install DESTDIR="${pkgdir}"
}
