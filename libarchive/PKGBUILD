# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=('libarchive' 'libarchive-devel' 'bsdcpio' 'bsdtar' 'bsdunzip')
pkgver=3.8.11
pkgrel=1
pkgdesc="Multi-format archive and compression library"
arch=('i686' 'x86_64')
url="https://libarchive.org/"
msys2_repository_url="https://github.com/libarchive/libarchive"
msys2_references=(
  "cpe: cpe:/a:libarchive:libarchive"
)
license=('spdx:BSD-2-Clause')
groups=('libraries')
depends=('gcc-libs' 'libbz2' 'libiconv' 'libexpat' 'liblzma' 'liblz4' 'libopenssl' 'libzstd' 'zlib')
makedepends=('libbz2-devel' 'libiconv-devel' 'libexpat-devel' 'liblzma-devel' 'liblz4-devel' 'openssl-devel' 'libzstd-devel' 'zlib-devel' 'autotools' 'gcc')
source=("https://github.com/libarchive/libarchive/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.xz"{,.asc})
sha256sums=('a3dc0872b1b39da34dc18ef1b944f0f11ffd37425d70ae04be679279f1cf43d2'
            'SKIP')
validpgpkeys=("659C84C0E23EA1FA97E0B58CC040B508D63D2B36") # Martin Matuska <mm@FreeBSD.org>

prepare() {
  cd "${pkgname}-${pkgver}"

  autoreconf -fiv
}

build() {
  export lt_cv_deplibs_check_method='pass_all'
  cd "${pkgname}-${pkgver}"

  # Mention default options explicitly to clarify any confusion
  ./configure \
    --prefix=/usr \
    --build=${CHOST} \
    --enable-shared \
    --enable-static \
    --without-libiconv-prefix \
    --without-xml2 \
    --without-lzo2 \
    --without-nettle \
    --with-openssl \
    --without-cng

  make
  make DESTDIR="${srcdir}/dest" install
}

check() {
  cd "${pkgname}-${pkgver}"

  make check || true
}

package_bsdcpio() {
  install -Dm755 ${srcdir}/dest/usr/bin/bsdcpio.exe -t ${pkgdir}/usr/bin
  install -Dm644 ${srcdir}/dest/usr/share/man/man1/bsdcpio.1 -t ${pkgdir}/usr/share/man/man1
}

package_bsdtar() {
  install -Dm755 ${srcdir}/dest/usr/bin/bsdtar.exe -t ${pkgdir}/usr/bin
  install -Dm644 ${srcdir}/dest/usr/share/man/man1/bsdtar.1	-t ${pkgdir}/usr/share/man/man1
}

package_bsdunzip() {
  conflicts=('unzip')
  provides=('unzip')
  install -Dm755 ${srcdir}/dest/usr/bin/bsdunzip.exe -t ${pkgdir}/usr/bin
  install -Dm644 ${srcdir}/dest/usr/share/man/man1/bsdunzip.1 -t ${pkgdir}/usr/share/man/man1
  (cd ${pkgdir}/usr/bin && ln bsdunzip.exe unzip.exe)
}

package_libarchive() {
  mkdir -p ${pkgdir}/usr/bin
  cp -f ${srcdir}/dest/usr/bin/*.dll ${pkgdir}/usr/bin/

  install -Dm644 ${srcdir}/${pkgname}-${pkgver}/COPYING -t ${pkgdir}/usr/share/licenses/libarchive
}

package_libarchive-devel() {
  groups=('development')
  options=('staticlibs')
  depends=("libarchive=${pkgver}" 'libbz2-devel' 'libiconv-devel' 'libexpat-devel' 'liblzma-devel' 'liblz4-devel' 'libnettle-devel' 'libxml2-devel' 'libzstd-devel' 'zlib-devel')

  mkdir -p ${pkgdir}/usr
  cp -rf ${srcdir}/dest/usr/include ${pkgdir}/usr/
  cp -rf ${srcdir}/dest/usr/lib ${pkgdir}/usr/

  # iconv doesn't have a .pc file
  sed -i "s| iconv||g" ${pkgdir}/usr/lib/pkgconfig/libarchive.pc
}
