# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Test-Warnings'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.038
pkgrel=2
pkgdesc="Test for warnings and the lack of them"
arch=('any')
url="https://metacpan.org/dist/Test-Warnings"
msys2_references=(
  'purl: pkg:cpan/ETHER/Test-Warnings'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
groups=('perl-modules')
provides=("perl-Test-Warnings=${pkgver}")
conflicts=('perl-Test-Warnings')
replaces=('perl-Test-Warnings')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/E/ET/ETHER/${_perlname}-${pkgver}.tar.gz")
sha256sums=('3da27e003a3c3cafed3c09b42be05cf9bdbff0bee5c8590a731b02853880a273')

build() {
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""                 \
      PERL_AUTOINSTALL=--skipdeps                            \
      PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='"${pkgdir}"'"     \
      PERL_MB_OPT="--installdirs vendor --destdir '"${pkgdir}"'" \
      PERL_USE_UNSAFE_INC=1 \
      MODULEBUILDRC=/dev/null

    cd "${srcdir}/${_perlname}-$pkgver"
    /usr/bin/perl Makefile.PL
    make
  )
}

check() {
  cd ${_perlname}-${pkgver}
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""
    make test
  )
}

package() {
  cd ${_perlname}-${pkgver}
  make install

  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}
