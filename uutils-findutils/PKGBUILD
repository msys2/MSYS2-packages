

_realname=findutils
pkgname="uutils-${_realname}"
pkgver=0.11.0
pkgrel=1
pkgdesc="Rust rewrite of findutils"
arch=('any')
url='https://github.com/uutils/findutils'
msys2_repository_url="${url}"
msys2_references=(
  'archlinux: uutils-findutils' # just in case and ignore original findutils
  'aur: uutils-findutils'
  'cygwin:' # ignore findutils
  'gentoo: sys-apps/uutils-findutils'
  'purl: pkg:cargo/findutils'
)
license=('spdx:MIT')
depends=("gcc-libs"
         "oniguruma")
makedepends=("rust" "pkgconf")
provides=("${_realname}")
conflicts=("${_realname}")
source=("${url}/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('43d1fbb69a0e67e708435bd104966d1dd61357755452b733db9dabfd66cbf974')

prepare() {
  cd "${_realname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"
  export RUSTONIG_DYNAMIC_LIBONIG=1

  cargo build --release --frozen
}

package() {
  cd "${_realname}-${pkgver}"

  for _b in find locate updatedb xargs;do
    install -Dm755 "target/release/${_b}.exe" -t "${pkgdir}/usr/bin"
  done
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
