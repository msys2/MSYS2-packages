maybe_cache_passwd ()
{
  # Cache account information to speedup cold start
  # See https://github.com/msys2/MSYS2-packages/issues/6786
  if [ ! -e /etc/passwd -a ! -e /etc/group ]
  then
    getent passwd "$(id -u)" > /etc/passwd
    getent group $(id -G) | awk -F: '$2 ~ /^S-1-5-(12|21|32)-/' > /etc/group
  fi
}

maybe_cache_passwd
