cygwin: truncate thread names

pthread_setname_np() fails with ERANGE for long names and threading.Thread
ignores that error, so those threads were left unnamed.

--- Python-3.14.10.orig/configure.ac
+++ Python-3.14.10/configure.ac
@@ -7875,6 +7875,7 @@
   iOS) _PYTHREAD_NAME_MAXLEN=63;;
   FreeBSD*) _PYTHREAD_NAME_MAXLEN=19;; # gh-131268
   OpenBSD*) _PYTHREAD_NAME_MAXLEN=23;; # gh-131268
+  CYGWIN*|MSYS*) _PYTHREAD_NAME_MAXLEN=15;;
   *) _PYTHREAD_NAME_MAXLEN=;;
 esac
 if test -n "$_PYTHREAD_NAME_MAXLEN"; then
