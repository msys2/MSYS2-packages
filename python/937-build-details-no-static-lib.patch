build-details: don't list a static library on .dll platforms

libainstall installs the import library instead of libpython3.x.a there, so
build-details.json pointed at a file that doesn't exist.

--- Python-3.14.10.orig/Tools/build/generate-build-details.py
+++ Python-3.14.10/Tools/build/generate-build-details.py
@@ -83,10 +83,12 @@
         # dynamic library if enabled, otherwise it's the static library.
         # If LIBRARY != LDLIBRARY, support for the dynamic library is enabled.
         has_dynamic_library = LDLIBRARY != LIBRARY
-        # Framework builds don't install the static library (see libainstall).
+        # Framework and .dll builds don't install the static library (see
+        # libainstall).
         has_static_library = (
             sysconfig.get_config_var('STATIC_LIBPYTHON')
             and not sysconfig.get_config_var('PYTHONFRAMEWORK')
+            and sysconfig.get_config_var('SHLIB_SUFFIX') != '.dll'
         )
         # The static library is only installed into LIBDIR when it is also
         # LDLIBRARY; otherwise it is only installed into LIBPL.
