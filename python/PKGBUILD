apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying $_patch"
    patch -Nbp1 -i "${srcdir}/$_patch"
  done
}

prepare() {
  cd "${srcdir}/Python-${pkgver}"

  apply_patch_with_msg \
    003-3.4-select-cygwin.patch \
    005-3.7-ctypes-cygwin.patch \
    012-3.8-pep3149-cygwin.patch \
    027-install-import-library.patch \
    900-msysize.patch \
    920-allow-win-drives-in-os-path-isabs.patch \
    930-cygwin-strerror-r-gnu.patch \
    935-cygwin-clockid-long.patch \
    936-cygwin-fma.patch \
    937-build-details-no-static-lib.patch \
    938-cygwin-log2-powers-of-two.patch \
    939-cygwin-thread-name-maxlen.patch \
    940-rebase-python-dll.patch \
    950-rebase-dlls.patch \
    960-cygwin-fix-tests.patch \
    965-cygwin-multiprocessing-waitpid.patch \
    966-cygwin-ssl-not-connected.patch \
    967-cygwin-keep-executable-name.patch

  # https://github.com/msys2/MSYS2-packages/pull/4743#issuecomment-2213043559
  apply_patch_with_msg \
    990-cygwin-default-to-spawn-for-multiprocessing-and-disa.patch

  # To regenerate the symbol list:
  # python ./Tools/build/stable_abi.py --generate --cyg-python3dll PC/cyg-python3dll.c Misc/stable_abi.toml
  apply_patch_with_msg \
    991-py-limited-api.patch

  # Ensure that we are using the system copy of various libraries (expat, zlib and libffi),
  # rather than copies shipped in the tarball
  rm -r Modules/expat
  rm -r Modules/_decimal/libmpdec
  autoreconf -fiv
}

build() {
  cd "${srcdir}/Python-${pkgver}"

  export MSYSTEM=CYGWIN
  ./configure \
    --prefix=/usr \
    --build=${CHOST} \
    --host=${CHOST} \
    --enable-shared \
    --enable-ipv6 \
    --with-dbmliborder=gdbm \
    --with-system-expat \
    --with-system-libmpdec \
    --enable-loadable-sqlite-extensions \
    --without-ensurepip

  make
}

check() {
  cd "${srcdir}/Python-${pkgver}"
  "${srcdir}/Python-${pkgver}/python.exe" -m test.regrtest -x test_posixpath test_logging
}

package_python() {
  depends=('libbz2' 'libexpat' 'libffi' 'liblzma' 'ncurses' 'libopenssl' 'libreadline' 'mpdecimal' 'libsqlite' 'zlib' 'libzstd' 'libxcrypt'
           # ctypes.util.find_library() depends on 'dlltool' from binutils
           'binutils')
  provides=('python3')
  replaces=('python3')

  cd "${srcdir}/Python-${pkgver}"
  # The unstripped DLL overlaps other DLLs in the build tree, which breaks fork(),
  # so compile without worker processes. "make install" ignores compileall errors.
  make DESTDIR="${pkgdir}" COMPILEALL_OPTS=-j1 install
  (( $(find "${pkgdir}/usr/lib/python${_pybasever}" -name '*.pyc' | wc -l) > 1000 ))

  # Why are these not done by default...
  ln -sf python3               "${pkgdir}"/usr/bin/python.exe
  ln -sf python3-config        "${pkgdir}"/usr/bin/python-config
  ln -sf idle3                 "${pkgdir}"/usr/bin/idle
  ln -sf pydoc3                "${pkgdir}"/usr/bin/pydoc
  ln -sf python${_pybasever}.1 "${pkgdir}"/usr/share/man/man1/python3.1
  ln -sf python${_pybasever}.1 "${pkgdir}"/usr/share/man/man1/python.1

  # PEP668
  install -Dm644 "$srcdir"/EXTERNALLY-MANAGED -t "${pkgdir}/usr/lib/python${_pybasever}/"

  # License
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

package_python-devel() {
  pkgdesc="Python headers and dev dependencies"
  depends=("python=${pkgver}")
}
