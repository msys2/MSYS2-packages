# Maintainer: LoveSy <shana@zju.edu.cn>

pkgname='openbsd-netcat'
pkgver=1.239_1
_ver="${pkgver/_/-}"
pkgrel=1
pkgdesc='TCP/IP swiss army knife. OpenBSD variant.'
arch=('i686' 'x86_64')
url='https://packages.debian.org/sid/netcat-openbsd'
msys2_references=(
  'anitya: 21534'
  'archlinux: openbsd-netcat'
  'aur:' # ignore gnu-netcat
  'cygwin: openbsd-netcat'
  'gentoo: net-analyzer/openbsd-netcat'
)
license=('spdx:BSD-2-Clause AND BSD-3-Clause')
depends=(
  'libbsd'
)
makedepends=(
  'gcc'
  'make'
  'pkgconf'
)
provides=('netcat')
conflicts=('gnu-netcat')
source=(
  "https://salsa.debian.org/debian/netcat-openbsd/-/archive/debian/${_ver}/netcat-openbsd-debian-${_ver}.tar.gz"
  '001-msys2-build-fix.patch'
)
sha256sums=('2a5c1304047a69a680a45834756136bde6fb1f73f9e8610b18e9c1dbff09259f'
            '60d725e13cebeb3b40574d41f0218f89c4fe2982118fb80c4ecc9c19b3df9892')

prepare() {
  cd "netcat-openbsd-debian-${_ver}"

  while read -r _patch _; do
    [[ -z "${_patch}" || "${_patch}" =~ ^# ]] && continue
    patch -Np1 -i "debian/patches/${_patch}"
  done < debian/patches/series

  patch -Np1 -i "${srcdir}/001-msys2-build-fix.patch"
}

build() {
  cd "netcat-openbsd-debian-${_ver}"

  make \
    CFLAGS="${CFLAGS} -DDEBIAN_VERSION=\"\\\"${pkgrel}\\\"\"" \
    LDFLAGS="${LDFLAGS} -lbsd"
}

package() {
  cd "netcat-openbsd-debian-${_ver}"

  install -Dm755 nc "${pkgdir}/usr/bin/nc"

  ln -s nc "${pkgdir}/usr/bin/netcat"

  install -Dm644 nc.1 "${pkgdir}/usr/share/man/man1/nc.1"
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"

  head -n28 netcat.c | tail -n+2 > "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
