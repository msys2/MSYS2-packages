# Maintainer: Alexandre Ferreira < alex.jorge.m [at] gmail.com >

_realname='wcwidth'
pkgbase="python-${_realname}"
pkgname="python-${_realname}"
pkgver=0.9.2
pkgrel=1
pkgdesc='Measures number of Terminal column cells of wide-character codes'
arch=('x86_64')
url='https://github.com/jquast/wcwidth'
msys2_repository_url='https://github.com/jquast/wcwidth'
msys2_changelog_url='https://github.com/jquast/wcwidth/blob/master/docs/history.rst'
msys2_references=(
  'anitya: 88052'
  'archlinux: python-wcwidth'
  'cygwin: python-wcwidth'
  'gentoo: dev-python/wcwidth'
  'purl: pkg:pypi/wcwidth'
)
license=('spdx:MIT')
depends=(
  'python'
)
makedepends=(
  'gcc'
  'python-build'
  'python-installer'
  'python-setuptools'
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('ae0ef90b90f6af38b54f1fe6d58662ec33b3cb4b8391958a62416d654231727b')

build() {
  cd "${_realname}-${pkgver}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${_realname}-${pkgver}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
