# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='File-Copy-Recursive'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.45
pkgrel=3
pkgdesc="extension for recursively copying files and directories"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
options=('!emptydirs')
depends=('perl')
url='https://metacpan.org/dist/File-Copy-Recursive'
msys2_references=(
  "purl: pkg:cpan/DMUEY/File-Copy-Recursive"
)
groups=('perl-modules')
provides=("perl-File-Copy-Recursive=${pkgver}")
conflicts=('perl-File-Copy-Recursive')
replaces=('perl-File-Copy-Recursive')
source=("https://www.cpan.org/authors/id/D/DM/DMUEY/${_perlname}-${pkgver}.tar.gz")
sha256sums=('d3971cf78a8345e38042b208bb7b39cb695080386af629f4a04ffd6549df1157')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
