# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Pod-Parser'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.67
pkgrel=2
pkgdesc="Modules for parsing/translating POD format documents"
arch=('any')
license=('spdx:Artistic-1.0-Perl' 'spdx:GPL-1.0-or-later')
url="https://metacpan.org/dist/Pod-Parser"
msys2_references=(
  'purl: pkg:cpan/MAREKR/Pod-Parser'
)
depends=('perl')
groups=('perl-modules')
provides=("perl-Pod-Parser=${pkgver}")
conflicts=('perl-Pod-Parser')
replaces=('perl-Pod-Parser')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/M/MA/MAREKR/${_perlname}-${pkgver}.tar.gz")
sha256sums=('5deccbf55d750ce65588cd211c1a03fa1ef3aaa15d1ac2b8d85383a42c1427ea')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
