# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='TAP-Harness-Archive'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.18
pkgrel=3
pkgdesc="Create an archive of TAP test results"
arch=('any')
url="https://metacpan.org/dist/TAP-Harness-Archive"
msys2_references=(
  "purl: pkg:cpan/SCHWIGON/TAP-Harness-Archive"
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl-YAML-Tiny' 'perl')
makedepends=('perl-Module-Build')
options=('!emptydirs')
groups=('perl-modules')
source=(https://www.cpan.org/authors/id/S/SC/SCHWIGON/${_perlname}-${pkgver}.tar.gz)
sha256sums=('423ae8fcdddfe7fb44cdd7e2331f4fd35e443543017827e3da3c9f40945c4a64')

build() {
  cd ${_perlname}-${pkgver}
  perl Build.PL installdirs=vendor
  ./Build
}

check() {
  cd ${_perlname}-${pkgver}
  ./Build test
}

package() {
  cd ${_perlname}-${pkgver}
  ./Build install destdir="${pkgdir}"
}
