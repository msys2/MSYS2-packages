# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Error'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=0.17031
pkgrel=1
pkgdesc="Perl/CPAN Error module - Error/exception handling in an OO-ish way"
url="https://metacpan.org/release/Error"
msys2_repository_url='https://github.com/shlomif/perl-error.pm'
msys2_changelog_url='https://github.com/shlomif/perl-error.pm/blob/master/module/Changes'
msys2_references=(
  'archlinux: perl-error'
  "purl: pkg:cpan/SHLOMIF/Error"
)
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
checkdepends=('perl-test-pod' 'perl-test-pod-coverage')
groups=('perl-modules')
provides=("perl-Error=${pkgver}")
conflicts=('perl-Error')
replaces=('perl-Error')
options=('!emptydirs')
source=("https://www.cpan.org/authors/id/S/SH/SHLOMIF/${_perlname}-${pkgver}.tar.gz")
sha256sums=('0a85374cf9cbde5a5075f16e62246e5d36abde63ec08c5c5694f128f4546852f')

build() {
  cd "${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
