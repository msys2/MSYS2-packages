

pkgname='cargo-nextest'
pkgver=0.9.149
pkgrel=1
pkgdesc="A next-generation test runner for Rust"
arch=('any')
url='https://github.com/nextest-rs/nextest'
msys2_repository_url="${url}"
msys2_references=(
  "archlinux: ${pkgname}"
)
license=('spdx:MIT')
depends=("gcc-libs"
         "zstd")
makedepends=("rust" "pkgconf")
source=("${url}/archive/refs/tags/${pkgname}-${pkgver}.tar.gz")
sha256sums=('3f1519ce8c3ae9e0442c0460995ed6802b70a73597b5876531f96c641577f21a')
noextract=("${pkgname}-${pkgver}.tar.gz") # containing symlink

prepare() {
  bsdtar xf "${pkgname}-${pkgver}.tar.gz" ||:
  cd nextest-"${pkgname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd nextest-"${pkgname}-${pkgver}"
  cargo build --release --frozen --no-default-features --features default-no-update
}

package() {
  cd nextest-"${pkgname}-${pkgver}"

  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
