# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='XML-Simple'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=2.25
pkgrel=3
groups=('perl-modules')
pkgdesc="Simple XML parser for perl"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/XML-Simple"
msys2_references=(
  "purl: pkg:cpan/GRANTM/XML-Simple"
)
depends=('perl-xml-parser' 'perl')
provides=("perl-XML-Simple=${pkgver}")
conflicts=('perl-XML-Simple')
replaces=('perl-XML-Simple')
options=('!emptydirs')
source=("https://cpan.org/authors/id/G/GR/GRANTM/${_perlname}-${pkgver}.tar.gz")
sha256sums=('531fddaebea2416743eb5c4fdfab028f502123d9a220405a4100e68fc480dbf8')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
