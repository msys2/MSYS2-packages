pkgname=procps-ng
pkgver=4.0.7
pkgrel=1
pkgdesc='Utilities for monitoring your system and its processes'
arch=('i686' 'x86_64')
url='https://gitlab.com/procps-ng/procps'
msys2_repository_url='https://gitlab.com/procps-ng/procps'
msys2_references=(
  "cpe: cpe:/a:procps-ng_project:procps-ng"
)
license=('spdx:GPL-2.0-or-later AND LGPL-2.1-or-later')
groups=('sys-utils')
depends=(
  'gcc-libs'
  'libintl'
  'ncurses'
)
makedepends=(
  'autotools'
  'gcc'
  'gettext-devel'
  'ncurses-devel'
)
options=('!emptydirs')
source=(
  "https://downloads.sourceforge.net/project/${pkgname}/Production/${pkgname}-${pkgver}.tar.xz"{,.asc}
  'procps-ng-4.0.7-LDADD.patch'
  'procps-ng-4.0.7-manpage.patch'
  'procps-ng-4.0.7-nlwp.patch'
  'procps-ng-4.0.7-pgrep_mrelease.patch'
  'procps-ng-4.0.7-pid_max.patch'
  'procps-ng-4.0.7-siglost-sigpower-confusion.patch'
  'procps-ng-4.0.7-skip-hugetlb-test.patch'
  'procps-ng-4.0.7-wchan.patch'
)
sha256sums=('9d2021f47a4501c667862c9942a92d1953694b21d11bcd1702e83eb594e3d67d'
            'SKIP'
            'cd190b5cbc9a9dcc65d1eb7c269de7d1c4d47d49e70700ba9e6069b3ee985835'
            '06ac543ed52cddefaeb4137577bc6358665e2a4a647cc38e849cafaf82d0c552'
            '6ba56f34d39d723b2b3f9e472bce0288a2c55b9ae5c30669c373517fec8494a0'
            '484c3dabfb43c7dd0e07e791653905a4fb641d3f373b211a8eb9c60ce113a943'
            'fb94f3381d81fd0ccd9cd47adc87d88aede859f2220d5288be219d0c152c5e21'
            '5aa70ef26c6a6dc52937b80006d75062f85f9f51a8329e78563b1510146cbfc9'
            'c9e781b767ac4b6ec21544798acd59be4ac6370d033188dc10d7aa9818f700fc'
            '1fa417ce5fa810273330c49ed40c921554d5b78d17ecf189f4eb088de89c2631')
validpgpkeys=('5D2FB320B825D93904D205193938F96BDF50FEA5') # Craig Small <csmall@debian.org>

prepare() {
  cd "${pkgname}-${pkgver}"

  # patch and order from Cygwin: https://cygwin.com/cgit/cygwin-packages/procps-ng/tree/
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-manpage.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-LDADD.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-wchan.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-pid_max.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-siglost-sigpower-confusion.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-skip-hugetlb-test.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-pgrep_mrelease.patch
  patch -p2 -i ${srcdir}/procps-ng-4.0.7-nlwp.patch

  autoreconf -fiv
}

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --bindir=/usr/bin \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib \
    --libdir=/usr/lib \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --enable-watch8bit \
    --disable-pidwait \
    --disable-numa

  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR=${pkgdir} install
}
