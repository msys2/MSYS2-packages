pkgbase=tcl
pkgname=('tcl' 'tcl-devel' 'tcl-doc')
pkgver=8.6.12
pkgrel=4
pkgdesc="The Tcl scripting language"
arch=('i686' 'x86_64')
url="https://tcl.sourceforge.io/"
msys2_references=(
  "anitya: 4941"
  "cpe: cpe:/a:tcl:tcl"
)
license=('spdx:TCL')
depends=(
  'zlib'
)
makedepends=(
  'autotools'
  'gcc'
)
options=('staticlibs')
source=(
  "https://downloads.sourceforge.net/sourceforge/tcl/tcl${pkgver}-src.tar.gz"
  'tcl-8.6.12-1.src.patch'
  '001-cygwin-removals.patch'
  '002-build-info-command.patch'
  '003-registry-update.patch'
  '004-test-octal-literals.patch'
  '005-buildsystem-and-ci.patch'
)
