pkgbase=tcl
pkgname=('tcl' 'tcl-devel' 'tcl-doc')
pkgver=8.6.18
pkgrel=1
pkgdesc="The Tcl scripting language"
arch=('i686' 'x86_64')
url="https://tcl.sourceforge.io/"
msys2_references=(
  'anitya: 4941'
  'archlinux: tcl'
  'aur:' # ignore tcl84
  'cpe: cpe:/a:tcl:tcl'
  'gentoo: dev-lang/tcl'
)
license=('spdx:TCL')
depends=(
  'zlib'
)
makedepends=(
  'autotools'
  'gcc'
)
options=('staticlibs')
_archive="tcl${pkgver}"
source=(
  "https://downloads.sourceforge.net/sourceforge/tcl/${_archive}-src.tar.gz"
  '001-cygwin-removals.patch'
  '002-build-info-command.patch'
  '003-registry-update.patch'
  '004-test-octal-literals.patch'
  '005-buildsystem-and-ci.patch'
)
sha256sums=('14f9af32b1767ff718477a8f974ad03c34341097e6b43f4ce54644ee974e268e'
            '0599983f1e37b531647f19b7b37ec7243a1865a54e53be83cfef850ac78016aa'
            'e5620ef5bf7f700f605c455975e78b49beadba228ef4f626d4645eb357e3e313'
            '77c1601c5ca772de51ccbcab03bf7d9c27b5b4b4510db83a7587a82a8db2f665'
            'b9e6a011f572efd438feac7701e4f3cf52c4dd5ecc4daa9783b5f0ea5a6813e3'
