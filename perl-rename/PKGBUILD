# Maintainer (Arch Linux): Florian Pritz <flo@xinu.at>

_perlname='App-rename'
pkgname=perl-rename
pkgver=1.16.3
pkgrel=1
pkgdesc='Rename multiple files using Perl regular expressions'
arch=('any')
url='https://metacpan.org/dist/App-rename'
msys2_references=(
  'archlinux: perl-rename'
  'aur:' # ignore perl-file-rename
  'purl: pkg:cpan/PEDERST/App-rename'
)
license=('spdx:GPL-1.0-or-later', 'spdx:Artistic-1.0-Perl')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/P/PE/PEDERST/${_perlname}-${pkgver}.tar.gz")
sha256sums=('4388a9db7fb850ef43f91beb7f48bd8611940ff52b23792b189f877c73ec031e')

build() {
  cd  "${srcdir}/${_perlname}-${pkgver}"

  perl Makefile.PL PREFIX=/usr INSTALLDIRS=vendor
  make
}

package() {
  cd  "${srcdir}/${_perlname}-${pkgver}"

  make DESTDIR="$pkgdir"/ install

  mv "$pkgdir"/usr/bin/vendor_perl/{rename,perl-rename}
  mv "$pkgdir"/usr/share/man/man1/{rename,perl-rename}.1p
}
