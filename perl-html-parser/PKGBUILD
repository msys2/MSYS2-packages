# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='HTML-Parser'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=3.85
pkgrel=2
pkgdesc="Perl HTML parser class"
arch=('i686' 'x86_64')
license=('spdx:Artistic-1.0-Perl' 'spdx:GPL-1.0-or-later')
url="https://metacpan.org/dist/HTML-Parser"
msys2_repository_url='https://github.com/libwww-perl/HTML-Parser'
msys2_references=(
  'purl: pkg:cpan/OALDERS/HTML-Parser'
)
groups=('perl-modules')
depends=('perl-html-tagset' 'perl-http-message' 'perl-uri' 'perl')
makedepends=('perl-devel' 'make' 'gcc')
checkdepends=('perl-test-pod')
provides=("perl-HTML-Parser=${pkgver}")
conflicts=('perl-HTML-Parser')
replaces=('perl-HTML-Parser')
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_perlname}-${pkgver}.tar.gz)
sha256sums=('fd42ba6abe07241cf0ad57be246c3980065f683e4465e59b46af9efebc8e0c71')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make install DESTDIR="${pkgdir}"
}
