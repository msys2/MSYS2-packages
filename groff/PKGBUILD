# Maintainer: Alexey Pavlov <alexpux@gmail.com>

pkgname=groff
pkgver=1.24.1
pkgrel=1
pkgdesc="GNU troff text-formatting system"
arch=('i686' 'x86_64')
url="https://www.gnu.org/software/groff/groff.html"
msys2_repository_url='https://cgit.git.savannah.gnu.org/cgit/groff.git'
msys2_references=(
  "cpe: cpe:/a:gnu:groff"
)
license=('spdx:GPL-3.0-or-later')
depends=('perl' 'gcc-libs')
makedepends=('autotools' 'gcc')
optdepends=()

_patches=(
  0001-fixes-for-building-with-gcc-15.patch
)

source=(https://ftp.gnu.org/gnu/groff/groff-$pkgver.tar.gz{,.sig}
        site.tmac
        ${_patches[@]})
options=('!docs' '!emptydirs' '!makeflags')
sha256sums=('74e2819795b6aff431aeac983d63a9c8968eeaba2a2eba7df8ba4c7b41e7cfd8'
            'SKIP'
            'af59ecde597ce9f8189368a7739279a5f8a391139fe048ef6b4e493ed46e5f5f'
            '5d27f4c50a2b125e7b0f27bf7ff3efb270e60cf5d46e97ec3cb680cef0815f81')
validpgpkeys=(
  '2D0C08D2B0AD0D3D8626670272D23FBAC99D4E75' # G. Branden Robinson <g.branden.robinson@gmail.com>
  '8773D61D68E30E072B10DC1AD19E9C7D71266DCE' # Bertrand Garrigues <bertrand.garrigues@laposte.net>
)

prepare() {
  cd ${srcdir}/${pkgname}-${pkgver}

  for patch in "${_patches[@]}"; do
    msg2 "Patching with ${patch}"
    patch -Nbp1 -i "${srcdir}/${patch}"
  done

  autoreconf -fvi -I m4
}

build() {
  cd ${srcdir}/${pkgname}-${pkgver}

  ./configure \
    --build=${CHOST} \
    --prefix=/usr
  make
}

check() {
  cd ${srcdir}/${pkgname}-${pkgver}
  make check
}

package() {
  cd ${srcdir}/${pkgname}-${pkgver}
  make DESTDIR=${pkgdir} install

  rm -f ${pkgdir}/usr/lib/charset.alias

  # FS33760 - TERMCAP variables not followed
  # TODO: everyone is doing this - find out why upstream does not...
  cat ${srcdir}/site.tmac >> \
    ${pkgdir}/usr/share/groff/site-tmac/man.local
  cat ${srcdir}/site.tmac >> \
    ${pkgdir}/usr/share/groff/site-tmac/mdoc.local
}
