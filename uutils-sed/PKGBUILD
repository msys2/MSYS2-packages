

_realname=sed
pkgname="uutils-${_realname}"
pkgver=0.3.0
pkgrel=1
pkgdesc="Rust rewrite of sed"
arch=('any')
url='https://github.com/uutils/sed'
msys2_repository_url="${url}"
msys2_references=(
  'archlinux: uutils-sed' # just in case and ignore original sed
  'aur: uutils-sed'
  'gentoo: sys-apps/uutils-sed' # just in case
  'purl: pkg:cargo/sed'
)
license=('spdx:MIT')
depends=("gcc-libs")
makedepends=("rust")
provides=("${_realname}")
conflicts=("${_realname}")
source=("${url}/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('d879d292ff93f4f769f299fb183be69d3ea6bcedeb2a698d944595ebc3a8dd6c')

prepare() {
  cd "${_realname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  cargo build --release --frozen
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 "target/release/${_realname}.exe" -t "${pkgdir}/usr/bin"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
