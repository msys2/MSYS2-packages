# Maintainer: Andrea Dalle Vacche adallevacche@bloomberg.net

_perlname='Carp-Clan'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=6.08
pkgrel=3
pkgdesc="Carp::Clan - Report errors from perspective of caller of a \"clan\" of modules"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Carp-Clan"
msys2_references=(
  'purl: pkg:cpan/ETHER/Carp-Clan'
)
depends=('perl')
groups=('perl-modules')
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/E/ET/ETHER/${_perlname}-${pkgver}.tar.gz)
sha256sums=('c75f92e34422cc5a65ab05d155842b701452434e9aefb649d6e2289c47ef6708')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
