# Maintainer: Peter Budai <peterbudai@hotmail.com>

_perlname='Test-Exit'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.11
pkgrel=3
pkgdesc="Test whether code exits without terminating testing"
arch=('any')
url="https://metacpan.org/release/Test-Exit"
msys2_references=(
  'purl: pkg:cpan/ARODLAND/Test-Exit'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl-Return-MultiLevel')
options=('!emptydirs')
groups=('perl-modules')
source=("https://cpan.metacpan.org/authors/id/A/AR/ARODLAND/${_perlname}-${pkgver}.tar.gz")
sha256sums=('fbda92d37e0481d18eebc81e48d025228b57184c59b2d5a6f6bdf87042e8c7b2')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL installdirs=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
