# Maintainer: J. Peter Mugaas <jpmugaas@suddenlink.net>

_realname=pluggy
pkgbase=python-pluggy
pkgname=("python-${_realname}")
pkgver=1.7.0
pkgrel=1
pkgdesc='Plugin and hook calling mechanisms for python'
arch=('any')
url='https://github.com/pytest-dev/pluggy'
msys2_repository_url='https://github.com/pytest-dev/pluggy'
msys2_documentation_url='https://pluggy.readthedocs.io/'
msys2_changelog_url='https://pluggy.readthedocs.io/en/latest/changelog.html'
msys2_references=(
  'anitya: 7500'
  'archlinux: python-pluggy'
  'gentoo: dev-python/pluggy'
  'purl: pkg:pypi/pluggy'
)
license=('spdx:MIT')
depends=(
  'python'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-setuptools-scm'
)
provides=("python3-${_realname}")
replaces=("python3-${_realname}")
conflicts=("python3-${_realname}")
source=("${pkgbase}-${pkgver}.tar.gz::https://github.com/pytest-dev/pluggy/archive/${pkgver}.tar.gz")
sha512sums=('ff1b820df39bb6fb037f17178663f54d982f7518bff09e073af06229c549cf39d3bda2c2906b2c8c5f75754e2e4b71864d9a5c454ee3eb6d72d6006b79877099')

build() {
  cd "${_realname}-${pkgver}"

  export SETUPTOOLS_SCM_PRETEND_VERSION=${pkgver}
  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "${_realname}-${pkgver}"

  python -m pytest
}

package() {
  cd "${_realname}-${pkgver}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
