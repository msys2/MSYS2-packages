# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='ExtUtils-PkgConfig'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.16
pkgrel=3
pkgdesc="The Perl Pkgconfig module"
arch=(any)
license=('spdx:LGPL-2.1-only')
url="https://gtk2-perl.sourceforge.io/"
msys2_references=(
  'purl: pkg:cpan/XAOC/ExtUtils-PkgConfig'
)
groups=('perl-modules')
depends=('perl>=5.10.0', 'pkgconf')
provides=("perl-ExtUtils-PkgConfig=${pkgver}")
conflicts=('perl-ExtUtils-PkgConfig')
replaces=('perl-ExtUtils-PkgConfig')
source=(https://cpan.metacpan.org/authors/id/X/XA/XAOC/${_perlname}-${pkgver}.tar.gz)
sha256sums=('bbeaced995d7d8d10cfc51a3a5a66da41ceb2bc04fedcab50e10e6300e801c6e')
options=('!emptydirs')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
