# Maintainer: Michael R. Taylor <michael@atomic.city>

pkgname=xorriso
_basever=1.5.8
_patch=02
pkgver=${_basever}.${_patch#0} # generates 1.5.8.2
_tarver=${_basever}.pl${_patch} # generates 1.5.8.pl02
pkgrel=1
pkgdesc="xorriso copies files from POSIX filesystems into Rock Ridge enhanced ISO 9660 filesystems and allows manipulation of such filesystems"
arch=('i686' 'x86_64')
url="https://www.gnu.org/software/xorriso/"
msys2_references=(
  'anitya: 13270'
  'archlinux: libisoburn'
  'aur:' # ignore libisoburn-git
)
license=('spdx:GPL-3.0-or-later')
depends=(
  'libbz2'
  'libiconv'
  'libreadline'
  'zlib'
)
makedepends=(
  'autotools'
  'gcc'
  'libbz2-devel'
  'libiconv-devel'
  'libreadline-devel'
  'texinfo'
  'zlib-devel'
)
source=("https://www.gnu.org/software/${pkgname}/${pkgname}-${_tarver}.tar.gz"{,.sig})
sha256sums=('b1455ecafbf0692ddafe1d71002a96f2ce2d77f4deae602678261ce033f97bc8'
            'SKIP')
validpgpkeys=('44BC9FD0D688EB007C4DD029E9CBDFC0ABC0A854') # Thomas Schmitt <scdbackup@gmx.net>

prepare() {
  cp -r "${pkgname}-${_basever}" "build-${CARCH}" && cd "build-${CARCH}"

  autoreconf -fiv
}

build() {
  cd "build-${CARCH}"

  export MSYSTEM=CYGWIN

  ./configure \
    --host="${CHOST}" \
    --build="${CHOST}" \
    --prefix=/usr \
    --enable-shared \
    --disable-static

  make
}

package() {
  cd "build-${CARCH}"

  make DESTDIR=${pkgdir} install
}
