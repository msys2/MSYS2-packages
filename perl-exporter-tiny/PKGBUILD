# Maintainer: Andrea Dalle Vacche adallevacche@bloomberg.net

_perlname='Exporter-Tiny'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.006003
pkgrel=2
pkgdesc="List::MoreUtils provides some trivial but commonly needed functionality on lists which is not going to go into List::Util"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Exporter-Tiny"
msys2_references=(
  'purl: pkg:cpan/TOBYINK/Exporter-Tiny'
)
depends=('perl')
groups=('perl-modules')
provides=("perl-Exporter-Tiny=${pkgver}")
conflicts=('perl-Exporter-Tiny')
replaces=('perl-Exporter-Tiny')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/T/TO/TOBYINK/${_perlname}-${pkgver}.tar.gz")
sha256sums=('6499f09a6432cf87b133fb9580a8a9a9a6c566821346b1fdee95f7b64c0317b1')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
