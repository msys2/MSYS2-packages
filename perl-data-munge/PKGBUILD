# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Data-Munge'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.111
pkgrel=2
pkgdesc="Various utility functions"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
url="https://metacpan.org/dist/Data-Munge"
msys2_references=(
  'purl: pkg:cpan/MAUKE/Data-Munge'
)
depends=('perl')
checkdepends=('perl-test-warnings')
groups=('perl-modules')
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/M/MA/MAUKE/${_perlname}-${pkgver}.tar.gz)
sha256sums=('086face7ee925d49782a0dc6c699d27e1ac3c5cc6dfc6e99d3e7d892d2038d9b')

build() {
  cd ${_perlname}-${pkgver}
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd ${_perlname}-${pkgver}
  make test
}

package() {
  cd ${_perlname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}
