# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Capture-Tiny'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=0.50
pkgrel=2
pkgdesc="Capture STDOUT and STDERR from Perl, XS or external programs"
arch=('any')
license=('spdx:Apache-2.0')
depends=('perl')
groups=('perl-modules')
url="https://metacpan.org/dist/Capture-Tiny"
msys2_references=(
  'purl: pkg:cpan/DAGOLDEN/Capture-Tiny'
)
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('ca6e8d7ce7471c2be54e1009f64c367d7ee233a2894cacf52ebe6f53b04e81e5')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
