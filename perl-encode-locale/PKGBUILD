# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='Encode-Locale'
_realname="${_perlname,,}"
pkgname=perl-${_realname}
pkgver=1.05
pkgrel=3
pkgdesc="Determine the locale encoding"
arch=('any')
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
options=('!emptydirs')
depends=('perl>=5.008')
makedepends=()
checkdepends=()
groups=('perl-modules')
conflicts=('perl-libwww<6')
url="https://metacpan.org/dist/Encode-Locale"
msys2_references=(
  "purl: pkg:cpan/GAAS/Encode-Locale"
)
source=(https://www.cpan.org/authors/id/G/GA/GAAS/${_perlname}-${pkgver}.tar.gz)
sha256sums=('176fa02771f542a4efb1dbc2a4c928e8f4391bf4078473bd6040d8f11adb0ec1')

build() {
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""                 \
      PERL_AUTOINSTALL=--skipdeps                            \
      PERL_MM_OPT="INSTALLDIRS=vendor"     \
      PERL_MB_OPT="--installdirs vendor" \
      MODULEBUILDRC=/dev/null

    cd "${_perlname}-${pkgver}"
    /usr/bin/perl Makefile.PL
    make
  )
}

check() {
  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""
    cd "${_perlname}-${pkgver}"
    make test
  )
}

package() {
  cd "${_perlname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
