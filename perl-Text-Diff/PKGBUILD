# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=Text-Diff
pkgname=perl-${_realname}
pkgver=1.46
pkgrel=1
pkgdesc="Text::CharWidth - Perform diffs on files and record sets"
arch=('any')
url="https://metacpan.org/dist/Text-Diff/"
msys2_changelog_url='https://metacpan.org/dist/Text-Diff/changes'
msys2_repository_url='https://github.com/neilb/Text-Diff'
msys2_references=(
  'purl: pkg:cpan/NEILB/Text-Diff'
)
groups=("perl-modules")
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("perl" "perl-Algorithm-Diff" "perl-Exporter")
makedepends=("perl-ExtUtils-MakeMaker")
options=('!emptydirs')
source=(https://cpan.metacpan.org/authors/id/N/NE/NEILB/${_realname}-${pkgver}.tar.gz)
sha256sums=('3fc983e3140fa2580250bbcf2b52e2acbdbc5abda4374c3be78235905d8ca8eb')

build() {
  cd "${_realname}-${pkgver}"

  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${_realname}-${pkgver}"
  make test
}

package() {
  cd "${_realname}-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
