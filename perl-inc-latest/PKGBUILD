# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_perlname='inc-latest'
_realname="${_perlname,,}"
pkgname="perl-${_realname}"
pkgver=0.500
pkgrel=3
pkgdesc="Build, test, and install Perl modules"
arch=('any')
license=('spdx:Apache-2.0')
options=('!emptydirs')
depends=('perl>=5.8.8')
url="https://github.com/dagolden/${_perlname}"
msys2_references=(
  'purl: pkg:cpan/DAGOLDEN/inc-latest'
)
groups=('perl-modules')
source=("https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('daa905f363c6a748deb7c408473870563fcac79b9e3e95b26e130a4a8dc3c611')

build() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/${_perlname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
